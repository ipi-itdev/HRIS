<div class="container-fluid">
    <div class="row">
        <div class="col-sm-4">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><b>Special assignment or project</b></h3>
                    <span class="pull-right clickable"><i class="fa fa-chevron-down"></i></span>
                </div>
                <div class="panel-body"><textarea data-autoresize rows="3" id="specialAssignment" class="form-control animated" placeholder="Update your status" style="white-space: pre-line"></textarea></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><b>Objectives or desired impact on growth</b></h3>
                    <span class="pull-right clickable"><i class="fa fa-chevron-up"></i></span>
                </div>
                <div class="panel-body"><textarea data-autoresize rows="3" id="desiredObjectives" class="form-control animated" placeholder="Update your status" style="white-space: pre-line"></textarea></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><b>Action Plan with timeline & desired outcomes</b></h3>
                    <span class="pull-right clickable"><i class="fa fa-chevron-down"></i></span>
                </div>
                <div class="panel-body"><textarea data-autoresize rows="3" id="actionPlanB" class="form-control animated" placeholder="Update your status" style="white-space: pre-line"></textarea></div>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><b>Personnel Action Request</b></h3>
                    <span class="pull-right clickable"><i class="fa fa-chevron-down"></i></span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label for="sel1"><b>Reason For Change</b></label>
                        <select class="form-control" id="reasonforchange">
                        </select>
                    </div>
                </div>

                <div class="panel-body">
                    <div class="form-group">
                        <label for="sel1"><b>PAR Remarks</b></label>
                            <textarea data-autoresize rows="3" id="parRemarks" class="form-control animated" placeholder="Write something here..." style="white-space: pre-line"></textarea>
                    </div>
            </div>

        </div>
