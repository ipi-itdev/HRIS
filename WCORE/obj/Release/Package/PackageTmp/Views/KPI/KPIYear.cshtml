@System.Web.Optimization.Scripts.Render("~/Script/plugins/formslist")
<section class="content-header">
    <h1>KPI Year</h1>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round|Open+Sans">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">

                <div class="col-md-7">
                    <div class="box-body" id="CRONUS">
                        <div id="tblList_CRONUS_wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                            <div class="col-sm-6">
                                <div class="btn-group" id="btnChildList_PerformanceIndicatorMain_ListView_Table">

                                </div>
                            </div>
                            <table id="KPIYear" style="width: 100%; font-size:12px;" class="table table-bordered table-striped table-hover">
                                <thead id="tblHead">
                                    <tr class="notfilter" role="row">
                                        <th style="width: 10%;">ID</th>
                                        <th style="width: 20%;">Description</th>
                                        <th style="width: 70%;">Year</th>
                                    </tr>
                                </thead>
                                <tbody id="tblBody"></tbody>
                                <tfoot></tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div id="myParents_KPIAssignmentList">
                        <section class="content" id="myParents_KPIList">
                            <div class="btn-group-horizontal" id="btnList_Child_KPIList">
                                <button type="button" class="btn btn-primary" id="KPIYearSave"><i class="fa fa-save" title="Save"></i>  Save</button>
                                @*<button type="button" class="btn btn-primary" id="Delete"><i class="fa fa-close" title="Delete"></i>  Delete</button>*@
                            </div>
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="nav-tabs-custom">
                                                    <ul class="nav nav-tabs" id="tab_child_KPIList">
                                                        <li class="active"><a href="#Details_Form_Child_KPIList" data-toggle="tab" aria-expanded="true">Details</a></li>
                                                        @*<li><a href="#Other_Form_Child_KPIAssignmentList" data-toggle="tab">Other</a></li>*@
                                                    </ul>
                                                    <div class="tab-content">
                                                        <div class="tab-pane active" id="Details_Form_Child_KPIList">
                                                            <div class="col-md-12">
                                                                <div class="form-group" id="Details_Form_Child_KPIList_DetailView">
                                                                    <div class="row form-group" id="cntr_ID_PerformanceIndicatorMain">
                                                                        <label class="col-lg-4 control-label style=" text-align:left" ="">
                                                                            <span style="color:red; font-size:20px; ">*  </span>ID
                                                                        </label><div class="col-lg-8 control-container vcenter">
                                                                            <input type="text" class="form-control unique required" id="ID_KPIYear" name="ID_PerformanceIndicatorMain" title="ID" disabled>
                                                                        </div>
                                                                    </div>

                                                                    <div class="row form-group" id="cntr_Description_KPIYear">
                                                                        <label class="col-lg-4 control-label style=" text-align:left" =""><span style="color:red; font-size:20px; ">*  </span>Description</label><div class="col-lg-8 control-container vcenter">
                                                                            <input type="text" class="form-control unique required" id="Description_KPIYear" name="Description_PerformanceIndicatorMain" title="Description KPIYear" disabled>
                                                                        </div>
                                                                    </div>

                                                                    <div class="row form-group" id="cntr_Value_KPIYear">
                                                                        <label class="col-lg-4 control-label style=" text-align:left" =""><span style="color:red; font-size:20px; ">*  </span>Year</label><div class="col-lg-8 control-container vcenter">
                                                                            <input type="text" onkeypress="return isNumberKey(event)" class="form-control unique required" id="Value_KPIYear" name="Description_PerformanceIndicatorMain" title="Value KPIYear">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div style="clear:both;"></div>
                                                        </div><br>

                                                        <div class="tab-pane" id="Other_Form_Child_KPIList">
                                                            <div class="col-md-12">
                                                                <div class="form-group" id="Other_Form_Child_KPIList_DetailView"></div>
                                                            </div>
                                                            <div style="clear:both;"></div>
                                                        </div>
                                                    </div>
                                                    <div style="clear:both;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
	var count = 1;
	var recordID = [];
	var listRec = [];
	var listID = [];
	var kpilistid, ktldg, kpiyear;
	var valid = true;
	var updateType = 0;
	var saveType = 0;
	var table;
	var isForSAVE = true;

	function loadKPIList() {
		var r = $.Deferred();

		table = $("#KPIYear").DataTable({
			ajax: {
				url: '@Url.Action("GetKPIYear", "KPI")',
				type: 'POST',
				datatype: 'application/json; charset=utf-8',
				dataSrc: function (data) {
				    var jsonArray = JSON.parse(data);
				    listRec.length = 0;
				    listID.length = 0;
					if(JSON.parse(data) == ""){
						kpilistid = -1
						updateType = 1;
						$('#ID_KPIYear').val(kpilistid);
						$('#Description_KPIYear').val("N/A");
						$('#Value_KPIYear').val("N/A");
						return JSON.parse(data);
					}else {

						kpilistid = jsonArray[0][0];
						$('#ID_KPIYear').val(kpilistid);
						$('#Description_KPIYear').val(jsonArray[0][1]);
						$('#Value_KPIYear').val(jsonArray[0][2]);
						return JSON.parse(data);
					}
				},

				error: function (e) {}
			}
			, order: [[1, 'asc']], pageResize: true, ordering: true, lengthChange: false,
			initComplete: function () { }
		});
		return r;
	};


	$(document).ready(function () {

	    loadKPIList();

	    var table = $('#KPIYear').DataTable();
	    $('#KPIYear tbody').off().on('click', 'tr', function () {
			var data = table.row(this).data();
			kpilistid = data[0].toString();
			$('#ID_PerformanceIndicatorMain').val(data[0].toString());
			$('#Description_PerformanceIndicatorMain').val(data[1].toString());

			$('#ID_KPIYear').val(data[0].toString());
			$('#Description_KPIYear').val(data[1].toString());
			$('#Value_KPIYear').val(data[2].toString());
			updateType = 0;
		});

	});


	$('#KPIYearSave').on('click', function () {

	    if ($('#Value_KPIYear').val() == "N/A" || (!$('#Value_KPIYear').val().replace(/\s/g, '').length)) {
			swal("Failed!", "Please fill-in all the required fields.", "info");
	    } else {

	            $.ajax({
	                type: "POST",
	                cache: false,
	                url: '../KPIView/UpdatingKPIYear?year=' + $('#Value_KPIYear').val(),
	                success: function (data) {

	                    if (data == 'True') {
	                        $('#KPIYear').DataTable().ajax.reload();
	                        swal("Success!", "KPI Year successfully updated.", "success");
	                        updateType = 0;
	                    }
	                    else { Toast.Show("Something went wrong.") }
	                }
	            })
	        }

	});

	function isNumberKey(evt)
	{
		var charCode = (evt.which) ? evt.which : event.keyCode
		if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)){
			return false;}else{	return true;}
	}
    </script><div>
        <div style="clear:both;"></div>
    </div>
</section>