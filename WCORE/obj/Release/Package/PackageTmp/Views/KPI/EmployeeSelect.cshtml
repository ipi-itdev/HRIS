<section class="content-header">

    <h1>EMPLOYEE LIST</h1>

    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> Registration</a></li>
        <li class="active">Employee List</li>
        <br>
    </ol>
</section>
<section class="content" style="position:relative">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="box-body" id="CRONUS">
                    <div id="tblList_CRONUS_wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                        <table id="tblEmployeeSelect" class="table table-bordered table-striped table-hover tblList" style="font-size:13px;">
                            <thead id="tblHead">
                                <tr class="notfilter" role="row">
                                    <th rowspan="1" colspan="1" style="width:10%">ID</th>
                                    <th rowspan="1" colspan="1" style="width:20%">EMPLOYEE NAME</th>
                                    <th rowspan="1" colspan="1" style="width:30%">DEPARTMENT</th>
                                    <th rowspan="1" colspan="1" style="width:30%">POSITION</th>
                                    <th rowspan="1" colspan="1" style="width:10%">JOB GRADE</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tblBody"></tbody>
                            <tfoot></tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>

	$(document).ready(function () {
		var table;
		table = $("#tblEmployeeSelect").DataTable({
			"columnDefs": [{ "targets": 5, "data": null, "defaultContent": "<button type='button' id='btnAdd' style='width: 100%' class='btn btn-alert'>REGISTER</button>" },
				{
				 //"targets": [0, 1, 2],
				 //"visible": false
			 }],
				ajax: {
				url: '@Url.Action("AddEmployee", "KPI")',
				type: 'POST',
				datatype: 'application/json; charset=utf-8',
				dataSrc: function (data) { return JSON.parse(data); },
				error: function (e) { }
			}
			, order: [[1, 'asc']],  pageResize: true, ordering: false, lengthChange: false,
			initComplete: function () { }
		});

		//--

		$('#tblEmployeeSelect tbody').on('click', '#btnAdd', function () {
			var data = table.row($(this).parents('tr')).data();
			employeeRefNo = data[0];

			swal({
				title: "Confirmation",
				text: "Are you sure you want to apply the selected employee for Performance Evaluation?",
				icon: "info",
				buttons: true,
				dangerMode: true,
			})
			 .then((willDelete) => {
			     if (willDelete) {

							$.ajax({
								type: "POST",
							cache: false,
		                     url: '../KPIView/RegisterEmployee?EmployeeRefNo=' + employeeRefNo,
							success: function (data) {
								if (data == 'True') {
									$('#tblAssignedTo').DataTable().ajax.reload();
									swal("Success!", "The selected employee has been registered.", "success");
								}
								else { status = 0; }
							}
						})

					}});
			});
		});

</script>
<style>
    .tblList {
        width: 100% !important;
    }

        .tblList td,
        .tblList th {
            white-space: normal;
            -ms-text-overflow: ellipsis;
            -o-text-overflow: ellipsis;
            text-overflow: ellipsis;
            overflow: hidden;
        }
</style>
