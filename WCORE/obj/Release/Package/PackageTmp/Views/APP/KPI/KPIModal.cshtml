<script>

    evalRefNo = 0;
    setTargets = [];
    setWeights =  [];
    targetReady = true;

    var count = 1;
    var kpiId, saveType, status = 1, arrayID, kpiformula, kpiweight, kpitarget;
    var table = $("#tableKPI");
    var index = $("tableKPI tbody tr:last-child").index();

    $(document).ready(function () {
        
        loadTable();

        var actions = $("#tableKPI td:last-child").html();
        // Append table with add row form on add new button click
        $(".add-newkpi").click(function () {
            var index2 = $("#tableKPI tbody tr:last-child").index();
            $(this).attr("disabled", "disabled");
            var row = '<tr>' +
                '<td><input type="text" class="form-control" name="kpiid" id="kpiid" value="1" style="font-size: 12px" disabled></td>' +
                '<td> <input type="text" class="form-control" name="kpi" id="kpi" value="Undefined" style="font-size: 12px" rows="5"></td>' +
                //'<td><input type="text" class="form-control" name="formula" id="formula" value="1" style="font-size: 12px"></td>' +
                '<td><select id="formula" style="width: 150px; height: 32px; font-size: 12px"><option value="1">A = P / T x 100</option><option value="2">A = T / P x 100</option></select></td>' +
                '<td><input type="text" class="form-control" name="weight" id="weight" value="0" style="font-size: 12px"></td>' +
                '<td><input type="text" class="form-control" name="target" id="target" value="0" style="font-size: 12px"></td>' +
                '<td>' +
                    '<a class="add" title="Add"><i class="material-icons">&#xE03B;</i></a>' +
                    '<a class="edit" title="Edit"><i class="material-icons">&#xE254;</i></a>' +
                    '<a class="delete" title="Delete"><i class="material-icons">&#xE872;</i></a>' +
                    '</td>' +
            '</tr>;'
            $("#tableKPI").append(row);
            $("#tableKPI tbody tr").eq(index2 + 1).find(".add, .edit").toggle();
            $('[data-toggle="tooltip"]').tooltip();
        });
        // Add row on add button click
        $(document).off("click", ".add").on("click", ".add", function () {
            var empty = false;
            var input = $(this).parents("tr").find('input[type="text"]');

            input.each(function () {
                if (!$(this).val() || parseFloat($(this).val()) <= 0.00) {
                    $(this).addClass("error");
                    empty = true;
                } else {
                    $(this).removeClass("error");
                }
            });

            //---

            $(this).parents("tr").find(".error").first().focus();
            if (!empty) {
                input.each(function () {
                    $(this).parent("td").html($(this).val());
                });
                $(this).parents("tr").find(".add, .edit").toggle();
                $(".add-new").removeAttr("disabled");

                var table = $("#tableKPI");
                var $tds = $(this).parents("tr").find('td'),
                    id = $tds.eq(0).text();
                    kpi = $tds.eq(1).text(),
                    formula = $tds.eq(2).val();
                    weight = $tds.eq(3).text();
                    target = $tds.eq(4).text();

                    kpi = kpi.replace(/ /g, '9azxA'); // SPACE
                    kpi = kpi.replace(/\./g, '9azxB'); // PERIOD
                    kpi = kpi.replace(/\,/g, '9azxC'); // COMMA
                    kpi = kpi.replace(/\;/g, '9azxD'); // SEMICOLON

                    if (id == "1") {
                        saveType = 1;
                        kpiId = 0;
                    } else {
                        saveType = 0;
                        kpiId = id;
                    }

                    $.ajax({                 
                        type: "POST",
                        cache: false,
                        url:'../KPIView/SetTarget?saveType=' + saveType + '&id=' + id + '&kpi=' + kpi + '&formula=' + ($('#formula').val()) + '&target=' + target + '&weight=' + weight + '&PerfEvalID=' + perfIndicatorRefNo + '&empRefno=' + employeeRefNo,
                        success: function (data) {
                            if (data == 'True') {
                                status = 1;
                            }
                            else { status = 0; }
                        }
                    }).done(loadTable());

                if (status == 1) {
                    table.find('tr').each(function (i) {
                    if (!this.rowIndex) return;
                        this.parentNode.removeChild(this);
                    });
                    swal("Success!", "KPI details updated.", "success");	
                }
            }
        });


        // Edit row on edit button click
        $(document).off("click", ".edit").on("click", ".edit", function () {

            $(this).parents("tr").find("td:not(:last-child)").each(function () {
                if (count == 1) {
                    $(this).html('<input onkeypress="return isNumberKey(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" disabled>');
                    count++;
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(".add-new").attr("disabled", "disabled");
                } else if(count == 2){
                    $(this).html('<input onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="5">');
                    count++;
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(".add-new").attr("disabled", "disabled");
                } else if(count == 3){
                    $(this).html('<select id="formula" style="width: 150px; height: 32px; font-size: 12px"><option value="1">A = P / T x 100</option><option value="2">A = T / P x 100</option></select>');
                    count++;
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(".add-new").attr("disabled", "disabled");
                } else if(count >= 4 && count <= 5){
                    $(this).html('<input onkeypress="return isNumberKey(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px">');
                    count++;
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(".add-new").attr("disabled", "disabled");
                } else {
                    count = 1;
                    return false;
                } 
            });	
        });
        // Delete row on delete button click
        $(document).off("click", ".delete").on("click", ".delete", function () {

            swal({
                title: "Are you sure?",
                text: "Once deleted, you will not be able to recover this record!",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })

            .then((willDelete) => {
                if (willDelete) {
                    $(this).parents("tr").remove();
                    $(".add-new").removeAttr("disabled");

                    var table = $("#tableKPI");
                    var $tds = $(this).parents("tr").find('td'),
                        id = $tds.eq(0).text();

                    $.ajax({
                        type: "POST",
                        cache: false,
                        url: '../KPIView/UpdateKPIPerEmployee?id=' + id,
                        success: function (data) {
                            if (data == 'True') {
                                //Toast.Show("Successfully Deleted.")
                            }
                            else { Toast.Show("Unable to delete the record."); }
                        }
                    })
                 }
            });
          
        
    });

    loadPurpose();

    $("select").on("click" , function() {
  
        $(this).parent(".select-box").toggleClass("open");
  
    });

    $(document).mouseup(function (e)
    {
        var container = $(".select-box");

        if (container.has(e.target).length === 0)
        {
            container.removeClass("open");
        }
    });


    $("select").on("change" , function() {
  
            var selection = $(this).find("option:selected").text(),
            evalID = $(this).find("option:selected").val()
            labelFor = $(this).attr("id"),
            label = $("[for='" + labelFor + "']");
            label.find(".label-desc").html(selection);
            evalPurpose = selection;
            evalPurposeID =  evalID;

            $.ajax({    
                type: "POST",
                cache: false,
                url:'../KPIView/SetEvalPurpose?empRefNo=' + employeeRefNo + '&evalID=' + evalPurposeID + '&PerfEvalID=' + perfIndicatorRefNo,
                success: function (data) {
                    if (data == 'True') {
                        $('#tblAssignedTo').DataTable().ajax.reload();
                        swal("Purpose of evaluation has been successfully set.", {
                            icon: "success",
                        });
                    }
                    else { 
                        swal("Something went wrong!", {
                            icon: "warning",
                        });
                                        
                    }  
                }
            })

    }); 

    });

    //--

    function isNumberKey(evt)
    {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)){
            return false;}else{	return true;}
    }

    function loadTable(){
        setTargets.length = 0;
        setWeights.length = 0;

        jQuery.ajax({
            url: '@Url.Action("GetKPIIndicatorDetails", "KPI")?PerfEvalID=' + perfIndicatorRefNo + '&empid=' + employeeRefNo,
            type: 'POST',
            datatype: 'application/json; charset=utf-8',
            success: function (data) {
                var jsonArray = JSON.parse(data);
                for (var i = 0; i < jsonArray.length; i++) {

                    setTargets[i] = jsonArray[i][4];                     
                    setWeights[i] = jsonArray[i][3];
                    var trRow = '';
                    trRow += '<tr><td style="font-size: 12px" disabled>' + jsonArray[i][0] + '</td><td style="font-size: 12px" rows="5">' + jsonArray[i][1] + '</td><td style="font-size: 12px">' + jsonArray[i][2] + '</td><td style="font-size: 12px">' + jsonArray[i][3].toFixed(2) + '</td><td style="font-size: 12px">' + jsonArray[i][4].toFixed(2) + '</td>';
                    trRow += '<td>' +
                             '<a class="add" title="Add"><i class="material-icons">&#xE03B;</i></a>' +
                             '<a class="edit" title="Edit"><i class="material-icons">&#xE254;</i></a>' +
                             '<a class="delete" title="Delete"><i class="material-icons">&#xE872;</i></a>' +
                             '</td></tr>'
                    $("#tableKPI").append(trRow);
                    $("tableKPI tbody tr").eq(index + 1).find(".add, .edit").toggle();
                }			
            },
            error: function (e) {
            }
        });
    }

    function loadPurpose(){

        var  label = $("[for='" + "selectpurpose" + "']");
        label.find(".label-desc").html(evalPurpose);
    
        jQuery.ajax({
            url: '@Url.Action("GetEvalPurpose", "KPI")',
            type: 'POST',
            datatype: 'application/json; charset=utf-8',
            success: function (data) {
                var jsonArray = JSON.parse(data);
                for (var i = 0; i < jsonArray.length; i++) {
                    var str="<option value='" + jsonArray[i][0] + "'>" + jsonArray[i][1] + "</option>";
                    $("#selectpurpose").append(str);
                }         
            },
            error: function (e) {
            }
        });
    }

</script>
