    function PopulateWeightPercentage(isManager, weightID) {

		jQuery.ajax({
            url: '@Url.Action("GetWeightPercentage", "KPI")?isForManager=' + isManager,
			type: 'POST',
			datatype: 'application/json; charset=utf-8',
			success: function (data) {
                var jsonArray = JSON.parse(data);

                $("#PerformancePercentageID_TargetSettingRev").empty();
                $("#PerformancePercentageID_TargetSettingRev").append('<option value=' + 0 + '>' + 'N/A' + '</option>');
                for (var i = 0; i < jsonArray.length; i++) {

                    if (jsonArray[i][0] == weightID) {
                        $("#PerformancePercentageID_TargetSettingRev").append('<option value=' + jsonArray[i][0] + ' selected="selected">' + jsonArray[i][1] + '</option>');
                    } else { $("#PerformancePercentageID_TargetSettingRev").append('<option value=' + jsonArray[i][0] + '>' + jsonArray[i][1] + '</option>'); }

                }

			},
			error: function (e) {
			}

		});
    }

