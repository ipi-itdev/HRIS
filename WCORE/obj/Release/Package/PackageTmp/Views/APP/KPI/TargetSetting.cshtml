            var OkLabel = 'OK';
            var fAction = null;
            switch ( ids.replace('TargetSettingRev-','').toUpperCase() ) {
                case 'NEW_TargetSettingRev'.toUpperCase():
                    Message = 'Are you sure you want to enroll an employee for evaluation?';
                    OkLabel = 'New';
                    fAction = function(result){
                       if (result) {
                           var URLView = '@Url.Action("TargetSetting", "KPI")?mguid=' + '9F101FD2-9616-4652-A4CF-046EC0A12C13' + '&pid=' + '-1';

                           isSubmitted = 0;
                            $('#content_TargetSettingRev').load(URLView, function () {});  }
                    }
                    break;
                case 'SAVE_TargetSettingRev'.toUpperCase():
                    Message = 'Save changes?';
                    OkLabel = 'Save';
                    fAction = function(result) { if (result){  if (PARExternal_Validate() != false) {
                        isSubmitted = 0;
                        oStartDate = new Date($("#StartDate_TargetSettingRev").val());
                        oEndDate = new Date($("#EndDate_TargetSettingRev").val());
                        oDueDate = new Date($("#SubmissionDate_TargetSettingRev").val());

                        if(isDateValid(oStartDate) == false || isDateValid(oEndDate) == false || isDateValid(oDueDate) == false){

                            swal("Failed!", "Invalid entered date/s", "info");
                        } else {

                            if($('#EvalPurposeRefNo_TargetSettingRev').val() == 3){ // FOR REGULARIZATION
                                if($('#EmployeeRefNo_TargetSettingRev').val() == -1){
                                    Toast.Error("Employee name is required.");
                                } else {
                                    $("#Details_Form_TargetSettingRev_DetailView").empty(); rnoyv_ipi_kpiintreq.Save();
                                }

                            } else {
                                if(oDueDate > oEndDate){
                                    if(oStartDate >= oEndDate){
                                        swal("Failed!", "Invalid Start and End Period.", "info");
                                    } else {

                                        if($('#EmployeeRefNo_TargetSettingRev').val() == -1){
                                            Toast.Error("Employee name is required.");
                                        } else {
                                            $("#Details_Form_TargetSettingRev_DetailView").empty(); rnoyv_ipi_kpiintreq.Save();
                                        }

                                    }
                                } else {

                                    Toast.Error("Due date must at least greater than the End of period.");
                                }
                            }
                        }

                    } } else { return false; } }
                    break;
                case 'DELETE_TargetSettingRev'.toUpperCase():
                    Message = 'Are you sure you want to delete?';
                    OkLabel = 'Delete';
                    fAction = function (result) {
                        if (result) {
                            rnoyv_ipi_kpiintreq.Delete();

                            var URLView = '../ListView?mguid=9F101FD2-9616-4652-A4CF-046EC0A12C13'; $('#content_TargetSettingRev').load(URLView, function () { });

                        }
                    }
                    break;
                case 'APPROVE_TargetSettingRev'.toUpperCase():
                        Message = 'Do you want to proceed to evaluation?';
                        OkLabel = 'Submit';
                        fAction = function(result) { if (result){  if (PARExternal_Validate() != false) {

                            if (isSubmitted == 0) {

                                kpiAssignmentID = '@ViewBag.pid';
                                employeeInfo = $("#select2-EmployeeRefNo_TargetSettingRev-container").text().toUpperCase();

                                $.ajax({
                                    type: "POST",
                                    cache: false,
                                    url: '../KPI/CheckTargets?kpiid=' + kpiAssignmentID + '&empRefNo=' + 0,
                                    success: function (data) {

                                        var jsonResult = JSON.parse(data);

                                        if (parseInt(jsonResult[0][3]) == 1) { dialogTitle = "Internal"; } else { dialogTitle = "External"; }

                                        if ((parseInt(jsonResult[0][3]) == 1 || parseInt(jsonResult[0][3]) == 2) && parseInt(jsonResult[0][4]) == 1 && parseInt(jsonResult[0][5]) == 0) {

                                            if (parseInt(jsonResult[0][1]) == 0) {
                                                Toast.Error("There are still KPI's with no target.");

                                            } else {

                                                if (parseInt(jsonResult[0][0]) == 0) {
                                                    var remarks = "";
                                                    $.ajax({
                                                        type: "POST",
                                                        cache: false,
                                                        url: '../KPI/EvaluationDoneTrigger?actionID=' + 1 + '&kpiAssignmentRefNo=' + kpiAssignmentID + '&remarks=' + remarks,
                                                        success: function (data) {
                                                            if (data == 'True') {

                                                                var URLView = '../ListView?mguid=9F101FD2-9616-4652-A4CF-046EC0A12C13'; $('#content_TargetSettingRev').load(URLView, function () { });

                                                                URL = "../KPI/KPIScorePerCategory";
                                                                var detailView = new KPIScoring(URL, employeeInfo, "NEXT");
                                                                detailView.open();

                                                            }
                                                        }
                                                    })

                                                } else {
                                                    var remarks = "";
                                                    $.ajax({
                                                        type: "POST",
                                                        cache: false,
                                                        url: '../KPI/EvaluationDoneTrigger?actionID=' + 1 + '&kpiAssignmentRefNo=' + kpiAssignmentID + '&remarks=' + remarks,
                                                        success: function (data) {
                                                            if (data == 'True') {
                                                                var URLView = '../ListView?mguid=9F101FD2-9616-4652-A4CF-046EC0A12C13'; $('#content_TargetSettingRev').load(URLView, function () { });

                                                                URL = "../KPI/ManagersScore";
                                                                var detailView = new ManagersCore(URL, employeeInfo, 1);
                                                                detailView.open();

                                                            }
                                                        }
                                                    })
                                                }

                                            }
                                        } else if ((parseInt(jsonResult[0][3]) == 1 || parseInt(jsonResult[0][3]) == 2) && parseInt(jsonResult[0][4]) == 0 && parseInt(jsonResult[0][5]) == 0) {
                                            Toast.Error("You need add KPI for the employee.");

                                        } else if ((parseInt(jsonResult[0][3]) == 1 || parseInt(jsonResult[0][3]) == 2) && parseInt(jsonResult[0][4]) == 0 && parseInt(jsonResult[0][5]) == 1) {
                                            var remarks = "";
                                            $.ajax({
                                                type: "POST",
                                                cache: false,
                                                url: '../KPI/EvaluationDoneTrigger?actionID=' + 1 + '&kpiAssignmentRefNo=' + kpiAssignmentID + '&remarks=' + remarks,
                                                success: function (data) {
                                                    if (data == 'True') {
                                                        var URLView = '../ListView?mguid=9F101FD2-9616-4652-A4CF-046EC0A12C13'; $('#content_TargetSettingRev').load(URLView, function () { });

                                                        URL = "../KPI/CoreCompetenciesRev";
                                                        var detailView = new KPICoreCompetencies(URL, employeeInfo);
                                                        detailView.open();

                                                    }
                                                }
                                            })
                                        }

                                    }
                                })

                                isSubmitted = 1;
                            }

                        } } else { return false; } }
                    break;
                case 'DISAPPROVE_TargetSettingRev'.toUpperCase():
                    if (jQuery.trim($("#Remarks_TargetSettingRev").val()).length == 0) {Toast.Error("Please enter remarks."); return false; }
                    else {
                        Message = 'Disapprove this request?';
                        OkLabel = 'Disapprove';
                        fAction = function (result_kpiintreq) { if (result_kpiintreq) { rnoyv_ipi_kpiintreq.Disapprove($("#Remarks_TargetSettingRev").val()); isSubmitted = 0;} }}
                    break;
                case 'BACK_TargetSettingRev'.toUpperCase():
                    Message = 'Are you sure you want to go back to the list?';
                    OkLabel = 'Back to List';
                    console.log(fAction);
                    console.log(result);
                    fAction = function (result) {

                           if (result) { var URLView = '../ListView?mguid=9F101FD2-9616-4652-A4CF-046EC0A12C13'; $('#content_TargetSettingRev').load(URLView, function () { }); }

                    }
                    break;
            }


            BootstrapDialog.confirm({

                title:'Target Setting(' + dialogTitle + ')',
                icon:'fa-circle-o',
                message: Message,
                closable: true,
                draggable: true,
                btnCancelLabel: 'Cancel',
                btnOKLabel: OkLabel,
                callback: fAction


            });
        });
    });

    function PARExternal_Validate() {
        var valid_PAREXT = true;
        $("#TargetSettingRev .required").each(function() {
            var fname_parextreq = $(this).attr('name').split("_");
            var objVal = JSON.parse(JSON.stringify( rnoyv_ipi_kpiintreq ));
            if(objVal[fname_parextreq[0]] == null || objVal[fname_parextreq[0]] == 0)
            { Toast.Error( $(this).attr('title') + " is required." ); valid_PAREXT = false; return false; }
        });
        return valid_PAREXT;
    }

