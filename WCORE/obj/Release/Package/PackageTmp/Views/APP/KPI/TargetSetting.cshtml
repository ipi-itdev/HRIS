        function TargetSettingRev_DetailView() {
            var self = $(this);
            this.IsEditOnly = false;
            var ObjectID = '@ViewBag.pid';
            console.log('ito yung object id sa target setting: ' + ObjectID);

            var dvFormat = [{ Name: 'Details', Controls:
                   [
                    { Name: 'ID', Type: 'Int', IsEnabled: false, ColumnNo: 0, TbName: 'Details', ControlID: 'ID' },
                    { Name: 'EvalPurposeRefNo', IsEnabled: '@ViewBag.pid' > 0 ? false:true, Caption: 'Purpose', Type: 'Int', ControlType: 'combobox', RefColumn: 'ep', ControlModel: 'EvaluationPurpose', ColumnValue: 'ID', DisplayColumnValue: 'Description', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'EvalPurposeRefNo' },
                    { Name: 'EmployeeRefNo', IsEnabled: '@ViewBag.pid' > 0 ? false : true, Caption: 'Employee Name', Type: 'Int', ControlType: 'combobox', RefColumn: 'en', ControlModel: 'KPIActiveEmployee', ColumnValue: 'EmployeeRefNo', DisplayColumnValue: 'Description', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'EmployeeRefNo' },
                    { Name: 'PerformancePercentageID', IsEnabled: true, Caption: '% Weight', Type: 'Int', ControlType: 'combobox', RefColumn: 'es', ControlModel: 'PerformancePercentage', ColumnValue: 'ID', DisplayColumnValue: 'Description', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'PerformancePercentageID' },
                    { Name: 'StartDate', Caption: 'Start of Period', Type: 'String', strFormat: 'mm/dd/yyyy', ControlType: 'datepicker', ControlModel: 'TargetSettingRev', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'StartDate' },
                    { Name: 'EndDate', Caption: 'End of Period', Type: 'String', strFormat: 'mm/dd/yyyy', ControlType: 'datepicker', ControlModel: 'TargetSettingRev', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'EndDate' },
                    { Name: 'SubmissionDate', Caption: 'Due Date', Type: 'String', strFormat: 'mm/dd/yyyy', ControlType: 'datepicker', ControlModel: 'TargetSettingRev', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'SubmissionDate' },
                    { Name: 'Remarks', Type: 'String', ControlType: 'textarea', ControlModel: 'TargetSettingRev', ColumnNo: 0, TbName: 'Details', ControlID: 'Remarks' }] },
                    { Name: 'Other', Controls:
                    [{ Name: 'CreatedBy', Caption: 'Created By', Type: 'Int', ControlType: 'combobox', IsEnabled: false, RefColumn: '[Created By]', ControlModel: 'User', ColumnValue: 'ID', DisplayColumnValue: 'Description', ColumnNo: 0, TbName: 'Other', ControlID: 'CreatedBy' },
                    { Name: 'CreatedDate', Caption: 'Date', Type: 'String', IsEnabled: false, ControlModel: 'TargetSettingRev', ColumnNo: 0, TbName: 'Other', ControlID: 'CreatedDate' },
                    { Name: 'ModifiedBy', Caption: 'Modified By', Type: 'Int', ControlType: 'combobox', IsEnabled: false, RefColumn: '[Modified By]', ControlModel: 'User', ColumnValue: 'ID', DisplayColumnValue: 'Description', ColumnNo: 2, TbName: 'Other', ControlID: 'ModifiedBy' },
                    { Name: 'ModifiedDate', Caption: 'Modified Date', Type: 'String', IsEnabled: false, ControlModel: 'TargetSettingRev', ColumnNo: 2, TbName: 'Other', ControlID: 'ModifiedDate' },
                        { Name: 'IsActive', Type: 'Boolean', ControlType: 'checkbox', IsEnabled: false, ControlModel: 'TargetSettingRev', ColumnNo: 0, TbName: 'Other', ControlID: 'IsActive' }
                    ]
                }];
            function GetControl(Selector, CtrlFormat ) {
                var control = new JIBControl(Selector, { PropertyName: CtrlFormat.Name , Caption: (CtrlFormat.Caption == undefined ? CtrlFormat.Name : CtrlFormat.Caption ), type : CtrlFormat.ControlType, Model : CtrlFormat.ControlModel, ControlID : CtrlFormat.ControlID , ControlFormat: CtrlFormat.strFormat },CtrlFormat,'TargetSettingRev');
                control.IsRequired = CtrlFormat.IsRequired != undefined ? CtrlFormat.IsRequired : false;
                control.IsUnique = CtrlFormat.IsUnique != undefined ? CtrlFormat.IsUnique : false;
                control.ParentDiv = Selector
                control.Init();
                if ( CtrlFormat.IsEnabled != undefined ) control.SetEnabled( CtrlFormat.IsEnabled );
                control.CurrentObject = rnoyv_ipi_kpiintreq;
                console.log('current object value: ' + control.CurrentObject);
                return control;
            };
            function InitNewObject(newObject) {
                $.each(newObject, function(key, value) {
                    if ( key != "IsEditOnly" ) {
                        rnoyv_ipi_kpiintreq[key] = value;
                    }
                });
                $.each(dvFormat, function(i,tabs) {
                    if ( tabs.IsListView != undefined ) {
                        Selector = $('#' + tabs.Name + '_List_TargetSettingRev');
                        LoadListViewTab(Selector,tabs);
                    }
                    else {
                        $.each(tabs.Controls, function(x,val ) {
                            if (tabs.Name == 'JobDescription') {
                                Selector = $('#JobDescription_Form_TargetSettingRev_DetailView');
                            } else {if(val.ColumnNo == 2) {Selector = $('#' + tabs.Name + '_Form_TargetSettingRev_DetailView_2');
                                } else{ Selector = $('#' + tabs.Name + '_Form_TargetSettingRev_DetailView');}}
                            var control = GetControl(Selector,val);
                            control.SetValue(rnoyv_ipi_kpiintreq[val.Name]);
                        });
                    }
                });
            }
            this.OpenObject = function(CurrentObject) {
                InitNewObject(CurrentObject)
            }
            this.InitDetailView = function(CurrentObject) {
                $.ajax({
                    url: '../DetailView/GetBaseObject',
                    data: { model:'TargetSettingRev', pKey:ObjectID },
                    type: 'POST',
                    datatype: 'application/json; charset=utf-8',
                    beforeSend: function () { },
                    success: function (data) {
                        if ( ObjectID <= 0 ) {
                            var newObject = eval("(function(){return " + data + ";})()");
                            InitNewObject( newObject );
                        } else {
                            console.log('ito yung data: ' + data);
                            var jsonArray = JSON.parse(data);
                            if (jsonArray.length == 0) return;
                            var Columns = jsonArray[0];
                            var Values = jsonArray[1];
                            console.log('value of columns: ' + Columns);
                            console.log('value of valuesL ' + Values);
                            $.each(Columns,function(i,o){
                                CurrentObject[o] = Values[i];
                            });
                            $.each(dvFormat, function(x,tabs) {

                                if ( tabs.IsListView != undefined ) {
                                    Selector = $('#' + tabs.Name + '_List_TargetSettingRev');
                                    LoadListViewTab(Selector,tabs);
                                } else {
                                    $.each( tabs.Controls, function( i, val ) {

                                        if (tabs.Name == 'JobDescription') {
                                            Selector = $('#JobDescription_Form_TargetSettingRev_DetailView');
                                        } else {
                                            if (val.ColumnNo == 2) {
                                                Selector = $('#' + tabs.Name + '_Form_TargetSettingRev_DetailView_2');
                                            } else {
                                                Selector = $('#' + tabs.Name + '_Form_TargetSettingRev_DetailView');
                                            }
                                        }
                                        console.log('value of columns: ' + Columns);
                                        console.log('ito yung val name: ' + val.Name);
                                        var control = GetControl(Selector,val);
                                        var ColumnIndex = Columns.indexOf( val.Name );
                                        var Value = Values[ColumnIndex];
                                        control.SetValue(Value);
                                    });
                                }

                            });
                        }
                    }, error: function ( e ) { alert(e.responseText); }
                });
            };

            //--
        }
        function LoadListViewTab(Selector, tabs){
            var URLView = '../ListView/ChildListIndex?ModelNo=MODEL_NAME&Description=MODEL_DESC&ColumnsWidth=0.7&IsAppendMode=True&ForeignKeyName=FKeyName&ForeignKey=FKey&ParentModel=PMod&AllowAddOth=ModAllowUpdate';
            URLView = URLView.replace("MODEL_NAME", tabs.Type);
            URLView = URLView.replace("MODEL_DESC", tabs.Name);
            URLView = URLView.replace("FKeyName", tabs.FKey);
            URLView = URLView.replace("FKey", tabs.FKeyValue);
            URLView = URLView.replace("PMod", "TargetSettingRev");
            URLView = URLView.replace("ModAllowUpdate", '@ViewBag.AllowUpdate');
            Selector.load(URLView);
            Selector.on('OnGridCreated', function (e, o) {
                var ctr = 0;
                var h = Selector.parent().height();
                var grid = o.Grid;
                grid.ParentObject = rnoyv_ipi_kpiintreq;
                grid.ParentObjectProperty = tabs.PropertyName;

                grid.rowHeight = 30;
                grid.ID_ParentKey = rnoyv_ipi_kpiintreq[tabs.FKeyValue];
                grid.ForeignFieldKey = tabs.FKey != undefined ? tabs.FKey : null;
                grid.IsPartialRefresh = false;
                grid.Refresh();
                grid.getContainer().css('height', h - 10 );
                grid.getTable().css('height', h - 70);
            });
        }
        var $itm = new TargetSettingRev_DetailView();
        $itm.InitDetailView(rnoyv_ipi_kpiintreq);
        return r;
    }

