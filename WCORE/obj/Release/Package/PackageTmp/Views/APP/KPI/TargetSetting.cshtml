                    if(purposeID == 3){
                        var today = new Date();
                        var dd = today.getDate();
                        var mm = today.getMonth()+1; //January is 0!
                        var yyyy = today.getFullYear();

                        if(dd<10) {
                            dd = '0'+dd
                        }

                        if(mm<10) {
                            mm = '0'+mm
                        }
                        today = mm + '/' + dd + '/' + yyyy;
                        $("#SubmissionDate_TargetSettingRev").val(today).trigger("change");

                        if(("#StartDate_TargetSettingRev").value == undefined || ("#StartDate_TargetSettingRev").value == "" || ("#EndDate_TargetSettingRev").value == undefined || ("#EndDate_TargetSettingRev").value == ""){
