                var GR = client;
                var DC = parseFloat(parseFloat(jsonArray[0][35])) + parseFloat(basic);
                var GM = parseFloat(GR) - parseFloat(DC);

                $('#TotalGRPIS').html(accounting.formatMoney(GR, ''));
                $('#TotalDCPIS').html(accounting.formatMoney(parseFloat(jsonArray[0][47]).toFixed(2), ''));
