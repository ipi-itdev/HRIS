            type: "POST",
            cache: false,
            url: '@Url.Action("ComputePARDetails","PAR")?pkey=@ViewBag.PARID',
            success: function (data) {
                var jsonArray = JSON.parse(data);
                var basic = 0;
                basic = parseFloat(jsonArray[0][0]).toFixed(2)
                var client = 0;
                client = parseFloat(jsonArray[0][28]).toFixed(2)
                $('#mBasicSalaryPIS').val(accounting.formatMoney(basic, ''));
                $('#dBasicSalaryPIS').val(accounting.formatMoney(parseFloat(jsonArray[0][1]).toFixed(2), ''));
                $('#hBasicSalaryPIS').val(accounting.formatMoney(parseFloat(jsonArray[0][2]).toFixed(2), ''));

                $('#mSSSPIS').val(accounting.formatMoney(parseFloat(jsonArray[0][3]).toFixed(2), ''));
