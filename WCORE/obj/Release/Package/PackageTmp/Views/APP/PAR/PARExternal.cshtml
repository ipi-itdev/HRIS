    function PARExternal_Validate() {
        var valid_PAREXT = true;
        var objVal = JSON.parse(JSON.stringify( rnoyv@{@ViewBag.mCode} ));
        $("#@ViewBag.mCode .required").each(function() {
            var fname_parextreq = $(this).attr('name').split("_");
            if(objVal[fname_parextreq[0]] == null || objVal[fname_parextreq[0]] == 0)
            { Toast.Error( $(this).attr('title') + " is required." ); valid_PAREXT = false; return false; }
        });
        
        if(objVal["ReasonForChangeRefNo"] == 0 && (objVal["OtherReason"] == '' || objVal["OtherReason"] == null )) { Toast.Error("Reason is required."); valid_PAREXT = false; return false; }

		if(($('#HMODC_@ViewBag.mCode').val() > 0 && $('#HMOAmount_@ViewBag.mCode').val() == 0) || ($('#HMODC_@ViewBag.mCode').val() == 0 && $('#HMOAmount_@ViewBag.mCode').val() > 0))
		{Toast.Error("HMO DC and HMO Coverage should both populated."); valid_PAREXT = false; return false;}

        return valid_PAREXT;
    }
    
