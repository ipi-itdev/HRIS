<script>
    var uri@{@ViewBag.mCode} = '../api/PAREmpInfo';
    var rnoyv@{@ViewBag.mCode};
    var new@{@ViewBag.mCode} = @ViewBag.PKey > 0  ? false : true;
    var tmr@{@ViewBag.mCode};
    var res@{@ViewBag.mCode} = null;
	var tblmovement@{@ViewBag.mCode};
	var emprefno@{@ViewBag.mCode} = 0;
	 
    function showfn@{@ViewBag.mCode}(input) {
        var file = $("#file_JD_EmploymentInfo_@ViewBag.mCode").val();
        document.getElementById("JobDescriptionPath_@ViewBag.mCode").value = file;
    }

    $(document).ready(function () {
        fOne@{@ViewBag.mCode}().done(lstmovement@{@ViewBag.mCode}($('#EmployeeRefNo_@ViewBag.mCode').val()));
        $('#tab_@ViewBag.mCode>li>a').first().click();
        $(function() {           
            $('#btnList_@ViewBag.mCode').find('button').off('click').on('click', function() {
                var ids = $(this).attr('id');
                var Message = '';
                var OkLabel = 'OK';
                var fAction = null;
                switch ( ids.replace('@ViewBag.mCode-','').toUpperCase() ) {
                    case 'NEW_@ViewBag.mCode'.toUpperCase():
                        Message = 'Create new Personnel Action Request?';
                        OkLabel = 'New';
                        fAction = function(result){
                                var URLView = '@Url.Action("@ViewBag.mCode", "PAR")?mName=@ViewBag.mCode&pKey=-1&Icon=fa-users';
                                $('#content_@ViewBag.mCode').load(URLView, function () { });}
                        break;
                    case 'SAVE_@ViewBag.mCode'.toUpperCase():
                        if($('#ReasonForChangeRefNo_@ViewBag.mCode').val() == 3){  $('#DateRegularized_@ViewBag.mCode').val($('#EffectivityDate_@ViewBag.mCode').val()).trigger("change");
                            $('#EmploymentStatusRefNo_@ViewBag.mCode').val(3).trigger("select2:select");  }
                        Message = 'Save changes?';
                        OkLabel = 'Save';
                        fAction = function(result) { if (PARExternal_Validate() != false) { rnoyv@{@ViewBag.mCode}.Save(); }  else { return false; } }
                        break;
                    case 'DELETE_@ViewBag.mCode'.toUpperCase():
                        Message = 'Are you sure you want to delete?';
                        OkLabel = 'Delete';
                        fAction = function(result) { rnoyv@{@ViewBag.mCode}.Delete();}
                        break;
                    case 'APPROVE_@ViewBag.mCode'.toUpperCase():
                        Message = 'Approve this request?';
                        OkLabel = 'Approve';
                        fAction = function(result) {  rnoyv@{@ViewBag.mCode}.Approve();} 
                        break;
                    case 'DISAPPROVE_@ViewBag.mCode'.toUpperCase():
                        if (jQuery.trim($("#Remarks_@ViewBag.mCode").val()).length == 0) {Toast.Error("Please enter remarks."); return false; }
                        else {
                            Message = 'Disapprove this request?';
                            OkLabel = 'Disapprove';
                            fAction = function(res@{@ViewBag.mCode}) {  rnoyv@{@ViewBag.mCode}.Disapprove();} 
                        }
                        break;
                    case 'BACK_@ViewBag.mCode'.toUpperCase():
                        Message = 'Are you sure you want to go back to the list?';
                        OkLabel = 'Back to List';
                        fAction = function (result) { var URLView = '../ListView?ModelNo=53'; $('#content_@ViewBag.mCode').load(URLView, function () { });}
                        break;
                }
                
                BootstrapDialog.show({
                    title: 'External Personnel Action Request',
                    icon: 'fa-circle-o',
                    message: Message,
                    closable: true,
                    draggable: true,
                    buttons: [{ id: 'btn-1', label: 'Cancel', cssClass: 'btn-warning', action: function (dialog) { dialog.close(); } },
                              { id: 'btn-2', label: 'Ok', cssClass: 'btn-primary', action: function (dialog) { var $button = this; $button.disable(); $button.spin(); fAction(); dialog.close(); } }]
                });
            });
        });

        $('#Compute_@ViewBag.mCode').on('click', function () {
            InitializeValue();
        })

        $("#Upload_@ViewBag.mCode").off("click").on("click",function() { $("#file_JD_EmploymentInfo_@ViewBag.mCode").trigger('click'); })

        $("#Download_@ViewBag.mCode").off("click").on("click",function() {
            if($("#JobDescriptionPath_@ViewBag.mCode").val()) { window.open('@Url.Action("Download","ReportView")?fname=' + $("#JobDescriptionPath_@ViewBag.mCode").val()) }
        })

        $("#@ViewBag.mCode").off("select2:select","#EmployeeRefNo_@ViewBag.mCode").on("select2:select","#EmployeeRefNo_@ViewBag.mCode",function(){
            emprefno@{@ViewBag.mCode} = $('#EmployeeRefNo_@ViewBag.mCode').val();
            $.ajax({
