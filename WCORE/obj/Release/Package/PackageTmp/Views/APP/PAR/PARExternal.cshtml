	function CmbReason(empno){
		$.ajax({
			url: '../PAR/GetEmployeeReasonForChage?pkey=' + empno,
			type: 'POST',
			datatype: 'application/json; charset=utf-8',
			success: function (data) {
				$('#ReasonForChangeRefNo_@ViewBag.mCode').html('');
				var jsonArray = JSON.parse(data);
				if (jsonArray.length == 0) return;
				$('#ReasonForChangeRefNo_@ViewBag.mCode').append('<option id="0" value="0">N/A</option>');
				for (var i = 0; i < jsonArray.length; i++) {
					Columns = jsonArray[i];
					$('#ReasonForChangeRefNo_@ViewBag.mCode').append('<option id=' + Columns[0] + ' value=' + Columns[0] + '>' + Columns[1] + '</option>');
