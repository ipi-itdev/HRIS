<div id="content_@ViewBag.mCode" class="module-wrapper ng-scope">
    <section class="content-header">
        <h1>Employee Accountability History <i style="font-size:13px">  (@ViewBag.Description)</i></h1>
        <ol class="breadcrumb">
            <li><a href="javascript:void(0);" onclick="displayAttachment('../Uploads/UserManual/@{@ViewBag.mCode}.pdf');"><i class="fa fa-question-circle" title="Help?"></i>Help</a></li>
        </ol>
    </section>
    <section class="content" id="@ViewBag.FormID">
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header" id="btnList_@{@ViewBag.FormID}">
                        <div class="btn-group">
                            @if (@ViewBag.AllowInsert == true)
                            {<button type="button" class="btn btn-primary" id="New_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-file" title="New"></i>  New</button>}
                            @if ((@ViewBag.AllowInsert == true && @ViewBag.pid <= 0) || (@ViewBag.AllowUpdate == true && @ViewBag.pid > 0 && @ViewBag.IStatus != 35))
                            {<button type="button" class="btn btn-primary" id="Save_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-save" title="Save"></i>  Save</button>}
                            <button type="button" class="btn btn-primary" id="Back_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Open"></i>  Back to List</button>
                        </div>
                        <div style="float:right;">
                            <div class="btn-group">
                                @if (@ViewBag.AllowPrint == true && @ViewBag.pid > 0)
                                {<button type="button" class="btn btn-primary" id="Form_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-file-text" title="Accountability Form"></i> Form</button>}
                                @if (@ViewBag.AllowApprove == true && @ViewBag.pid > 0 && @ViewBag.IStatus == 1)
                                {<button type="button" class="btn btn-primary" id="Deploy_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-paper-plane" title="Deploy"></i>  Deploy</button>}
                                @if (@ViewBag.AllowApprove == true && @ViewBag.pid > 0 && @ViewBag.IStatus == 7)
                                {<button type="button" class="btn btn-primary" id="Cleared_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-up" title="Cleared"></i>  Cleared</button>}
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-4">
  
                                <div class="tab-pane active" id="Details_Form_@ViewBag.mCode">

                                    <div class="col-md-12">
                                        <table width="100%">
                                            <tr>
                                                <td width="40%"><strong>ID:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["ID"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>EmployeeName:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["EmployeeName"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>Deployed Date:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["DeployedDate"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>Deployed By:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["DeployedBy"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>Cleared Date:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["ClearDate"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>Cleared By:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["ClearBy"];}</td>
                                            </tr>
                                            <tr>
                                                <td width="40%"><strong>Remarks:</strong></td>
                                                <td width="60%" align="left">@{@ViewBag.dtitemy.Rows[0]["Remarks"];}</td>
                                            </tr>


                                        </table>
                                            <!--<div class="form-group" id="Details_@{@ViewBag.FormID}_dtlv"></div>-->
                                    </div>
                                    <div style="clear:both;"></div>
                                    
                                </div>
                            </div>
                            <div class="col-md-8">
                                <h5>Items</h5>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th scope="col">ID</th>
                                            <th scope="col">Item</th>
                                            <th scope="col">Specification</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @for (int i = 0; i < @ViewBag.RowsCount; i++)
                                        {
                                            <tr>
                                                <td>@ViewBag.dtitemx.Rows[i]["ID"]</td>
                                                <td>@Html.Raw(ViewBag.dtitemx.Rows[i]["ItemType"])</td>
                                                <td>@Html.Raw(ViewBag.dtitemx.Rows[i]["Description"])</td>

                                            </tr>
                                        }

                                    </tbody>
                                </table>

                                <!--
                                    <div class="nav-tabs-custom">
                                        <ul class="nav nav-tabs" id="tab_@ViewBag.mCode" role="tablist">
                                            <li class="nav-item active"><a href="#INVEmpAccountabilityDetailsHist_List_@ViewBag.mCode" class="nav-link active" data-toggle="tab" role="tab">Items</a></li>
                                            @*<li class="nav-item"><a href="#INVEmpAccountabilityClientDetails_List_@ViewBag.mCode" class="nav-link" data-toggle="tab" role="tab">Other Items</a></li>*@
                                            <li class="nav-item"><a href="#Other_Form_@ViewBag.mCode" class="nav-link" data-toggle="tab" role="tab">Other</a></li>
                                        </ul>
                                        <div class="tab-content">
                                            <div class="tab-pane active" id="INVEmpAccountabilityDetailsHist_List_@ViewBag.mCode" role="tabpanel">
                                                <div id="INVEmpAccountabilityDetailsHist_List_@ViewBag.FormID"></div>
                                            </div>
                                            <div class="tab-pane" id="INVEmpAccountabilityClientDetailsHist_List_@ViewBag.mCode" role="tabpanel">
                                                <div id="INVEmpAccountabilityClientDetails_List_@ViewBag.FormID"></div>
                                            </div>
                                            <div class="tab-pane" id="Other_Form_@ViewBag.mCode" role="tabpanel">
                                                <div class="col-md-6">
                                                    <div class="form-group" id="Other_@{@ViewBag.FormID}_dtlv"></div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group" id="Other_@{@ViewBag.FormID}_dtlv2"></div>
                                                </div>
                                                <div style="clear:both;"></div>
                                            </div>
                                        </div>
                                    </div>
                               -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
@System.Web.Optimization.Scripts.Render("~/Script/INVEmpAccountabilityDetailsHist")
<script>
$(document).ready(function () {
	let $mFrm = new INVEmpAccountabilityDetailsHist('@{@ViewBag.pid}'); $mFrm.mguid = '@{@ViewBag.mguid}'; $mFrm.mNm = '@{@ViewBag.mName}'; $mFrm.mNo = '@{@ViewBag.mNo}'; $mFrm.mDesc = '@{@ViewBag.Description}'; $mFrm.FKN =  '@{@ViewBag.FKeyName}'; $mFrm.FK =  '@{@ViewBag.pid}'; $mFrm.fid =  '@{@ViewBag.FormID}';
	$('.content-wrapper').waitMe('hide');
})
</script>