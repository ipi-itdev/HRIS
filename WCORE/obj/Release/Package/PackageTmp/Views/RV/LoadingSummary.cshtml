<script>
    var IsPageLoad = false;
    var tablemlist;
    var dateTime

    $(document).ready(function () {
        $('.content-wrapper').waitMe('hide');
        var today = new Date();
        var date = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
        var time = today.getHours() + "-" + today.getMinutes() + "-" + today.getSeconds();
        dateTime = date + ' ' + time;

        populateTable();
        $('#Filter').off('click').on('click', function () {
            populateTable();
        })

        function populateTable() {
            if (IsPageLoad == true) { tablemlist.destroy(); IsPageLoad = false; populateTable() } else {
                IsPageLoad = true;
                $('#lstLoadingSummarylist thead .filters th.wfilter').each(function () { $(this).html('<input type="text"/>'); });
                tablemlist = $("#lstLoadingSummarylist").DataTable({
                    dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-2'B><'col-sm-4'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
                    "autoWidth": false,
                    ajax: {
                        url: '../PIS/GetLoadingSummary',
                        type: 'POST',
                        datatype: 'application/json; charset=utf-8',
                        dataSrc: function (data) { return JSON.parse(data); },
                    },
                    pageResize: true, bSortCellsTop: true, buttons: [{
                        extend: 'excel', title: 'Masterlist' + ' ' + dateTime
                    }],
                    "deferRender": true, "bLengthChange": false
                });

                tablemlist.columns('.wfilter').eq(0).each(function (colIdx) {
                    $('input', $('#lstLoadingSummarylist thead .filters th')[colIdx]).on('keyup change', function () {
                        tablemlist
                    .column(colIdx)
                    .search(this.value)
                    .draw();
                    });
                });
            }
        }
    })

</script>
