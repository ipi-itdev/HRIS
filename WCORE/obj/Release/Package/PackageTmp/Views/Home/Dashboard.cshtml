<section class="content-header">
    <h1>Dashboard</h1>
    <ol class="breadcrumb">
        <li><a href="javascript:void(0);" onclick="displayAttachment('../Uploads/UserManual/@{@ViewBag.mCode}.pdf');"><i class="fa fa-question-circle" title="Help?"></i>Help</a></li>
    </ol>
</section>
<section class="content">
    <div class="row">
        <div class="col-md-2">
            <div class="info-box no-padding">
                <span class="info-box-icon bg-blue"><i class="fa fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Project-Based</span>
                    <span class="info-box-number" id="ext_pb"></span>
                    <span class="info-box-number" id="int_pb"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="info-box">
                <span class="info-box-icon bg-red"><i class="fa fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Probationary</span>
                    <span class="info-box-number" id="ext_p"></span>
                    <span class="info-box-number" id="int_p"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="info-box">
                <span class="info-box-icon bg-green"><i class="fa fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">REGULAR</span>
                    <span class="info-box-number" id="ext_reg"></span>
                    <span class="info-box-number" id="int_reg"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="info-box">
                <span class="info-box-icon bg-purple"><i class="fa fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Fixed-Term</span>
                    <span class="info-box-number" id="ext_ft"></span>
                    <span class="info-box-number" id="int_ft"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="info-box">
                <span class="info-box-icon bg-olive-active"><i class="fa fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Trainee</span>
                    <span class="info-box-number" id="ext_st"></span>
                    <span class="info-box-number" id="int_st"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="info-box">
                <span class="info-box-icon bg-yellow"><i class="fa fa-users "></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">TOTAL</span>
                    <span class="info-box-number" id="ext_te"></span>
                    <span class="info-box-number" id="int_te"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="box box-primary direct-chat direct-chat-danger">
                <div class="box-header with-border">
                    <h1 class="box-title">Expiring Contracts</h1>
                    <div class="box-tools pull-right">
                        <select class="select2 form-control" id="days" name="days" title="Expiring Contract Days" style="width:100px;">
                            <option value="15">15 days</option>
                            <option value="30">30 days</option>
                            <option value="45">45 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="0">Expired</option>
                        </select>
                    </div>
                </div>
                <div class="box-body no-padding" style="height:200px; overflow-y:auto; overflow-x:hidden;">
                    <table class="table table-striped table-responsive-md" id="EOC" style="font-size:12px;" height="150">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Client</th>
                                <th>Employment Status</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="box box-primary direct-chat direct-chat-warning">
                <div class="box-header with-border">
                    <h1 class="box-title">Due for KPI</h1>
                    <div class="box-tools pull-right">
                        <select class="select2 form-control" id="month" name="month" title="Due for KPI" style="width:100px;">
                            <option value="3">3rd Month</option>
                            <option value="5">5th Month</option>
                            <option value="12">Annual</option>
                        </select>
                    </div>
                </div>
                <div class="box-body" style="height:200px; overflow-y:auto; overflow-x:hidden;">
                    <table class="table table-striped table-responsive-md" id="DueForKPI" style="font-size:12px;">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Client</th>
                                <th>Employment Status</th>
                                <th>Date Hired</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="box box-primary direct-chat direct-chat-warning">
                <div class="box-header with-border">
                    <h1 class="box-title">Expiring Floating Status</h1>
                    <div class="box-tools pull-right">
                        <select class="select2 form-control" id="fsdays" name="fsdays" title="Expiring Contract Days" style="width:100px;">
                            <option value="5">5 days</option>
                            <option value="15">15 days</option>
                            <option value="30">30 days</option>
                            <option value="35">35 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="0">Expired</option>
                        </select>
                    </div>
                </div>
                <div class="box-body" style="height:200px; overflow-y:auto; overflow-x:hidden;">
                    <table class="table table-striped table-responsive-md" id="EF" style="font-size:12px;">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Client</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <!-- Line chart -->
            <div class="box box-primary">
                <div class="box-header with-border">
                    <i class="fa fa-bar-chart-o"></i>
                    <h3 class="box-title">Loading and Attrition</h3>
                </div>
                <div class="box-body chart-responsive">
                    <div class="chart" id="line-chart" style="height: 250px;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <i class="fa fa-bar-chart-o"></i>
                    <h3 class="box-title">Gender</h3>
                </div>
                <div class="box-body">
                    <div id="donut-chart" style="height: 250px;"></div>
                </div>
            </div>
        </div>
    </div>
 

</section>
@System.Web.Optimization.Scripts.Render("~/Script/dashboard")
<script>
    var table, tableEOC, tableDueForKPI, tableFEOC;
    $(document).ready(function () {
        //$(document.body).on("change", "#days", function () { tableEOC.destroy(); getEOC(); });
        //$(document.body).on("change", "#month", function () { tableDueForKPI.destroy(); getDueForKPI(); });
        //$(document.body).on("change", "#fsdays", function () { tableFEOC.destroy(); getFEOC(); });


        $(document.body).on("change", "#days", function () {

            if ($.fn.DataTable.isDataTable('#tableEOC')) {
                $('#tableEOC').DataTable().destroy();
            }

            getEOC();

        });

        $(document.body).on("change", "#month", function () {

            if ($.fn.DataTable.isDataTable('#tableDueForKPI')) {
                $('#tableDueForKPI').DataTable().destroy();
            }

            getDueForKPI();

        });

        $(document.body).on("change", "#fsdays", function () {

            if (typeof tableFEOC !== 'undefined' && tableFEOC !== null) {

                tableFEOC.destroy();

            }

            getFEOC();

        });

        getEOC(); getDueForKPI(); getFEOC();

		config = {
            resize: true,
            data: @{@Html.Raw(ViewBag.LineChartData)},
            xkey: 'm',
            ykeys: ['Loading', 'Attrition','Active'],
            labels: ['Loading', 'Attrition','Active'],
            lineColors: ['#3c8dbc', '#FF0000','#00a65a'],
            hideHover: 'auto',
            parseTime: false,
            stacked: true
        };

		config.element = 'line-chart';
		Morris.Line(config);

		var arres = @{@Html.Raw(ViewBag.ChartData)};
        $('#ext_pb').html(retes(arres,1,2) + ' (External)');
        $('#int_pb').html(retes(arres,1,1) + ' (Internal)');
        $('#ext_p').html(retes(arres,2,2)+ ' (External)');
        $('#int_p').html(retes(arres,2,1) + ' (Internal)');
        $('#ext_reg').html(retes(arres,3,2) + ' (External)');
        $('#int_reg').html(retes(arres,3,1) + ' (Internal)');
        $('#ext_ft').html(retes(arres,4,2) + ' (External)');
        $('#int_ft').html(retes(arres,4,1) + ' (Internal)');
        $('#ext_st').html(retes(arres,5,2) + ' (External)');
        $('#int_st').html(retes(arres,5,1) + ' (Internal)');
        $('#ext_te').html(retes(arres,0,2) + ' (External)');
        $('#int_te').html(retes(arres,0,1) + ' (Internal)');

		var arrsex = @{@Html.Raw(ViewBag.PieData)};
        var donutData = [
            { label: 'MI', data: retsex(arrsex,1,1), color: '#3c8dbc' },
            { label: 'ME', data: retsex(arrsex,1,2), color: '#0073b7' },
            { label: 'FE', data: retsex(arrsex,2,1), color: '#FF1493' },
            { label: 'FI', data: retsex(arrsex,2,2), color: '#FF69B4' }
        ]
        $.plot('#donut-chart', donutData, {
            series: {
                pie: {
                    show: true,
                    innerRadius: 0.3,
                    radius: 1,
                    label: {
                        show: true,
                        radius: 3 / 4,
                        formatter: labelFormatter,
                        background: {
                            opacity: 0.5
                        }
                    }
                }
            },
            legend: {
                show: false
            }
        })

		$('.content-wrapper').waitMe('hide');
    })

    function getDueForKPI() {

        // Check if DataTable is already initialized
        if ($.fn.DataTable.isDataTable('#DueForKPI')) {
            // If yes, destroy it before reinitializing
            $('#DueForKPI').DataTable().destroy();
        }

        tableEOC = $("#DueForKPI").DataTable({
            dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-6'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            ajax: {
                url: '@Url.Action("getDueForKPI", "Home")?month=' + $('#month').val(),
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) {
                    return JSON.parse(data);
                },
                error: function (e) { }
            },
            order: [[1, 'asc']], "bLengthChange": false, "bPaginate": false,
            "columns": [{ "width": "30%" }, { "width": "30%" }, { "width": "20%" }, { "width": "20%" }, ],
            fixedHeader: { header: true, footer: true }
        });
        }

    function getEOC() {

        // Check if DataTable is already initialized
        if ($.fn.DataTable.isDataTable('#EOC')) {
            // If yes, destroy it before reinitializing
            $('#EOC').DataTable().destroy();
        }

        tableEOC = $("#EOC").DataTable({
            dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-6'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            ajax: {
                url: '@Url.Action("getListEOC", "Home")?days=' + $('#days').val(),
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) {
                    return JSON.parse(data);
                },
                error: function (e) { }
            },
            order: [[1, 'asc']], "bLengthChange": false, "bPaginate": false,
            "columns": [{ "width": "30%" }, { "width": "30%" }, { "width": "20%" }, { "width": "20%" }, ],
            fixedHeader: { header: true, footer: true }
        });
        }


    function getFEOC() {
        tableFEOC = $("#EF").DataTable({
            dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-6'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            ajax: {
                url: '@Url.Action("getListFEOC", "Home")?days=' + $('#fsdays').val(),
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) {
                    return JSON.parse(data);
                },
                error: function (e) { }
            },
            order: [[1, 'asc']], "bLengthChange": false, "bPaginate": false,
            "columns": [{ "width": "30%" }, { "width": "30%" }, { "width": "20%" }, { "width": "20%" }, ],
            fixedHeader: { header: true, footer: true }
        });
    }

    function retes(arres, esr, egr) { return arres != '' ? arres.filter(a => a.es == esr && a.eg == egr) == '' ? 0 : arres.filter(a => a.es == esr && a.eg == egr)[0].cnt : '0'; }
	function retsex(arrsex, sexr, egr) { return arrsex != '' ? arrsex.filter(a => a.sex == sexr && a.eg == egr) == '' ? 0 : arrsex.filter(a => a.sex == sexr && a.eg == egr)[0].cnt : '0'; }

    function labelFormatter(label, series) {
        return '<div style="font-size:12px; text-align:center; padding:2px; color: #fff; font-weight: 600;">'
            + label
            + '<br>'
            + Math.round(series.data[0][1]) + '</div>'
    }

</script>
