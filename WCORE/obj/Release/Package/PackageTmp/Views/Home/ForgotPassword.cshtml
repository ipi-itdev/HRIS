@{
    ViewBag.Title = "Index";
    Layout = "~/Views/_Layout.cshtml";
}
<script src='https://www.google.com/recaptcha/api.js' async defer></script>
<div class="bg"></div>
<div class="bg bg2"></div>
<div class="bg bg3"></div>
<div class="login" ng-controller="FPasswordController">
    <div class="login-box">
        <div class="login-box-body">
            <div class="login-logo"></div>
            <br />
            <div class="form-group has-icon">
                <label class="control-label" for="inputError">
                    Please enter your email address to reset/change your password.
                </label>
            </div>
			<h2>{{ RCode }}</h2>
            <div class="form-group has-icon">
                <input type="text" class="form-control" placeholder="Email" ng-model="User.Email" required>
                <span class="fa fa-envelope form-icon-feedback"></span>
            </div>
			<div class="text-center">
				<div style="display: inline-block;">
					<div class="g-recaptcha" data-sitekey="6Lf1r6UZAAAAAH2MV58lJAswvRYo0fDiMeVIdjaj"></div>
					<br />
				</div>
			</div>
			<div class="box-header">
				<div class="box-title">
					<a href="#" ng-click="flogin()">Back to Login.</a>
				</div>
				<div class="box-tools pull-right">
					<button type="submit" class="btn btn-primary" ng-click="rpassword()" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;">Submit</button>
				</div>
			</div> 
        </div>
    </div>
</div>


