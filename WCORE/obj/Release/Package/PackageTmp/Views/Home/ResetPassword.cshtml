@{
    Layout = "~/Views/_Layout.cshtml";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.2.0/zxcvbn.js"></script>
<div class="bg"></div>
<div class="bg bg2"></div>
<div class="bg bg3"></div>
<div class="login" ng-controller="RPasswordController">
    <div class="login-box">
        <div class="login-box-body">
            <div class="login-logo"></div>
            <br />
			Please do not share your password with anyone.
			<br /><br />
			<p>This link will expire in <label id="ctrdown"></label></p> 
            <div class="form-group has-icon">
                <input class="form-control" id="new-password" type="password" placeholder="New Password" ng-model="User.Password" ng-change="pchange()" required>    
				<span class="fa fa-lock form-icon-feedback"></span>
                <meter max="4" id="password-strength" ng-model="meter"></meter>
                <p id="password-strength-text">{{ rate }}</p>
            </div>
            <div class="form-group has-icon">
                <input class="form-control" id="confirm-password" ng-model="User.CPassword" placeholder="Re-type New Password" type="password" required>    
				<span class="fa fa-lock form-icon-feedback"></span>
            </div>                                    
            <div class="row">
				<div class="col-md-8">
				</div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary btn-block btn-flat" ng-click="cpassword()">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>


