    $(document).ready(function () {
    // Initial call to loadKPIListDetails
    console.log('Document Ready');
    loadKPIListDetails();
    });

     //Add row on add button click

    $(document).off("click", ".addkpi").on("click", ".addkpi", function () {

        var empty = false;
        var input = $(this).parents("tr").find('input[type="text"]');

        input.each(function () {
            if (!$(this).val() || $(this).val() == 0.00 || $(this).val() == 0) {
                $(this).addClass("error");
                empty = true;

            } else {
                $(this).removeClass("error");
            }
        });

        //---

        $(this).parents("tr").find(".error").first().focus();

        if (!empty) {
            input.each(function () {
                $(this).parent("td").html($(this).val());
            });

            //--
            var $tds = $(this).parents("tr").find('td'),
                id = $tds.eq(0).text(),
                permanentregion = $tds.eq(1).text(),
                permanentprovince = $tds.eq(2).text();
            permanentmunicipality = $tds.eq(3).text();
            permanentbarangay = $tds.eq(4).text();
            var permanentregion_final = permanentregion.replace(" ", "");
            var permanentprovince_final = permanentprovince.replace(" ", "");
            var permanentmunicipality_final = permanentmunicipality.replace(" ", "");
            var permanentbarangay_final = permanentbarangay.replace(" ", "");
            //kpi = kpi.replace(/'/g, "`");,
            if (id == "-1") {
                saveType = 1;
            } else {
                saveType = 0;
            }

            /* if (year != null && ) {*/

            $.ajax({
                type: "POST",
                url: "../KPIView/UpdatingPermanentAddress",
                contentType: "application/json; charset=utf-8",
                cache: false,
                data: JSON.stringify({ saveType: saveType, employeerefno: @ViewBag.pid, permanentregion: permanentregion_final, permanentprovince: permanentprovince_final, permanentmunicipality: permanentmunicipality_final, permanentbarangay: permanentbarangay_final }),
                success: function (data) {
                    if (data == 'True') {
                        // status = 1;
                        loadKPIListDetails(perfindicatorid);
                        $(this).parents("tr").find(".add, .edit").toggle();
                        $(".add-newkpi").removeAttr("disabled");
                        $('#CategoryDetails').DataTable().ajax.reload();
                        $('#KPIAssignmentList_ListView_Table').DataTable().ajax.reload();
                        $('#KPIAssignmentDetails').DataTable().ajax.reload();
                        $('#KPIListInfo').DataTable().ajax.reload();
                        Toast.Show("Employee's Contacts Details Added/Updated");
                    }
                    else { }
                }
            })


            //} else {
            //    swal("Failed!", "Invalid Weight format.", "info");
            //    loadKPIListDetails(perfindicatorid);
            //    $(".add-newkpi").removeAttr("disabled");
            //}
        }
        else {
            Toast.Error("Please Complete All Required Fields");
            //var URLView = '../ListView/ListIndex?mguid=' + self.mguid;
            //$('#content_mFrm' + self.mNo).load(URLView, function () { });
            //document.getElementById('btn-Close').click();
            //var URLView = '../ListView/Index?mguid=' + ec_mguid + '&pid=' + perfindicatorid;
            //console.log('URL View: ' + URLView);
            //console.log('#content_mFrm' + ec_mno);
            //$('.content').load(URLView, function (response, status, xhr) {
            //    // Callback function after the load completes
            //    if (status === "error") {
            //        console.log("An error occurred: " + xhr.status + " " + xhr.statusText);
            //    } else {
            //        console.log("Content loaded successfully.");
            //    }
            //});
            //window.location.reload();
        }
    });

