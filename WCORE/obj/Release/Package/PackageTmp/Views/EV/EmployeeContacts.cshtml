    function addrow_kpi() {
        var index2 = $("#tableKPIList tbody tr:last-child").index();
        var row = '<tr>' +
            '<td><input type="text" class="form-control" name="id" id="id" value="-1" style="font-size: 12px" disabled></td>' +
            '<td><input type="text" class="form-control" name="year" id="year" placeholder="Year Graduated" style="font-size: 12px" rows="5"></td>' +
            '<td><input type="text" class="form-control" name="school" id="school" placeholder="School" style="font-size: 12px" rows="5"></td></td>' +
            '<td><input type="text" class="form-control" name="course" id="course" placeholder="Course" style="font-size: 12px" rows="5"></td></td>' +
            '<td>' +
            '<a class="addkpi" title=""><i class="material-icons">&#xE03B;</i></a>' +
            '<a class="editkpi" title=""><i class="material-icons">&#xE254;</i></a>' +
            '<a class="deletekpi" title=""><i class="material-icons">&#xE872;</i></a>' +
            '</td>' +
            '</tr>';
        $("#tableKPIList").append(row);
        $("#tableKPIList tbody tr").eq(index2 + 1).find(".addkpi, .editkpi").toggle();
        $('[data-toggle="tooltip"]').tooltip();
        $(".add-newkpi").attr("disabled", "disabled");
    }

    function loadKPIListDetails() {
        var tableKPListDetails = $("#tableKPIList tbody");
        var tableKPListDetails2 = $("#tableKPIList2 tbody");
        // Clear table including dynamically added rows
        tableKPListDetails.empty();
        tableKPListDetails2.empty();

        jQuery.ajax({
            url: '@Url.Action("GetEmployeeContacts", "KPI")',
            type: 'POST',
            dataType: 'json',
            data: {
                PerfIndicatorID: perfindicatorid
            },
            success: function (data) {
                var jsonArray_contacts = JSON.parse(data);
                for (var i = 0; i < jsonArray_contacts.length; i++) {
                    var trRow_contacts = '<tr><td style="font-size: 12px" disabled>' + jsonArray_contacts[i][0] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][1] + ' - ' + jsonArray_contacts[i][2] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][5] + ' - ' + jsonArray_contacts[i][6] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][9] + ' - ' + jsonArray_contacts[i][10] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][13] + ' - ' + jsonArray_contacts[i][14] + '</td>';
                    trRow_contacts += '<td>' +
                        '<a class="addkpi" title="Add"><i class="material-icons">&#xE03B;</i></a>' +
                        '<a class="editkpi" title="Edit"><i class="material-icons">&#xE254;</i></a>' +
                        '</td></tr>';
                    $("#tableKPIList").append(trRow_contacts);
                    $("#tableKPIList tbody tr").eq(i + 1).find(".addkpi, .editkpi").toggle(); // Use 'i' instead of 'index'

                    var trRow2_contacts = '<tr><td style="font-size: 12px" disabled>' + jsonArray_contacts[i][0] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][3] + ' - ' + jsonArray_contacts[i][4] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][7] + ' - ' + jsonArray_contacts[i][8] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][11] + ' - ' + jsonArray_contacts[i][12] + '</td><td style="font-size: 12px">' + jsonArray_contacts[i][15] + ' - ' + jsonArray_contacts[i][16] + '</td>';
                    trRow2_contacts += '<td>' +
                        '<a class="addkpi2" title=""><i class="material-icons">&#xE03B;</i></a>' +
                        '<a class="editkpi2" title=""><i class="material-icons">&#xE254;</i></a>' +
                        '</td></tr>';
                    $("#tableKPIList2").append(trRow2_contacts);
                    $("#tableKPIList2 tbody tr").eq(i + 1).find(".addkpi2, .editkpi2").toggle(); // Use 'i' instead of 'index'


                }

                 var userroles = @Html.Raw(ViewBag.userrolesrefno);
                   console.log('value ng userrroles: ' + userroles);
                   if (userroles == 53) {
                       $('.addkpi').hide();
                       $('.editkpi').hide();
                       $('.addkpi2').hide();
                       $('.editkpi2').hide();
                }

                if (userroles == 55) {
                    $('.addkpi').hide();
                    $('.editkpi').hide();
                    $('.addkpi2').hide();
                    $('.editkpi2').hide();
                }

                if (userroles == 54) {
                    $('.addkpi').hide();
                    $('.editkpi').hide();
                    $('.addkpi2').hide();
                    $('.editkpi2').hide();
                }
            },
            error: function (e) {
                console.error(e);
            }
        });
    }

    function transferValue() {
        var regionvalue = document.getElementById('PermanentRegion').value
        document.getElementById('PermanentRegion2').value = regionvalue;

        var permanentprovince = $('#PermanentProvince');
        var permanentmunicipality = $('#PermanentMunicipality');
        var permanentbarangay = $('#PermanentBarangay');
        permanentprovince.empty();
        permanentmunicipality.empty();
        permanentbarangay.empty();

        document.getElementById('PermanentProvince2').value = '';
        document.getElementById('PermanentMunicipality2').value = '';
        document.getElementById('PermanentBarangay2').value = '';

        $.ajax({
            type: 'GET',
            url: '../KPI/GetProvinceList?PerfIndicatorID=' + regionvalue,
            dataType: 'json',
        }).then(function (data) {
            var jsonArray = JSON.parse(data);
            permanentprovince.append('<option id="0" value="0">N/A</option>');

            for (var i = 0; i < jsonArray.length; i++) {
                // create the option and append to 1lect2
                var option = new Option(jsonArray[i][1], jsonArray[i][2], false, false);

                permanentprovince.append(option);
            }



        });
    }

