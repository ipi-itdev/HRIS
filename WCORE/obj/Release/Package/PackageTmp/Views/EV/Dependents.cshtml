                 //$(".add-newkpi").attr("disabled", "disabled");

             } else if (count == 4) {

                 $(this).html('<input type="date" class="form-control" name="dependentsbirthdate2" id="dependentsbirthdate2" onchange="getDate()" style="font-size: 12px" rows="5" value="' + $(this).text() + '"><input id="dependentsbirthdate" name="dependentsbirthdate" onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" hidden>');
                 count++;
                 //console.log('dadaan dito sa count 4 tapos ito na yung count number niya: ' + count);
                 //$(this).parents("tr").find(".addkpi, .editkpi").toggle();
                 //$(".add-newkpi").attr("disabled", "disabled");

             }
             else if (count == 5) {
                 $(this).html('<select class="form-control" name="pwd2" id="pwd2" onchange="changevaluepwd()"><option selected disabled>N/A</option><option value="Yes">Yes</option><option value="No">No</option></select><input id="pwd" name="pwd" onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" hidden>');
                 count++;
                 console.log('dadaan dito sa count 5 tapos ito na yung count number niya: ' + count);
                 console.log('pero di nag aactivate ung edit button!!!!');
                 $(this).parents("tr").find(".addkpi_dependents, .editkpi_dependents").toggle();
                 $(".add-newkpi_dependents").attr("disabled", "disabled");

             }

             else {
                 count = 1;
                 return false;
             }
         });
     });

      // Delete row on delete button click
