             text: "Once deleted, you will not be able to recover this record.",
             icon: "warning",
             buttons: true,
             dangerMode: true,
         })

             .then((willDelete) => {
                 if (willDelete) {

                     if ((id == undefined || id == "")) {
                         id = recID;
                         console.log('ito yung id nang idedelete: ' + id);
                         if (id != undefined) {
                             $.ajax({
                                 type: "POST",
                                 cache: false,
