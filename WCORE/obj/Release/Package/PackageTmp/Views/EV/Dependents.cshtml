                                 success: function (data) {
                                     if (data == 'True') {
                                         //status = 1;
                                         //loadKPIListDetails(kpilistid);
                                     }
                                     else { }
                                 }
                             })
                         }
                     } else {

                         console.log('ito yung id nang idedelete: ' + id);
                         $.ajax({
                             type: "POST",
                             cache: false,
                             url: '../KPIView/UpdatingDependents?saveType=' + 2 + '&employeerefno=' + @ViewBag.pid + '&id=' + id + '&dependentsname=' + 'NULL' + '&relationship=' + 'NULL' + '&dependentsbirthdate=' + 'NULL' + '&ispwd=' + '0',
                             success: function (data) {
                                 if (data == 'True') {
                                     //status = 1;
                                     //loadKPIListDetails(kpilistid);
                                 }
                                 else { status = 0; }
                             }
                         })
                     }

                     $(this).parents("tr").find(".add_dependents, .edit_dependents").toggle();
                     $(".add-newkpi_dependents").removeAttr("disabled");
                     $(this).parents("tr").remove();
                     Toast.Show("Employee's Dependents Details Deleted");
                 }
             });


     });

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
            return false;
        } else { return true; }
    }


    function isNumeric(num) {
        return !isNaN(num)
    }

