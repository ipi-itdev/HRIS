<script>
	var recID;
	var count = 1;
	var saveType;
    var perfindicatorid = @ViewBag.pid;
    console.log("Viewbag ito" + @ViewBag.pid);
    var userrefno = @Session["UserRefNo"];

    $(document).ready(function () {
        // Initial call to loadKPIListDetails
        console.log('Document Ready');
        loadKPIListDetails_dependents();

        if (userrefno == 5) {
            document.getElementById('add-newkpi_dependents').style.display = "none";
        }
    });

    function filterInput(event) {
        // List of special characters to block
        const specialChars = /[!#$%^&*(),.?":{}|<>]/;

        // Get the character code of the pressed key
        const charCode = event.which || event.keyCode;
        const charStr = String.fromCharCode(charCode);

        // Check if the character is a special character
        if (specialChars.test(charStr)) {
            // If it is a special character, prevent it from being entered

            Toast.Error("Doesn't Allow Special Characters");
            event.preventDefault();
            return false;
        }

        // Allow the character if it's not a special character
        return true;
    }


    function loadKPIListDetails_dependents() {
        var tableKPListDetails = $("#tableKPIList_dependents tbody");
         // Clear table including dynamically added rows
         tableKPListDetails.empty();

         jQuery.ajax({
             url: '@Url.Action("GetEmployeeDependentsDetails", "KPI")',
             type: 'POST',
             dataType: 'json',
             data: {
                 PerfIndicatorID: perfindicatorid
             },
             success: function (data) {
                 var jsonArray_dependents = JSON.parse(data);
                 for (var i = 0; i < jsonArray_dependents.length; i++) {
                     var trRow_dependents = '<tr><td style="font-size: 12px" disabled>' + jsonArray_dependents[i][0] + '</td><td style="font-size: 12px">' + jsonArray_dependents[i][1] + '</td><td style="font-size: 12px">' + jsonArray_dependents[i][2] + '</td><td style="font-size: 12px">' + jsonArray_dependents[i][3] + '</td>' + '</td><td style="font-size: 12px">' + jsonArray_dependents[i][4] + '</td>';
                     trRow_dependents += '<td>' +
                         '<a class="addkpi_dependents" title=""><i class="material-icons">&#xE03B;</i></a>' +
                         '<a class="editkpi_dependents" title=""><i class="material-icons">&#xE254;</i></a>' +
                         '<a class="deletekpi_dependents" title=""><i class="material-icons">&#xE872;</i></a>' +
                         '</td></tr>';
                     $("#tableKPIList_dependents").append(trRow_dependents);
                     $("#tableKPIList_dependents tbody tr").eq(i + 1).find(".addkpi_dependents, .editkpi_dependents").toggle(); // Use 'i' instead of 'index'
                 }

                 var userroles = @Html.Raw(ViewBag.userrolesrefno);
                console.log('value ng userrroles: ' + userroles);
                if (userroles == 53) {
                    $('.addkpi_dependents').hide();
                    $('.editkpi_dependents').hide();
                    $('.deletekpi_dependents').hide();
                    $('.add-newkpi_dependents').hide();
                 }

                 if (userroles == 55) {
                     $('.addkpi_dependents').hide();
                     $('.editkpi_dependents').hide();
                     $('.deletekpi_dependents').hide();
                     $('.add-newkpi_dependents').hide();
                 }

                 if (userroles == 54) {
                     $('.addkpi_dependents').hide();
                     $('.editkpi_dependents').hide();
                     $('.deletekpi_dependents').hide();
                     $('.add-newkpi_dependents').hide();
                 }
             },
             error: function (e) {
                 console.error(e);
             }
         });
     }


    function addrow_kpi_dependents() {
        var index2 = $("#tableKPIList_dependents tbody tr:last-child").index();
        var row = '<tr>' +
     '<td><input type="text" class="form-control" name="id" id="id" value="-1" style="font-size: 12px" disabled></td>' +
     '<td><input type="text" class="form-control" name="dependentsname" id="dependentsname" placeholder="Dependents Name" style="font-size: 12px" rows="5" onkeypress="return filterInput(event)"></td>' +
     '<td><input type="text" class="form-control" name="relationship" id="relationship" placeholder="Relationship" style="font-size: 12px" rows="5" onkeypress="return filterInput(event)"></td></td>' +
     '<td><input type="date" class="form-control" name="dependentsbirthdate2" id="dependentsbirthdate2" onchange="getDate()" style="font-size: 12px" rows="5"><input type="text" class="form-control" name="dependentsbirthdate" id="dependentsbirthdate" placeholder="Birth Date" style="font-size: 12px" rows="5" hidden></td>' +
     '<td><select class="form-control" name="pwd2" id="pwd2" onchange="changevaluepwd()"><option selected disabled>N/A</option><option value="Yes">Yes</option><option value="No">No</option></select><input type="text" class="form-control" name="pwd" id="pwd" placeholder="Is PWD?" style="font-size: 12px" rows="5" hidden></td>' +
            '<td>' +
            '<a class="addkpi_dependents" title=""><i class="material-icons">&#xE03B;</i></a>' +
            '<a class="editkpi_dependents" title=""><i class="material-icons">&#xE254;</i></a>' +
            '<a class="deletekpi_dependents" title=""><i class="material-icons">&#xE872;</i></a>' +
            '</td>' +
            '</tr>';
        $("#tableKPIList_dependents").append(row);
        $("#tableKPIList_dependents tbody tr").eq(index2 + 1).find(".addkpi_dependents, .editkpi_dependents").toggle();
        $('[data-toggle="tooltip"]').tooltip();
        $(".add-newkpi_dependents").attr("disabled", "disabled");
    }

    function getDate() {

        var offense_value = document.getElementById('dependentsbirthdate2').value
        document.getElementById('dependentsbirthdate').value = offense_value;

    }

    function changevaluepwd() {
        var pwd_value = document.getElementById('pwd2').value
        document.getElementById('pwd').value = pwd_value;
    }
     //Add row on add button click

    $(document).off("click", ".addkpi_dependents").on("click", ".addkpi_dependents", function () {

        var empty = false;
        var input = $(this).parents("tr").find('input[type="text"]');

        input.each(function () {
            if (!$(this).val() || $(this).val() == 0.00 || $(this).val() == 0) {
                $(this).addClass("error");
                empty = true;
            } else {
                $(this).removeClass("error");
            }
        });

        //---

        $(this).parents("tr").find(".error").first().focus();

        if (!empty) {
            input.each(function () {
                $(this).parent("td").html($(this).val());
            });

            //--
            var $tds = $(this).parents("tr").find('td'),
                id = $tds.eq(0).text(),
                dependentsname = "'" + $tds.eq(1).text() + "'",
                relationship = "'" + $tds.eq(2).text() + "'";
            dependentsbirthdate = $tds.eq(3).text();
            var date = new Date(dependentsbirthdate);
            var day = date.getDate();
            var month = date.getMonth() + 1;
            var year = date.getFullYear();
            var birthdate = "'" + [year, month, day].join('-') + "'";


            console.log('ito yung dependents birth date: ' + birthdate);

            ispwd = $tds.eq(4).text();


            if (ispwd == "No") {
                ispwd = 0;
            } else {
                ispwd = 1;
            }

            //condition of save type
            if (id == "-1") {
                saveType = 1;
            } else {
                saveType = 0;
            }

            /* if (year != null && ) {*/

            $.ajax({
                type: "POST",
                url: "../KPIView/UpdatingDependents",
                contentType: "application/json; charset=utf-8",
                cache: false,
                data: JSON.stringify({ saveType: saveType, employeerefno: @ViewBag.pid, id: id, dependentsname: dependentsname, relationship: relationship, dependentsbirthdate: birthdate, ispwd: ispwd }),
                success: function (data) {
                    if (data == 'True') {
                        // status = 1;
                        loadKPIListDetails_dependents(perfindicatorid);
                        $(this).parents("tr").find(".add_dependents, .edit_dependents").toggle();
                        $(".add-newkpi_dependents").removeAttr("disabled");
                        $('#CategoryDetails').DataTable().ajax.reload();
                        $('#KPIAssignmentList_ListView_Table').DataTable().ajax.reload();
                        $('#KPIAssignmentDetails').DataTable().ajax.reload();
                        $('#KPIListInfo').DataTable().ajax.reload();
                        Toast.Show("Employee's Dependents Details Added/Updated");
                    }
                    else { }
                }
            })


            //} else {
            //    swal("Failed!", "Invalid Weight format.", "info");
            //    loadKPIListDetails(perfindicatorid);
            //    $(".add-newkpi").removeAttr("disabled");
            //}
        } else {
            Toast.Error("Please Complete All Required Fields");
        }
    });


