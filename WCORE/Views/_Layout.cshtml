@{ ViewBag.Title = "_Layout"; }
<!DOCTYPE html>
<html ng-app="PISApp" lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta Http-Equiv="Cache-Control" Content="no-cache"/>
    <meta Http-Equiv="Pragma" Content="no-cache" />
    <meta Http-Equiv="Expires" Content="0" />
    <title>IPI-HRIS</title>
    @*<link rel="shortcut icon" href="#">*@
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    @*<link rel="stylesheet" href="~/Contents/plugins/font-awesome/css/fontawesome.css">*@
    @System.Web.Optimization.Styles.Render("~/Styles/css")
    @System.Web.Optimization.Scripts.Render("~/Script/js")
</head>
<body class="skin-ipi sidebar-mini sidebar-collapse">
@RenderBody()
</body>
</html>
<script type="text/javascript">
function preventBack() { window.history.forward(); }
setTimeout("preventBack()", 0);
window.onunload = function() { null };
</script>

