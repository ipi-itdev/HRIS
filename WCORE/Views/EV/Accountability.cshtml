        loadKPIListDetails();
    });


     function loadKPIListDetails() {
         var tableKPListDetails = $("#tableKPIList tbody");
         // Clear table including dynamically added rows
         tableKPListDetails.empty();

         jQuery.ajax({
             url: '@Url.Action("GetEmployeeAccountabilityDetails", "KPI")',
             type: 'POST',
             dataType: 'json',
             data: {
                 PerfIndicatorID: perfindicatorid
             },
             success: function (data) {
                 var jsonArray = JSON.parse(data);
                 for (var i = 0; i < jsonArray.length; i++) {
                     var trRow = '<tr><td style="font-size: 12px" disabled>' + jsonArray[i][0] + '</td><td style="font-size: 12px">' + jsonArray[i][1] + '</td><td style="font-size: 12px">' + jsonArray[i][2] + '</td><td style="font-size: 12px">' + jsonArray[i][3] + '</td>' + '</td><td style="font-size: 12px">' + jsonArray[i][4] + '</td>';
                     trRow += '<td>' +
                         '<a class="addkpi" title=""><i class="material-icons">&#xE03B;</i></a>' +
                         '<a class="editkpi" title=""><i class="material-icons">&#xE254;</i></a>' +
                         '<a class="deletekpi" title=""><i class="material-icons">&#xE872;</i></a>' +
                         '</td></tr>';
                     $("#tableKPIList").append(trRow);
                     $("#tableKPIList tbody tr").eq(i + 1).find(".addkpi, .editkpi").toggle(); // Use 'i' instead of 'index'
                 }
             },
             error: function (e) {
                 console.error(e);
             }
         });
     }


