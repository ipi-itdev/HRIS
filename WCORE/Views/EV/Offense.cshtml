                         '<a class="deletekpi_offense" title=""><i class="material-icons">&#xE872;</i></a>' +
                         '</td></tr>';
                     $("#tableKPIList_offense").append(trRow_offense);
                     $("#tableKPIList_offense tbody tr").eq(i + 1).find(".addkpi_offense, .editkpi_offense").toggle(); // Use 'i' instead of 'index'
                 }

                   var userroles = @Html.Raw(ViewBag.userrolesrefno);
                  console.log('value ng userrroles: ' + userroles);
                  if (userroles == 53) {
                      $('.addkpi_offense').hide();
