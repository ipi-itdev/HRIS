                      $('.deletekpi_offense').hide();
                      $('.add-newkpi_offense').hide();
                 }

                 if (userroles == 55) {
                     $('.addkpi_offense').hide();
                     $('.editkpi_offense').hide();
                     $('.deletekpi_offense').hide();
                     $('.add-newkpi_offense').hide();
