         tableKPListDetails.empty();

         jQuery.ajax({
             url: '@Url.Action("GetEmployeeOffenseDetails", "KPI")',
             type: 'POST',
             dataType: 'json',
             data: {
                 PerfIndicatorID: perfindicatorid
             },
             success: function (data) {
                 var jsonArray_offense = JSON.parse(data);
                 for (var i = 0; i < jsonArray_offense.length; i++) {
                     var trRow_offense =
                         '<tr><td style="font-size: 12px" disabled>' + jsonArray_offense[i][0] +
                         '</td><td style="font-size: 12px">' + jsonArray_offense[i][3] +
                         '</td><td style="font-size: 12px">' + jsonArray_offense[i][1] +
                         '</td><td style="font-size: 12px">' + jsonArray_offense[i][2] + '</td>' +
