    function filterInput(event) {
            // List of special characters to block
            const specialChars = /[!#$%^&*(),.?":{}|<>]/;

            // Get the character code of the pressed key
            const charCode = event.which || event.keyCode;
            const charStr = String.fromCharCode(charCode);

            // Check if the character is a special character
            if (specialChars.test(charStr)) {
                // If it is a special character, prevent it from being entered

                Toast.Error("Doesn't Allow Special Characters");
                event.preventDefault();
                return false;
            }

            // Allow the character if it's not a special character
            return true;
    }


    function addrow_kpi_highesteducation() {
        var index2 = $("#tableKPIList_highesteducation tbody tr:last-child").index();
        var row = '<tr>' +
            '<td><input type="text" class="form-control" name="id" id="id" value="-1" style="font-size: 12px" disabled></td>' +
            '<td><input type="text" class="form-control" name="year" id="year" placeholder="Year Graduated" style="font-size: 12px" rows="5" onkeypress="return filterInput(event)"></td>' +
            '<td><input type="text" class="form-control" name="school" id="school" placeholder="School" style="font-size: 12px" rows="5" onkeypress="return filterInput(event)"></td></td>' +
            '<td><input type="text" class="form-control" name="course" id="course" placeholder="Course" style="font-size: 12px" rows="5" onkeypress="return filterInput(event)"></td></td>' +
            '<td>' +
            '<a class="addkpi_highesteducation" title=""><i class="material-icons">&#xE03B;</i></a>' +
            '<a class="editkpi_highesteducation" title=""><i class="material-icons">&#xE254;</i></a>' +
            '<a class="deletekpi_highesteducation" title=""><i class="material-icons">&#xE872;</i></a>' +
            '</td>' +
            '</tr>';
        $("#tableKPIList_highesteducation").append(row);
        $("#tableKPIList_highesteducation tbody tr").eq(index2 + 1).find(".addkpi_highesteducation, .editkpi_highesteducation").toggle();
        $('[data-toggle="tooltip"]').tooltip();
        $(".add-newkpi_highesteducation").attr("disabled", "disabled");
    }

    function loadKPIListDetails_highesteducation() {
        var tableKPListDetails = $("#tableKPIList_highesteducation tbody");
        // Clear table including dynamically added rows
        tableKPListDetails.empty();

        jQuery.ajax({
            url: '@Url.Action("GetEmplyeeHighestEducationDetails", "KPI")',
            type: 'POST',
            dataType: 'json',
            data: {
                PerfIndicatorID: perfindicatorid_highesteducation
            },
            success: function (data) {
                var jsonArray_highesteducation = JSON.parse(data);
                for (var i = 0; i < jsonArray_highesteducation.length; i++) {
                    var trRow_highesteducation = '<tr><td style="font-size: 12px" disabled>' + jsonArray_highesteducation[i][0] + '</td><td style="font-size: 12px">' + jsonArray_highesteducation[i][1] + '</td><td style="font-size: 12px">' + jsonArray_highesteducation[i][2] + '</td><td style="font-size: 12px">' + jsonArray_highesteducation[i][3] + '</td>';
                    trRow_highesteducation += '<td>' +
                        '<a class="addkpi_highesteducation" title="Add"><i class="material-icons">&#xE03B;</i></a>' +
                        '<a class="editkpi_highesteducation" title="Edit"><i class="material-icons">&#xE254;</i></a>' +
                        '<a class="deletekpi_highesteducation" title="Delete"><i class="material-icons">&#xE872;</i></a>' +
                        '</td></tr>';
                    $("#tableKPIList_highesteducation").append(trRow_highesteducation);
                    $("#tableKPIList_highesteducation tbody tr").eq(i + 1).find(".addkpi_highesteducation, .editkpi_highesteducation").toggle(); // Use 'i' instead of 'index'
                }

                 var userroles = @Html.Raw(ViewBag.userrolesrefno);
                 console.log('value ng userrroles: ' + userroles);
                if (userroles == 53) {

                     $('.editkpi_highesteducation').hide();
                     $('.deletekpi_highesteducation').hide();
                     $('.addkpi_highesteducation').hide();
                    $('.add-newkpi_highesteducation').hide();
                }

                if (userroles == 55) {

                    $('.editkpi_highesteducation').hide();
                    $('.deletekpi_highesteducation').hide();
                    $('.addkpi_highesteducation').hide();
                    $('.add-newkpi_highesteducation').hide();
                }


                if (userroles == 54) {

                    $('.editkpi_highesteducation').hide();
                    $('.deletekpi_highesteducation').hide();
                    $('.addkpi_highesteducation').hide();
                    $('.add-newkpi_highesteducation').hide();
                }
            },
            error: function (e) {
                console.error(e);
            }
        });
    }

    $(document).ready(function () {
    // Initial call to loadKPIListDetails
