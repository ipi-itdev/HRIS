     //Add row on add button click

    $(document).off("click", ".addkpi_highesteducation").on("click", ".addkpi_highesteducation", function () {

        var empty = false;
        var input = $(this).parents("tr").find('input[type="text"]');

        input.each(function () {
            if (!$(this).val() || $(this).val() == 0.00 || $(this).val() == 0) {
                $(this).addClass("error");
                empty = true;
            } else {
                $(this).removeClass("error");
            }
        });

        //---

        $(this).parents("tr").find(".error").first().focus();

        if (!empty) {
            input.each(function () {
                $(this).parent("td").html($(this).val());
            });

            //--
            var $tds = $(this).parents("tr").find('td'),
                id = $tds.eq(0).text(),
                year = "'" + $tds.eq(1).text() + "'",
                school = "'" + $tds.eq(2).text() + "'";
            course = "'" + $tds.eq(3).text() + "'";
            //kpi = kpi.replace(/'/g, "`");
            if (id == "-1") {
                saveType = 1;
            } else {
                saveType = 0;
            }

            /* if (year != null && ) {*/

            $.ajax({
                type: "POST",
                url: "../KPIView/UpdatingHighestEducation",
                contentType: "application/json; charset=utf-8",
                cache: false,
                data: JSON.stringify({ saveType: saveType, employeerefno: @ViewBag.pid, id: id, School: school, course: course, year: year }),
                success: function (data) {
                    if (data == 'True') {
                        // status = 1;
                        loadKPIListDetails_highesteducation(perfindicatorid_highesteducation);
                        $(this).parents("tr").find(".addkpi_highesteducation, .addkpi_highesteducation").toggle();
                        $(".add-newkpi_highesteducation").removeAttr("disabled");
                        $('#CategoryDetails').DataTable().ajax.reload();
                        $('#KPIAssignmentList_ListView_Table').DataTable().ajax.reload();
                        $('#KPIAssignmentDetails').DataTable().ajax.reload();
                        $('#KPIListInfo').DataTable().ajax.reload();
                        Toast.Show("Employee's Education Details Added/Updated");
                    }
                    else { }
                }
            })


            //} else {
            //    swal("Failed!", "Invalid Weight format.", "info");
            //    loadKPIListDetails(perfindicatorid);
            //    $(".add-newkpi").removeAttr("disabled");
            //}
        } else {
            Toast.Error("Please Complete All Required Fields");
        }
    });


     // Edit row on edit button click
    $(document).off("click", ".editkpi_highesteducation").on("click", ".editkpi_highesteducation", function () {

         $(this).parents("tr").find("td:not(:last-child)").each(function () {

             if (count == 1) {

                 $(this).html('<input id="id" onkeypress="return isNumberKey(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" disabled>');
                 count++;
                 recID = $("#kpiid").val();
                 $(".add-newkpi_highesteducation").attr("disabled", "disabled");
             } else if (count == 2) {

                 $(this).html('<input id="year" name="year" onkeypress="return filterInput(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="5">');
                 count++;
                 $(this).parents("tr").find(".addkpi_highesteducation, .editkpi_highesteducation").toggle();
                 $(".add-newkpi_highesteducation").attr("disabled", "disabled");

             } else if (count == 3) {

                 $(this).html('<input id="school" name="school" onkeypress="return filterInput(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="5">');
                 count++;
                 $(this).parents("tr").find(".addkpi_highesteducation, .editkpi_highesteducation").toggle();
                 $(".add-newkpi_highesteducation").attr("disabled", "disabled");

             } else if (count == 4) {

                 $(this).html('<input id="course" name="course" onkeypress="return filterInput(event)" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px">');
                 count++;
                 $(this).parents("tr").find(".addkpi_highesteducation, .editkpi_highesteducation").toggle();
                 $(".add-newkpi_highesteducation").attr("disabled", "disabled");

             } else {
                 count = 1;
                 return false;
             }
         });
     });

