    <script>
	var count = 1;
	var recordID = [];
	var listRec = [];
	var listID = [];
	var kpilistid, ktldg, kpiyear;
	var valid = true;
	var updateType = 0;
	var saveType = 0;
	var table;
	var isForSAVE = true;

	function loadKPIList() {
		var r = $.Deferred();

        table = $("#KPIListMain_External").DataTable({
            "columnDefs": [{ "targets": 3, "data": null, "defaultContent": "<button type='button' style='width: 100%' id='btnView_External' class='btn btn-alert'>View Details</button>" },
             {
                 "targets": [2],
                 "visible": false
             }
		    ],
			ajax: {
			    url: '@Url.Action("GetPerformanceIndicatorList", "KPI")?IsForManager=' + 0,
				type: 'POST',
				datatype: 'application/json; charset=utf-8',
				dataSrc: function (data) {
				    var jsonArray = JSON.parse(data);
				    listRec.length = 0;
				    listID.length = 0;
					if(JSON.parse(data) == ""){
						kpilistid = -1
						updateType = 1;
                        $('#ID_PerformanceIndicatorMain_External').val(kpilistid);
                        $('#Description_PerformanceIndicatorMain_External').val("N/A");
						return JSON.parse(data);
					}else {

					    for (var i = 0; i < jsonArray.length; i++){
					        listID[i] = jsonArray[i][0]
					        listRec[i] = jsonArray[i][1];
					    }
						kpilistid = jsonArray[0][0];

                        $('#ID_PerformanceIndicatorMain_External').val(kpilistid);
                        $('#Description_PerformanceIndicatorMain_External').val(jsonArray[0][1]);
						return JSON.parse(data);
					}
				},

				error: function (e) {}
			}
			, order: [[1, 'asc']], pageResize: true, ordering: false, lengthChange: false,
			initComplete: function () { }
		});
		return r;
	};


	$(document).ready(function () {

	    loadKPIList();

        var table = $('#KPIListMain_External').DataTable();
        $('#KPIListMain_External tbody').off().on('click', 'tr', function () {
			var data = table.row(this).data();
			kpilistid = data[0].toString();
            $('#ID_PerformanceIndicatorMain_External').val(data[0].toString());
            $('#Description_PerformanceIndicatorMain_External').val(data[1].toString());
			updateType = 0;
		});

	    //---

        $('#KPIListMain_External tbody').on('click', '#btnView_External', function () {
	        var data = table.row($(this).parents('tr')).data();
	        kpilistid = data[0];
	        categoryID = 5;
	        URL = "../KPI/KPIList";
	        var detailView = new KPIList(URL, data[1]);
	        detailView.open()
	    })
	});



    $('#KPIListNew_External').on('click', function () {

	    	updateType = 1;
        $('#ID_PerformanceIndicatorMain_External').val("-1");
        $('#Description_PerformanceIndicatorMain_External').val("N/A");
	});

    $('#KPIListSave_External').on('click', function () {

        if ($('#Description_PerformanceIndicatorMain_External').val() == "N/A" || $('#Description_PerformanceIndicatorMain_External').val() == "" || (!$('#Description_PerformanceIndicatorMain_External').val().replace(/\s/g, '').length) ||
            (!$('#Description_PerformanceIndicatorMain_External').val().replace(/\s/g, '').length)) {
			swal("Failed!", "Please fill-in all the required fields.", "info");
	    } else {

	        if(updateType == 1){
	            for (var i = 0; i < listRec.length; i++) {

                    var str = $('#Description_PerformanceIndicatorMain_External').val();
	                str = str.trim();

	                var listString = listRec[i];
	                listString = listString.trim();

	                if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
                         isForSAVE = false;
                         break;
                     }
                }
	        } else if (updateType == 0) {
	            for (var i = 0; i < listRec.length; i++) {

                    var str = $('#Description_PerformanceIndicatorMain_External').val();
	                str = str.trim();

	                var listString = listRec[i];
	                listString = listString.trim();

	                if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
                        if ($('#ID_PerformanceIndicatorMain_External').val() == listID[i]) {
	                        isForSAVE = true;
	                        break;
	                    } else {
	                        isForSAVE = false;
	                        break;
	                    }
	                }
	            }
	        }


	        if(isForSAVE == false){
	            Toast.Error("Duplicate Entry.");
	            isForSAVE = true;
	        } else if (isForSAVE == true) {

	            $.ajax({
	                type: "POST",
	                cache: false,
                    url: '../KPIView/UpdatingPerformanceIndicatorList?updateType=' + updateType + '&performanceIndicatorID=' + $('#ID_PerformanceIndicatorMain_External').val() + '&perfDesc=' + $('#Description_PerformanceIndicatorMain_External').val() + '&IsForManager=' + 0 + '&scoreCardID=' + 5,
	                success: function (data) {

	                    if (data == 'True') {
                            $('#KPIListMain_External').DataTable().ajax.reload();
	                        Toast.Show("KPI List successfully updated.");
	                        updateType = 0;
	                    }
	                    else { Toast.Show("Something went wrong.") }
	                }
	            })
	        }

		}
	});

	function isNumberKey(evt)
    {
        // change event.keyCode to evt.keyCode - april 8, 2024 noel
		var charCode = (evt.which) ? evt.which : evt.keyCode
		if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)){
			return false;}else{	return true;}
	}
    </script><div>
        <div style="clear:both;"></div>
    </div>
</section>