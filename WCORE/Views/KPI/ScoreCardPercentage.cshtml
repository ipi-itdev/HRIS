@System.Web.Optimization.Scripts.Render("~/Script/plugins/formslist")
<section class="content-header">
    <h1>Scorecard Percentage</h1>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round|Open+Sans">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <style type="text/css">
                body {
                    color: #404E67;
                    background: #F5F7FA;
                    /*font-family: 'Source Sans Pro', sans-serif;*/
                }

                .table-wrapper {
                    width: 100%;
                    /*margin: 30px auto;*/
                    background: #fff;
                    padding: 20px;
                    box-shadow: 0 1px 1px rgba(0,0,0,.05);
                }

                .table-title {
                    padding-bottom: 10px;
                    margin: 0 0 10px;
                }

                    .table-title h2 {
                        margin: 6px 0 0;
                        font-size: 22px;
                    }

                    .table-title .add-new {
                        float: right;
                        height: 30px;
                        font-weight: bold;
                        font-size: 5px;
                        text-shadow: none;
                        min-width: 100px;
                        border-radius: 50px;
                        line-height: 13px;
                    }

                        .table-title .add-new i {
                            margin-right: 4px;
                        }

                table.table tr th, table.table tr td {
                    border-color: #e9e9e9;
                }

                table.table th i {
                    font-size: 18px;
                    margin: 0 5px;
                    cursor: pointer;
                }

                table.table th:last-child {
                    width: 100px;
                }

                table.table td a {
                    cursor: pointer;
                    display: inline-block;
                    margin: 0 5px;
                    /*min-width: 24px;*/

                    max-width: 50px;
                    width: auto;
                    min-width: 10px;
                }

                    table.table td a.add {
                        color: #27C46B;
                    }

                    table.table td a.edit {
                        color: #FFC107;
                    }

                    table.table td a.delete {
                        color: #E34724;
                    }

                table.table td i {
                    /*font-size: 22px;*/

                    max-width: 50px;
                    width: auto;
                    min-width: 10px;
                }

                table.table td a.add i {
                    font-size: 22px;
                    margin-right: -1px;
                    position: relative;
                    top: 3px;
                    max-width: 50px;
                    width: auto;
                    min-width: 10px;
                }

                table.table .form-control {
                    height: 32px;
                    line-height: 32px;
                    box-shadow: none;
                    border-radius: 2px;
                }

                    table.table .form-control.error {
                        border-color: #f50000;
                    }

                table.table td .add {
                    display: none;
                    max-width: 50px;
                    width: auto;
                    min-width: 10px;
                }

                /*body {
          background: #ffffff;
          color: #414141;
          font: 400 17px/2em 'Source Sans Pro', sans-serif;
        }*/


    </style>

</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">

                <div class="col-md-7">
                    <div class="box-body" id="CRONUS">
                        <div id="tblList_CRONUS_wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                            <div class="col-sm-6">
                                <div class="btn-group" id="btnChildList_PerformanceIndicatorMain_ListView_Table">
                                    <button type="button" class="btn btn-default" id="btnScorecardNew"><i class="fa fa-file" title="New"></i> New</button>
                                </div>
                            </div>
                            <table id="tblScorecardHeader" style="width: 100%; font-size:12px;" class="table table-bordered table-striped table-hover tblList">
                                <thead id="tblHeadScorecard">
                                    <tr class="notfilter" role="row">
                                        <th style="width: 15%">ID</th>
                                        <th style="width: 58%">Scorecard Name</th>
                                        <th style="width: 30%">Last Modified Date</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot></tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div id="myParents_KPIAssignmentList">
                        <section class="content" id="myParents_KPIList">
                            <div class="btn-group-horizontal" id="btnList_Child_KPIList">
                                <button type="button" class="btn btn-primary" id="btnScorecardSave"><i class="fa fa-save" title="Save"></i>  Save</button>
                                @*<button type="button" class="btn btn-primary" id="Delete"><i class="fa fa-close" title="Delete"></i>  Delete</button>*@
                            </div>
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="nav-tabs-custom">
                                                    <ul class="nav nav-tabs" id="tab_child_KPIList">
                                                        <li class="active"><a href="#Details_Scorecard" data-toggle="tab" aria-expanded="true">Details</a></li>
                                                        <li><a href="#Other_ScorecardDetails" data-toggle="tab">Scorecard Details</a></li>
                                                    </ul>
                                                    <div class="tab-content">
                                                        <div class="tab-pane active" id="Details_Scorecard">
                                                            <div class="col-md-12">
                                                                <div class="form-group">
                                                                    <div class="row form-group">
                                                                        <label class="col-lg-4 control-label" style=" text-align:left" ="">
                                                                            <span style="color:red; font-size:20px; ">*  </span>ID
                                                                        </label><div class="col-lg-8 control-container vcenter">
                                                                            <input type="text" class="form-control unique required" id="ID_Scorecard" name="ID_Scorecard" title="ID" disabled>
                                                                        </div>
                                                                    </div><div class="row form-group" id="cntr_Description_PerformanceIndicatorMain">
                                                                        <label class="col-lg-4 control-label" style=" text-align:left" =""><span style="color:red; font-size:20px; ">*  </span>Scorecard Group</label><div class="col-lg-8 control-container vcenter">
                                                                            <input type="text" class="form-control unique required" id="Description_Scorecard" name="Description_Scorecard" title="Scorecard Group">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div style="clear:both;"></div>
                                                        </div><br>

                                                        <div class="tab-pane" id="Other_ScorecardDetails">
                                                            <div class="col-md-12">
                                                                <div class="form-group">
                                                                    <table class="table table-bordered" id="tableScorecardDetails">
                                                                        <thead>
                                                                            <tr>
                                                                                <th rowspan="1" colspan="1" style="width:12%; font-size: 13px;" data-field="id">ID</th>
                                                                                <th rowspan="1" colspan="1" style="width:60%; font-size: 13px" data-field="scorecard">Scorecard</th>
                                                                                <th rowspan="1" colspan="1" style="width:20%; font-size: 13px" data-field="weight">Weight</th>
                                                                                <th style="width:12%" ;></th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                            <div style="display: block; margin-top: 15px">
                                                                <span style="color: darkred; float: left; margin-left: 5px"><b>Note : </b></span>
                                                                <span style="color: black; float: left; margin-left: 5px"><b>The weight of the scorecard should be 100% in total.</b></span>
                                                            </div><br />
                                                            <div style="clear:both;"></div>
                                                        </div>
                                                    </div>
                                                    <div style="clear:both;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
	var count = 1;
	var recordID = [];
	var listRecScorecard = [];
	var listIDScorecared = [];
	var scorecardID;
	var saveType = 0;
	var table;
	var isForSAVE = true;
	var updateType = 0;
	var count = 1;

	var table = $("#tableScorecardDetails");
	var index = $("tableScorecardDetails tbody tr:last-child").index();

	function loadKPIList() {
		var r = $.Deferred();

		table = $("#tblScorecardHeader").DataTable({
		    "columnDefs": [{ "targets": 2 },
             {
                 //"targets": [2],
                 //"visible": false
             }
		    ],
			ajax: {
			    url: '@Url.Action("GetScorecardList", "KPI")',
				type: 'POST',
				datatype: 'application/json; charset=utf-8',
				dataSrc: function (data) {
				    var jsonArray = JSON.parse(data);
				    listIDScorecared.length = 0;
				    listRecScorecard.length = 0;
					if(JSON.parse(data) == ""){
					    scorecardID = -1
						updateType = 1;
						$('#ID_Scorecard').val(scorecardID);
						$('#Description_Scorecard').val("N/A");
						GetScorecardDetails(scorecardID);
						return JSON.parse(data);
					} else {

					    for (var i = 0; i < jsonArray.length; i++) {
					        listIDScorecared[i] = jsonArray[i][0]
					        listRecScorecard[i] = jsonArray[i][1];
					    }

					    scorecardID = jsonArray[0][0];

					    $('#ID_Scorecard').val(scorecardID);
					    $('#Description_Scorecard').val(jsonArray[0][1]);
					    GetScorecardDetails(scorecardID);
						return JSON.parse(data);
					}



				},

				error: function (e) {}
			}
			, order: [[1, 'asc']], pageResize: true, ordering: false, lengthChange: false,
			initComplete: function () { }
		});
		return r;
	};


	$(document).ready(function () {

	    loadKPIList();

	    var table = $('#tblScorecardHeader').DataTable();

	    $('#tblScorecardHeader tbody').off().on('click', 'tr', function () {
			var data = table.row(this).data();
			scorecardID = data[0].toString();
			$('#ID_Scorecard').val(data[0].toString());
			$('#Description_Scorecard').val(data[1].toString());

			GetScorecardDetails(scorecardID);
			updateType = 0;
	    });


	    ///---


	    // Add row on add button click
	    $(document).off("click", ".add").on("click", ".add", function () {


	        var empty = false;
	        var input = $(this).parents("tr").find('input[type="text"]');
	        columnCount = 1;
	        input.each(function () {
	            if (columnCount == 3) {
	                if (!$(this).val() || parseFloat($(this).val()) < 0.00 || parseFloat($(this).val()) > 100) {
	                    $(this).addClass("error");
	                    empty = true;
	                    return false;
	                } else {
	                    $(this).removeClass("error");
	                }
	            } else {
	                if (!$(this).val()) {
	                    $(this).addClass("error");
	                    empty = true;
	                    return false;
	                } else {
	                    $(this).removeClass("error");
	                }
	            }
	            columnCount++;
	        });

	        //---

	        $(this).parents("tr").find(".error").first().focus();
	        if (!empty) {
	            input.each(function () {
	                $(this).parent("td").html($(this).val());
	            });

	            var table = $("#tableScorecardDetails");
	            var $tds = $(this).parents("tr").find('td'),
                    id = $tds.eq(0).text();
	                weight = $tds.eq(2).text();

	            if (isNumeric(weight) == true) {

	                if (weight > 100 || weight < 0) {
	                    Toast.Error("Weight must not be less than zero.");

	                } else {

	                        $.ajax({
	                            type: "POST",
	                            url: "../KPIView/SetScorecardWeight",
	                            contentType: "application/json; charset=utf-8",
	                            data: JSON.stringify({ id: id, weight: weight }),
	                            cache: false,
	                            success: function (data) {
	                                if (data == 'True') {

	                                    GetScorecardDetails(scorecardID);
	                                    $('#KPIAssignmentList_ListView_Table').DataTable().ajax.reload();
	                                    $('#KPIAssignmentDetails').DataTable().ajax.reload();
	                                    $('#KPIListInfo').DataTable().ajax.reload();
	                                    $('#KPIListMainManager').DataTable().ajax.reload();

	                                    Toast.Show("Scorecard details updated.");
	                                    $(this).parents("tr").find(".add, .edit").toggle();
	                                }
	                                else { status = 0; }
	                            }
	                        })

	                }
	            } else {
	                Toast.Error("You have entered an invalid weight format.");
	            }

	        }
	    });

	    // Edit row on edit button click
	    $(document).off("click", ".edit").on("click", ".edit", function () {
	        $(this).parents("tr").find("td:not(:last-child)").each(function () {

	            if (count == 1) {
	                $(this).html('<input onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="1" disabled>');
	                count++;
	                $(this).parents("tr").find(".add, .edit").toggle();
	                $(".add").attr("disabled", "disabled");

	            } else if (count == 2) {
	                $(this).html('<input onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="1" disabled>');
	                count++;
	                $(this).parents("tr").find(".add, .edit").toggle();
	                $(".add").attr("disabled", "disabled");
	            } else if (count == 3) {
	                $(this).html('<input onkeypress="return" type="text" class="form-control" value="' + $(this).text() + '" style="font-size: 12px" rows="1">');
	                count++;
	                $(this).parents("tr").find(".add, .edit").toggle();
	                $(".add").attr("disabled", "disabled");

	            } else {
	                count = 1;
	                return false;
	            }
	        });
	    });

	});


	$('#btnScorecardNew').on('click', function () {

	    	updateType = 1;
	        $('#ID_Scorecard').val("-1");
	        $('#Description_Scorecard').val("N/A");
	        GetScorecardDetails(-1);

	});

	$('#btnScorecardSave').on('click', function () {

	    if ($('#Description_Scorecard').val() == "N/A" || $('#Description_Scorecard').val() == "" || (!$('#Description_Scorecard').val().replace(/\s/g, '').length) ||
            (!$('#Description_Scorecard').val().replace(/\s/g, '').length)) {

	        Toast.Error("Please fill-in all the required fields.")

	    } else {

	        if(updateType == 1){
	            for (var i = 0; i < listRecScorecard.length; i++) {

	                var str = $('#Description_Scorecard').val();
	                str = str.trim();

	                var listString = listRecScorecard[i];
	                listString = listString.trim();

	                if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
                         isForSAVE = false;
                         break;
                     }
                }
	        } else if (updateType == 0) {
	            for (var i = 0; i < listRecScorecard.length; i++) {

	                var str = $('#Description_Scorecard').val();
	                str = str.trim();

	                var listString = listRecScorecard[i];
	                listString = listString.trim();

	                if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
	                    if ($('#ID_Scorecard').val() == listIDScorecared[i]) {
	                        isForSAVE = true;
	                        break;
	                    } else {
	                        isForSAVE = false;
	                        break;
	                    }
	                }
	            }
	        }


	        if(isForSAVE == false){
	            Toast.Error("Duplicate Entry.");
	            isForSAVE = true;
	        } else if (isForSAVE == true) {

	            $.ajax({
	                type: "POST",
	                cache: false,
	                url: '../KPIView/UpdatingScorecard?updateType=' + updateType + '&ScorecardID=' + $('#ID_Scorecard').val() + '&desc=' + $('#Description_Scorecard').val(),
	                success: function (data) {

	                    if (data == 'True') {
	                        Toast.Show("Scorecard successfully updated.");
	                        $('#tblScorecardHeader').DataTable().ajax.reload();
	                        updateType = 0;
	                    }
	                    else { Toast.Error("Something went wrong.") }
	                }
	            })
	        }

		}
	});


	function GetScorecardDetails(id) {
	    var a = $.Deferred();

	    var table3 = $("#tableScorecardDetails");
	    table3.find('tr').each(function (i) {
	        if (!this.rowIndex) return;
	        this.parentNode.removeChild(this);
	    });

	        jQuery.ajax({
	            url: '@Url.Action("GetScorecardDetails", "KPI")?ScorecardID=' + id,
		        type: 'POST',
		        datatype: 'application/json; charset=utf-8',
		        success: function (data) {
		        var jsonArray = JSON.parse(data);
		        for (var i = 0; i < jsonArray.length; i++) {

		            var trRow = '';

		            trRow += '<tr><td style="font-size: 12px" disabled>' + jsonArray[i][0] + '</td><td style="font-size: 12px" rows="5" disabled>' + jsonArray[i][1] + '</td><td style="font-size: 12px">' + jsonArray[i][2].toFixed(2) + '</td>';

		            trRow += '<td>' +
							 '<a class="add" title="Add"><i class="material-icons">&#xE03B;</i></a>' +
							 '<a class="edit" title="Edit"><i class="material-icons">&#xE254;</i></a>' +
							 '</td></tr>';
		            $("#tableScorecardDetails").append(trRow);
		            $("tableScorecardDetails tbody tr").eq(index + 1).find(".add, .edit").toggle();
		        }
		    },
		    error: function (e) {
		    }
	    });


        return a;
	}


    //----

	function isNumberKey(evt)
	{
		var charCode = (evt.which) ? evt.which : event.keyCode
		if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)){
			return false;}else{	return true;}
	}

	function isNumeric(num) {
	    return !isNaN(num)
	}

    </script><div>
        <div style="clear:both;"></div>
    </div>
</section>