<section class="content-header">
    <h1>Expiring Contract</h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-list"></i> Summary</a></li>
        <li class="active">Expiring Contract</li>
    </ol>
</section>
<section class="content" style="position:absolute">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="box-body" id="ExpiringContract">
                    <div class="box-tools pull-right">
                        <select class="select2 form-control" id="ECdays" style="width:100px;">
                            <option value="15">15 days</option>
                            <option value="30">30 days</option>
                            <option value="45">45 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="0">Expired</option>
                        </select>
                    </div>
                    <div id="tblList_ExpiringContract_wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                        <table id="tblList_ExpiringContract" class="table table-bordered table-striped table-hover tblList" style="font-size:13px;">
                            <thead id="tblHead">
                                <tr class="notfilter" role="row">
                                    <th width="300">Name</th>
                                    <th width="300">Client</th>
                                    <th width="200">Employment Status</th>
                                    <th width="200">End Date</th>
                                    <th width="300">Remaining Days</th>
                                </tr>
                            </thead>
                            <tbody id="tblBody"></tbody>
                            <tfoot></tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    var table;
    $(document).ready(function () {
        $('.content-wrapper').waitMe('hide');
        $("#ExpiringContract").on("change", "#ECdays", function () {
            table.destroy();
            getEOCM();
        })
        getEOCM();
    })
    function getEOCM() {  
        table = $("#tblList_ExpiringContract").DataTable({
            dom: "<'row'<'col-sm-3'B><'col-sm-3'f>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            ajax: {
                url: '@Url.Action("getListEOC","Home")?days=' + $('#ECdays').val(),
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) {
                    return JSON.parse(data);
                },
                error: function (e) { }
            },
            order: [[1, 'asc']],
            buttons: ['copy', 'excel']
        });
    }
</script>
<style>
    .tblList {
        width: 100% !important;
    }

        .tblList td,
        .tblList th {
            white-space: normal;
            text-overflow: ellipsis;
            overflow: hidden;
        }
</style>
