                            <script>
                                var tablemlist;
                                var lsthtml = '';
                                var strcol = null;
                                var strparam = null;
                                var strparamval = null;
                                $(document).ready(function () {
									var zkswm = {ID: null,EmployeeStatusRefNo:1 , MRRefNo: null, FOWRefNo:null, ClientAccountRefNo:null }
                                    function EmployeeMasterlist_DetailView_Child() {
                                        this.IsEditOnly = false;
                                        var ObjectID = -1;
                                        var dvFormat = [{ Name: 'Employment', Controls: [
                                                    { Name: 'EmployeeStatusRefNo', Caption: 'Employee Status', Type: 'Int', ControlType: 'combobox', RefColumn: 'ESS', ControlModel: 'EmployeeStatus', ColumnValue: 'ID', DisplayColumnValue: 'Description',  ColumnNo: 0, TbName: 'Employment', ControlID: 'EmployeeStatusRefNo' },
                                                    { Name: 'MRRefNo', Caption: 'MR', Type: 'Int', ControlType: 'combobox', RefColumn: 'MR', ControlModel: 'MarketingRep', ColumnValue: 'ID', DisplayColumnValue: 'Description', ColumnNo: 0, TbName: 'Employment', ControlID: 'MRRefNo' },
                                                    { Name: 'FOWRefNo', Caption: 'Field of Work', Type: 'Int', ControlType: 'combobox', RefColumn: 'FOW', ControlModel: 'FOW', ColumnValue: 'ID', DisplayColumnValue: 'Description', ColumnNo: 0, TbName: 'Employment', ControlID: 'FOWRefNo' },
                                                    { Name: 'ClientAccountRefNo', Caption: 'Client', Type: 'Int', ControlType: 'combobox', RefColumn: 'C', ControlModel: 'ClientAccount', ColumnValue: 'ID', DisplayColumnValue: 'Description',  ColumnNo: 0, TbName: 'Employment', ControlID: 'ClientAccountRefNo' },
                                                    { Name: 'EmployeeTypeRefNo', Caption: 'Rank Level', Type: 'Int', ControlType: 'combobox', RefColumn: 'ET', ControlModel: 'EmployeeType', ColumnValue: 'ID', DisplayColumnValue: 'Description',  ColumnNo: 0, TbName: 'Employment', ControlID: 'EmployeeTypeRefNo' },
                                                    { Name: 'EmploymentStatusRefNo', Caption: 'Employment Status', Type: 'Int', ControlType: 'combobox', RefColumn: 'EMPS', ControlModel: 'EmploymentStatus', ColumnValue: 'ID', DisplayColumnValue: 'Description',  ColumnNo: 0, TbName: 'Employment', ControlID: 'EmploymentStatusRefNo' },
                                                    { Name: 'MaxicareCoverageRefNo', Caption: 'Malayan Coverage', Type: 'Int', ControlType: 'combobox', RefColumn: 'MC', ControlModel: 'MaxicareCoverage', ColumnValue: 'ID', DisplayColumnValue: 'Description',  ColumnNo: 0, TbName: 'Employment', ControlID: 'MaxicareCoverageRefNo' },
                                                    { Name: 'MaxicarePolicyNo', Type: 'String', ControlModel: 'EmployeeMasterlist', ColumnNo: 0, TbName: 'Employment', ControlID: 'MaxicarePolicyNo' }]
                                            }];
                                        function GetControl_Child(Selector, CtrlFormat) {
                                            var control = new JIBControl(Selector, { PropertyName: CtrlFormat.Name, Caption: (CtrlFormat.Caption == undefined ? CtrlFormat.Name : CtrlFormat.Caption), type: CtrlFormat.ControlType, Model: CtrlFormat.ControlModel, ControlID: CtrlFormat.ControlID, ControlFormat: CtrlFormat.strFormat }, CtrlFormat, 'EmployeeMasterlist');
                                            control.IsRequired = CtrlFormat.IsRequired != undefined ? CtrlFormat.IsRequired : false;
                                            control.IsUnique = CtrlFormat.IsUnique != undefined ? CtrlFormat.IsUnique : false;
                                            control.ParentDiv = Selector
                                            control.Init();
                                            if (CtrlFormat.IsEnabled != undefined) control.SetEnabled(CtrlFormat.IsEnabled);
                                            control.CurrentObject = zkswm;
                                            return control;
                                        };
                                        function InitNewObject_Child(newObject) {
                                            $.each(newObject, function (key, value) {
                                                if (key != "IsEditOnly") {
                                                    zkswm[key] = value;
                                                }
                                            });
                                            $.each(dvFormat, function (i, tabs) {
                                                $.each(tabs.Controls, function (x, val) {
                                                    Selector = $('#' + tabs.Name + '_Form_Child_EmployeeMasterlist_DetailView');
                                                    var control = GetControl_Child(Selector, val);
                                                    control.SetValue(zkswm[val.Name]);
                                                });
                                            });
                                        }
                                        this.InitDetailView_Child = function (CurrentObject) {
                                            $.ajax({
                                                url: '../DetailView/GetBaseObject',
                                                data: { model: 'EmployeeMasterlist', pKey: ObjectID },
                                                type: 'POST',
                                                datatype: 'application/json; charset=utf-8',
                                                beforeSend: function () { },
                                                success: function (data) {
                                                    if (ObjectID == -1) {
                                                        var newObject = eval("(function(){return " + data + ";})()");
                                                        InitNewObject_Child(newObject);
                                                    } else {
                                                        var jsonArray = JSON.parse(data);
                                                        if (jsonArray.length == 0) return;
                                                        var Columns = jsonArray[0];
                                                        var Values = jsonArray[1];
                                                        $.each(Columns, function (i, o) {
                                                            CurrentObject[o] = Values[i];
                                                        });
                                                        $.each(dvFormat, function (x, tabs) {
                                                            $.each(tabs.Controls, function (i, val) {
                                                                Selector = $('#' + tabs.Name + '_Form_Child_EmployeeMasterlist_DetailView');
                                                                var control = GetControl_Child(Selector, val);
                                                                var ColumnIndex = Columns.indexOf(val.Name);
                                                                var Value = Values[ColumnIndex];
                                                                control.SetValue(Value);
                                                            });
                                                        });
                                                    }
                                                }, error: function (e) { alert(e.responseText); }
                                            });
                                        };
                                    }
                                    var $itm = new EmployeeMasterlist_DetailView_Child();
                                    $itm.InitDetailView_Child(zkswm);

                                    $('#myParent_EmployeeMasterlist').trigger("OnDetailViewContentCreated", { BaseObject: zkswm, DetailView: new EmployeeMasterlist_DetailView_Child() });
                                    $('#myParent_EmployeeMasterlist').unbind("OnDetailViewContentCreated");

                                    $('#tab_child_EmployeeMasterlist>li>a').first().click();

                                    $('#btnFilter').off('click').on('click', function () {
                                        getval().done(populateTable());
                                    })

                                })

                                function getval() {
                                    var r = $.Deferred();
                                    strcol = ''; strparam = ''; strparamval = '';
                                    if ($('#col_EmployeeNumber').prop('checked')) { strcol = strcol == null ? 'EmployeeNumber,' : strcol + 'EmployeeNumber,' }
                                    if ($('#col_LastName').prop('checked')) { strcol = strcol == null ? 'LastName,' : strcol + 'LastName,' }
                                    if ($('#col_FirstName').prop('checked')) { strcol = strcol == null ? 'FirstName,' : strcol + 'FirstName,' }
                                    if ($('#col_MiddleName').prop('checked')) { strcol = strcol == null ? 'MiddleName,' : strcol + 'MiddleName,' }


                                    if ($('#GenderRefNo_EmployeeMasterlist').val() > 0) { strparam = strparam == null ? 'GenderRefNo,' : strparam + 'GenderRefNo,'; strparamval = strparamval == null ? $('#GenderRefNo_EmployeeMasterlist').val() + ',' : strparamval + $('#GenderRefNo_EmployeeMasterlist').val() + ','; }
                                    if ($('#NationalityRefNo_EmployeeMasterlist').val() > 0) { strparam = strparam == null ? 'NationalityRefNo,' : strparam + 'NationalityRefNo,'; strparamval = strparamval == null ? $('#NationalityRefNo_EmployeeMasterlist').val() + ',' : strparamval + $('#NationalityRefNo_EmployeeMasterlists').val() + ','; }

                                    strcolumns = null;
                                    var strcolumns = strcol.split(',');
                                    
                                    if (lsthtml != '') { tablemlist.destroy(); }
                                    lsthtml = '';
                                    for (var i = 0; i < (strcolumns.length - 1) ; i++) {
                                        lsthtml = lsthtml + "<th>" + strcolumns[i] + "</th>";
                                    }
                                    $("#lstMasterlist thead tr").html('');
                                    $("#lstMasterlist thead tr").append(lsthtml);
                                    return r;
                                }

                                function populateTable() {
                                    var today = new Date();
                                    var date = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
                                    var time = today.getHours() + "-" + today.getMinutes() + "-" + today.getSeconds();
                                    var dateTime = date + ' ' + time;
                                    if (strcol != null) {
                                        tablemlist = $("#lstMasterlist").DataTable({
                                            //stateSave: true,
                                            dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-2'B><'col-sm-4'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
                                            "autoWidth": false,
                                            ajax: {
                                                url: '../PIS/GetMasterlist?strcol=' + strcol + '&strparam=' + strparam + '&strparamval=' + strparamval,
                                                type: 'POST',
                                                datatype: 'application/json; charset=utf-8',
                                                dataSrc: function (data) { return JSON.parse(data); },
                                            },
                                             pageResize: true, bSortCellsTop: true, buttons: [{
                                             extend: 'excel', title: 'Masterlist' + ' ' + dateTime
                                            }],
                                             "deferRender": true, "bLengthChange": false 
                                        });
                                    }
                                }
                            </script>
