<section class="content-header">
      <h1>Loading Report</h1>
      <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
        <li class="active">Loading Report</li>
      </ol>
</section>
<section class="content">
<div class="row">
    <div class="col-xl-12">
        <div class="col-md-4">
            <div class="form-group">
                <div class="row form-group">
                    <label class="col-lg-3 control-label" style="text-align:left">Employee Name</label>
                    <div class="col-lg-8 control-container vcenter">
                        <select id="Employee" class="select2 form-control" style="width: 100%;"></select>
                    </div>
                </div>
            </div>
        </div>
        <div id="btnList_Child_EmployeeMasterlist" class="no-padding">
            <button type="button" class="btn btn-primary" id="Filter"><i class="fa fa-filter" title="Filter"></i>  Filter</button>
        </div>
    </div>
</div>
<div class="row">
      <div class="col-md-12">
          <div class="box box-primary">
             <div class="box-body">
                <table id="lstDirectCost" class="table table-bordered table-striped table-hover tblList table-responsive" style="font-size:13px; width:100%;">
                <thead id="tblHead">
                    <tr class="nofilters">
                        <th width:50px; class="wfilter">Year</th>
                        <th width:50px; class="wfilter">Month</th>
                        <th class="wfilter">Employee</th>
                        <th>Total DC</th>
                        <th>B.NetPay</th>
                        <th>SSS_ER</th>
                        <th>EC</th>
                        <th>PAG_ER</th>
                        <th>PHIL_ER</th>
                        <th>13thMo</th>
                        <th>LWP</th>
                        <th>UnPBP</th>
                        <th>Adj.</th>
                        <th>Tax</th>
                        <th>NonTax</th>
                        <th>MealA</th>
                        <th>Hol</th>
                        <th>OT</th>
                        <th>ND</th>
                        <th>RD</th>
                    </tr>
                    <tr class="filters">
                        <th class="wfilter">Year</th>
                        <th class="wfilter">Month</th>
                        <th class="wfilter">Employee</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot></tfoot>
            </table>
             </div>
          </div>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        $('.content-wrapper').waitMe('hide');
        InitDropdownOTH();

        var IsPageLoad = false;
        var tablemlistdirectCost;
        var dateTime;
        

        var today = new Date();
        var date = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
        var time = today.getHours() + "-" + today.getMinutes() + "-" + today.getSeconds();
        dateTime = date + ' ' + time;

        $('#sdate').attr('data-inputmask', "'alias': 'mm/dd/yyyy'");
        $('#sdate').attr('data-mask', '');
        $('#sdate').inputmask();
        $('#sdate').val('1/1/2019');


        $('#edate').attr('data-inputmask', "'alias': 'mm/dd/yyyy'");
        $('#edate').attr('data-mask', '');
        $('#edate').inputmask();
        $('#edate').val('12/31/2019');

        populateTable(0);

        $('#Filter').off('click').on('click', function () {
            populateTable($('#Employee').val());
        })

        function populateTable(empno) {
            if (IsPageLoad == true) { tablemlistdirectCost.destroy(); IsPageLoad = false; populateTable(empno) } else {
                IsPageLoad = true;
                $('#lstDirectCost thead .filters th.wfilter').each(function () { $(this).html('<input type="text"/>'); });
                tablemlistdirectCost = $("#lstDirectCost").DataTable({
                    stateSave: true,
                    dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-2'B><'col-sm-4'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
                    "autoWidth": false,
                    ajax: {
                        url: '../PIS/GetdirectCost?empno=' + empno,
                        type: 'POST',
                        datatype: 'application/json; charset=utf-8',
                        dataSrc: function (data) { return JSON.parse(data); },
                    },
                    pageResize: true, bSortCellsTop: true, buttons: [{
                        extend: 'excel', title: 'Masterlist' + ' ' + dateTime
                    }],
                    "deferRender": true, "bLengthChange": false
                });

                tablemlistdirectCost.columns('.wfilter').eq(0).each(function (colIdx) {
                    $('input', $('#lstDirectCost thead .filters th')[colIdx]).on('keyup change', function () {
                        tablemlistdirectCost
                    .column(colIdx)
                    .search(this.value)
                    .draw();
                    });
                });
            }
        }
    })


    function InitDropdownOTH(mname, textboxControl) {
        jQuery.ajax({
            url: "../PIS/GetAllemployeeList",
            data: { Model: mname },
            type: 'POST',
            datatype: 'application/json; charset=utf-8',
            success: function (data) {
                var jsonArray = JSON.parse(data);
                if (jsonArray.length == 0) return;
                for (var i = 1; i < jsonArray.length; i++) {
                    Columns = jsonArray[i];
                    $("#Employee").append('<option id=' + Columns[0] + ' value=' + Columns[0] + '>' + Columns[1] + '</option>');
                }
            },
            error: function (e) {
            }
        });
        $("#Employee").select2();
    }


</script>
<style>
    
