@{ Layout = "~/Views/_Layout.cshtml"; }
<style>
.four_zero_four_bg
{
    background: url('../Contents/img/bg.gif') no-repeat;
    height: 400px;
    background-position: center;
    margin: 0 7% 7% 7% auto;
}

h1
{
    font-size: 80px;
}

h3
{
    font-size: 80px;
}

button
{
    color: #fff;
    text-decoration: none;
    padding: 10px 20px;
    background: #39ac31;
    display: inline-block;
    outline: none;
    border: none;
}

a:hover
{
    text-decoration: none;
    color: rgb(145, 104, 21);
    cursor: pointer;
}

.footer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    text-align: center;
    
}   
.content_box_404
{
    margin-top: -50px;
}
</style>
<section class="page_404">
    <div class="row">
        <div class="col-sm-12">
            <div class="text-center">
                <div class="four_zero_four_bg">
                    <h1 class="text-center">Oopss!</h1>
                </div>
                <div class="content_box_404">
                    <h3 class="h2">The page you are looking is not available</h3>
                    <p>Please contact the system administrator.</p>
                    <button type="button" onclick="CreateTicket()">Send a ticket</button><br><br>
                    <p>Send us a <a href="#" onclick="CreateTicket()">ticket</a> now or email us at <a href="mailto:itdev@ipiphil.com">itdev@ipiphil.com</a></p>
