<section class="content">
<div class="box">
	<div class="box-header">
		<div id="btnList_@ViewBag.FormID">
			<button type="button" class="btn btn-primary" id="Back_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Back"></i>  Back to List</button>
			<div style="float:right;">
				<button type="button" class="btn btn-primary" id="Compute_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Compute"></i>  Compute</button>
			</div>
		</div>
	</div>
    <div class="box-body" id="@ViewBag.FormID">
		<div class="row">
			<div class="col-md-12">
				<div class="row">
					<div class="col-md-4">
						<div class="row form-group">
							<label class="col-lg-12 control-label style="text-align:left">Type of Service </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.ServiceType" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left">Gross Revenue  </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.GrossRevenue" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left">Direct Cost   </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.DirectCost" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left">Gross Margin   </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.GrossMargin" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left">Gross Margin %  </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.GMP" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left">Commission  </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.Commission" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-md-12">
				<div class="nav-tabs-custom">
					<ul class="nav nav-tabs" role="tablist">
						<li class="nav-item active"><a class="nav-link active" data-toggle="tab" href="#Details_Form_@ViewBag.FormID" role="tab">Details</a></li>
						<li class="nav-item"><a class="nav-link" data-toggle="tab" href="#NewAccountIncentive_List_@ViewBag.FormID" role="tab">New Account Incentive</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="Details_Form_@ViewBag.FormID" role="tabpanel">
							<div class="table-responsive">
								<table class="table table-striped table-bordered">
									<thead>
										<tr>
											<th><strong>Account</strong></th>
											<th><strong>Invoice#</strong></th>
											<th><strong>Description</strong></th>
											<th><strong>Collection</strong></th>
											<th><strong>EWT%</strong></th>
											<th><strong>GR EWT</strong></th>
											<th><strong>Cost</strong></th>
											<th><strong>DC</strong></th>
											<th><strong>Total DC</strong></th>
											<th><strong>GM</strong></th>
											<th><strong>GM%</strong></th>
											<th><strong>CR%</strong></th>
											<th><strong>Commission</strong></th>
											<th><strong>Transferred</strong></th>
											<th><strong>Comm Due</strong></th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>TOTAL</strong></td>
											<td><input name="totalmqJAN" type="text" value="0.00" id="totalmqJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalyqJAN" type="text" value="0.00" id="totalyqJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalmpJAN" type="text" value="0.00" id="totalmpJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalypJAN" type="text" value="0.00" id="totalypJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalyaJAN" type="text" value="0.00" id="totalyaJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalaqaJAN" type="text" value="0.00" id="totalaqaJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalmqJAN" type="text" value="0.00" id="totalmqJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalyqJAN" type="text" value="0.00" id="totalyqJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalmpJAN" type="text" value="0.00" id="totalmpJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalypJAN" type="text" value="0.00" id="totalypJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalyaJAN" type="text" value="0.00" id="totalyaJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalaqaJAN" type="text" value="0.00" id="totalaqaJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalyaJAN" type="text" value="0.00" id="totalyaJAN" disabled="disabled" class="form-control right" /></td>
											<td><input name="totalaqaJAN" type="text" value="0.00" id="totalaqaJAN" disabled="disabled" class="form-control right" /></td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
						<div class="tab-pane" id="NewAccountIncentive_List_@ViewBag.FormID" role="tabpanel">
							<table id="tblNewAccountIncentive_@{@ViewBag.FormID}" class="table table-bordered table-striped">
								<thead id="tblNewAccountIncentive_@{@ViewBag.FormID}">
									<tr class="notfilter" role="row">
										<th width="80%">Description</th>
										<th width="80%">Amount</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
</section>
<script>
$(document).ready(function () {
    let table_@{@ViewBag.FormID} = $("#tblNewAccountIncentive_@{@ViewBag.FormID}").DataTable({
        ajax: {
			url: '@Url.Action("NewAccountIncentive", "CS")',
			data: { pkey: '@ViewBag.pid' },
			type: 'POST',
			datatype: 'application/json; charset=utf-8',
			dataSrc: function (data) { return JSON.parse(data); },
			error: function (e) { }
        }
        , order: [[1, 'asc']], "paging": false, "searching": false
    });

    $('#btnList_@ViewBag.FormID').find('button').off('click').on('click', function() {
		var ids = $(this).attr('id'), Message = '', OkLabel = 'OK', fAction = null;
        switch ( ids.replace('@ViewBag.FormID-','').toUpperCase() ) {
			case 'Compute_@ViewBag.FormID'.toUpperCase():
				$.ajax({
					type: "POST",
					cache: false,
					url: '../CS/Compute?pkey=@ViewBag.pid',
					success: function (data) {
						if (data == 'True') { 
							var URLView = '../CS/YTDPerformance?mguid=@{@ViewBag.mguid}&pid=@{@ViewBag.pid}'; 
							$('#content_@ViewBag.FormID').load(URLView, function () { });
						}
						else { Toast.Error("Error"); }
					}
				});
                break;
            case 'Back_@ViewBag.FormID'.toUpperCase():
				Message = 'Are you sure you want to go back to list?';
				OkLabel = 'Back to List';
                fAction = function(result){
					if(result){
						var URLView = '../ListView/ListIndex?mguid=@{@ViewBag.mguid}'; 
						$('#content_@ViewBag.FormID').load(URLView, function () { });
					}
				}
				break;
		}
		if(ids.toUpperCase() != 'Compute_@ViewBag.FormID'.toUpperCase()){
			BootstrapDialog.confirm({
				title: '@ViewBag.Caption', icon: 'fa-list', message: Message, closable: true,
				btnCancelLabel: 'Cancel', btnOKLabel: OkLabel,
				callback: fAction
			});
		}
	})
})
$('.content-wrapper').waitMe('hide');
</script>

