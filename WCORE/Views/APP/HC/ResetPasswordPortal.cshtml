<section class="content-header">
    <h1>Update Portal Information</h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
        <li class="active">Update Portal Information</li>
    </ol>
</section>
<section class="content" style="position:absolute">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="box-body" id="DeploymentInfo">
                    <div id="tblList_DeploymentInfo_wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                        <table id="tblList_DeploymentInfo" class="table table-bordered table-striped table-hover tblList" style="font-size:13px;">
                            <thead id="tblHead_DeploymentInfo">
                                <tr class="notfilter" role="row">
                                    <th rowspan="1" colspan="1" width="1%">ID</th>
                                    <th rowspan="1" colspan="1" width="20%">Employee Number</th>
                                    <th rowspan="1" colspan="1" width="40%">Name</th>
                                    <th rowspan="1" colspan="1" width="20%">Email</th>
                                    <th rowspan="1" colspan="1" width="15%">Deployment Date</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
$(document).ready(function () {
    var table_DeploymentInfo;

    table_DeploymentInfo = $("#tblList_DeploymentInfo").DataTable({
        ajax: {
            url: '@Url.Action("GetListEmployeePortal", "Home")',
            type: 'POST',
            datatype: 'application/json; charset=utf-8',
            dataSrc: function (data) { return JSON.parse(data); },
            error: function (e) { }
        }
        , order: [[1, 'asc']], "paging": false,        
        initComplete: function () { $("#tblList_DeploymentInfo").SetEditable({ columnsEd: "3,4", onEdit: function (columnsEd) { uinfo(columnsEd); } }); }
    });

    function uinfo(columnsEd)
    {
        var empno = columnsEd[0].childNodes[0].innerHTML;
        var bdate = columnsEd[0].childNodes[4].innerHTML;
        var email = columnsEd[0].childNodes[3].innerHTML;
        var Message = '';
        var OkLabel = 'Update';
        var fAction = null;
        Message = 'Are you sure you want to update the information?';
        fAction = function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    cache: false,
                    url: '../Home/UpdatePortal?id=' + empno + '&bdate=' + bdate + '&email=' + email,
                    success: function (data) {
                        if (data == 'True') {
                            Toast.Show("Updated Successfully.");
                        }
                        else { Toast.Error("Error"); }
                    }
                });
            }
        }
        BootstrapDialog.confirm({
            title: 'Reset Password',
            icon: 'fa-users',
            message: Message,
            closable: true,
            draggable: true,
            btnCancelLabel: 'Cancel',
            btnOKLabel: OkLabel,
            callback: fAction
        });
    }
})
</script>
<style>
    .tblList { width: 100% !important; }
    .tblList td, .tblList th { white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
</style>
