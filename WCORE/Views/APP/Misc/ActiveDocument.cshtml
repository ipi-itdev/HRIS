@System.Web.Optimization.Scripts.Render("~/Script/plugins/formslist")
<section class="content-header">
    <h1>Document Tracker</h1>
</section>

<section class="content" style="position: center">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="table-wrapper">
                    <div class="col-md-5">
                        <div class="box-body">
                            <div class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                                <div class="btn-group-horizontal">
                                    <button type="button" class="btn btn-default" id="NewDocumentTracker" onclick="NewDocument()"><i class="fa fa-file" title="New"></i>New</button>
                                </div>
                                <table id="tblDocumentTracker" class="table table-bordered table-striped table-hover tblList" style="font-size: 13px; width: 100%">
                                    <thead id="tblDocumentTrackerHead">
                                        <tr class="notfilter" role="row">
                                            <th style="width: 5%">ID</th>
                                            <th style="width: 65%">Document</th>
                                            <th style="width: 30%">Status</th>
                                            <th>reated Date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbllDocumentTrackeBody"></tbody>
                                    <tfoot></tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <section class="content">
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="nav-tabs-custom">
                                                    <ul class="nav nav-tabs">
                                                        <li class="active"><a href="#Details_Form_Child_DocumentTracker" data-toggle="tab" aria-expanded="true">Progress Details</a></li>
                                                    </ul>
                                                    <div class="tab-content">
                                                        <div class="tab-pane active" id="Details_Form_Child_DocumentTracker">
                                                            <div class="col-md-12">
                                                                <div class="form-group" id="Details_Form_Child_DocumentTracker_DetailView">
                                                                    <table id="tblDocumentTrackerDetails" class="table table-bordered table-striped table-hover tblList" style="font-size: 13px; width: 100%">
                                                                        <thead id="tblDocumentTrackerDetailsHead">
                                                                            <tr class="notfilter" role="row">
                                                                                <th>ID</th>
                                                                                <th style="width: 20%">From</th>
                                                                                <th style="width: 20%">To</th>
                                                                                <th style="width: 10%">Document Status</th>
                                                                                <th style="width: 15%">Date</th>
                                                                                <th style="width: 30%">Remarks</th>
                                                                                <th></th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody id="tblDocumentTrackerDetailsBody"></tbody>
                                                                        <tfoot></tfoot>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                            <div style="clear: both;"></div>
                                                        </div>
                                                        <br>
                                                    </div>
                                                    <div style="clear: both;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>

var tableDocumentTracker;
var tableDocumentDetailsTracker;
docName = "";

$(document).ready(function () {

    LoadDocuments();

});

//---------------- 

    function LoadDocuments(){
            var r = $.Deferred();

            tableDocumentTracker = $("#tblDocumentTracker").DataTable({
                "columnDefs": [{ "targets": 4, "data": null, "defaultContent": "<button type='button' style='width: 100%' id='btnAddProgress' class='btn btn-alert'>Update Progress</button>" },
                {
                    "targets": [3],
                    "visible": false
                }],
                ajax: {
                    url: '@Url.Action("GetDocuments", "Misc")',
	                dataType: 'JSON',
                    dataSrc: function (data) {
                        var jsonResult = JSON.parse(data);
                        if (jsonResult.length != 0) {
                            LoadDocumentsDetails(jsonResult[0][0]); 
                            documentID = jsonResult[0][0];
                            docName = jsonResult[0][1];
                            return jsonResult;
                        } else { LoadDocumentsDetails(0);  return []; }
	                
	            },

	            error: function (e) { }
	        }
			, order: [[1, 'asc']], pageResize: true, ordering: true, lengthChange: false, ordering: false,
	        initComplete: function () { }
	    });
        return r;
    };


    function LoadDocumentsDetails(docID) {
        var r = $.Deferred();

        $('#tblDocumentTrackerDetails').DataTable().destroy();

        tableDocumentDetailsTracker = $("#tblDocumentTrackerDetails").DataTable({
            "columnDefs": [{ "targets": 6, "data": null, "defaultContent": "<button type='button' style='width: 100%' id='btnDocDetails' class='btn btn-link'>Modify</button>" },
                {
                   "targets": [0],
                   "visible": false
                }],
                ajax: {
                url: '@Url.Action("GetDocumentsDetails", "Misc")?documentID=' + docID,
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                    dataSrc: function (data) {

                        if (JSON.parse(data) != 0) {
                            return JSON.parse(data);
                        } else { return [];}
                 
                },

                error: function (e) { }
            }
			, order: [[1, 'asc']], pageResize: true, ordering: true, lengthChange: false, ordering: false,
            initComplete: function () { }
        });

        return r;
    };


    $('#tblDocumentTracker tbody').off().on('click', 'tr', function () {
        var data = tableDocumentTracker.row(this).data();

        docName = data[1];
        documentID = data[0];
        LoadDocumentsDetails(data[0]);
    })


    function NewDocument() {

        docName = "";
        documentID = 0;
        saveType = 2;
        URL = "../Misc/DocumentDetails";
        var detailView = new ModalM(URL, "Document Details");
        detailView.open();
    }


    $('#tblDocumentTracker tbody').on('click', '#btnAddProgress', function () {

        var tableDoc = $('#tblDocumentTracker').DataTable();
        var data = tableDoc.row($(this).parents('tr')).data();

        docName = data[1];
        documentID = data[0];
        saveType = 1;
        URL = "../Misc/DocumentDetails";
        var detailView = new ModalM(URL, "Document Details");
        detailView.open();


    })

    $('#tblDocumentTrackerDetails tbody').on('click', '#btnDocDetails', function () {

        var tableDocDetails = $('#tblDocumentTrackerDetails').DataTable();
        var data = tableDocDetails.row($(this).parents('tr')).data();

        detailsID = data[0];
        detailsFrom = data[1];
        detailsTO = data[2];
        detailsStatus = data[3];
        detailsDate = data[4];
        detailsDRemarks = data[5];
        saveType = 0;
        URL = "../Misc/DocumentDetails";
        var detailView = new ModalM(URL, "Document Details");
        detailView.open();


    })

</script>

<div>
     <div style="clear: both;"></div>
</div>
</section>
