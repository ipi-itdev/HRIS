<section class="content-header">
    <h1>OB Application</h1>
    <ol class="breadcrumb">
		<li><a href="javascript:void(0);" onclick="displayAttachment('../Uploads/UserManual/@{@ViewBag.mCode}.pdf');"><i class="fa fa-question-circle" title="Help?"></i>Help</a></li>
    </ol>
</section>
<section class="content">
    <div class="box box-primary">
		<div class="box-header">
			<div id="btnList_@ViewBag.FormID">
				<button type="button" class="btn btn-primary" id="Back_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Back"></i>  Back to List</button>
				<div style="float:right;">
				@if(@ViewBag.AllowApprove == true) {
					<div class="btn-group">
						<button class="btn btn-primary dropdown-toggle dropdown-icon" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						<i class="fa fa-cubes" title="Action"></i> Action
						</button>
						<div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
							<button type="button" class="dropdown-item btn btn-default" id="Approve_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-up" title="Approve"></i>  Approve</button> 
							<button type="button" class="dropdown-item btn btn-default" id="Disapprove_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-down" title="Disapprove"></i>  Disapprove</button>
							<button type="button" class="dropdown-item btn btn-default" id="BacktoRequestor_@ViewBag.FormID" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-edit" title="Back to Requestor"></i>  Back to Requestor</button>
						</div>
					</div>
				}
				</div>
			</div>
            <div class="box-body" id="@ViewBag.FormID">
				<div class="row">
					<div class="col-md-2">
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left"="">Employee Name: </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.EmployeeName" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left"="">Filed Date:  </label>
							<div class="col-lg-12 control-container vcenter">
								<input type="text" class="form-control" value="@ViewBag.DateFiled" disabled="disabled" style="background-color: rgb(238, 238, 238);">
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left"="">Client Account / Department:   </label>
							<div class="col-lg-12 control-container vcenter">
								<textarea rows="4" cols="45" style="resize:none" class="form-control" disabled="disabled" style="background-color: rgb(238, 238, 238);" >@ViewBag.Department</textarea>
							</div>
						</div>
						<div class="row form-group">
							<label class="col-lg-12 control-label style=" text-align:left"="">Remarks:   </label>
							<div class="col-lg-12 control-container vcenter">
								<textarea rows="4" cols="45" style="resize:none" class="form-control" disabled="disabled" style="background-color: rgb(238, 238, 238);">@ViewBag.Remarks</textarea>
							</div>
						</div>
					</div>
					<div class="col-md-10">
						<table id="tblList_@{@ViewBag.FormID}" class="table table-bordered table-striped">
							<thead id="tblHead_@{@ViewBag.FormID}">
								<tr class="notfilter" role="row">
									<th rowspan="1" colspan="1" width="1%">ID</th>
									<th rowspan="1" colspan="1" width="12%">Work Date</th>
									<th rowspan="1" colspan="1" width="20%">Start Time</th>
									<th rowspan="1" colspan="1" width="20%">End Time</th>
									<th rowspan="1" colspan="1" width="20%">Reason</th>
									<th rowspan="1" colspan="1" width="15%">Remarks</th>
								</tr>
							</thead>
						</table>
					</div>
				</div>
			</div>
        </div>
    </div>
</section>
<script>
$(document).ready(function () {
    var table_@{@ViewBag.FormID};
    table_@{@ViewBag.FormID} = $("#tblList_@{@ViewBag.FormID}").DataTable({
        ajax: {
			url: '@Url.Action("OBData", "TMS")',
			data: { pkey: '@ViewBag.pkey' },
			type: 'POST',
			datatype: 'application/json; charset=utf-8',
			dataSrc: function (data) { return JSON.parse(data); },
			error: function (e) { }
        }
        , order: [[1, 'asc']], "paging": false, "searching": false,       
        initComplete: function () { 
			if('@{@ViewBag.AllowApprove}' == "True"){
				$("#tblList_@{@ViewBag.FormID}").SetEditable({ columnsEd: "5", onEdit: function (columnsEd) { uinfo(columnsEd); }});
			}
		}
    });

    function uinfo(columnsEd)
    {
        var refno = columnsEd[0].childNodes[0].innerHTML;
        var remarks = columnsEd[0].childNodes[5].innerHTML;
        var Message = ''; var OkLabel = 'Update'; var fAction = null;
        Message = 'Are you sure you want to save the remarks?';
        fAction = function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    cache: false,
                    url: '../TMS/TMSApplicationRemarks?tmstype=4&pkey=' + refno + '&rmarks=' + remarks,
                    success: function (data) {
                        if (data == 'True') {Toast.Show("Remarks Successfully Added.");}
                        else { Toast.Error("Error"); }
                    }
                });
            }
        }
        BootstrapDialog.confirm({title: '@ViewBag.Caption',icon: 'fa-users',message: Message,closable: true,draggable: true,btnCancelLabel: 'Cancel',btnOKLabel: OkLabel,callback: fAction});
    }

	$('#btnList_@ViewBag.FormID').find('button').off('click').on('click', function() {
		var ids = $(this).attr('id'), Message = '', OkLabel = 'OK', fAction = null;
        switch ( ids.replace('@ViewBag.FormID-','').toUpperCase() ) {
           case 'Approve_@ViewBag.FormID'.toUpperCase():
                Message = 'Are you sure you want to approve this OB application?';
                OkLabel = 'Approve';
                fAction = function(result){
					if(result){
						$.ajax({
							type: "POST",
							cache: false,
							url: '../TMS/TMSApplicationApproval?tmstype=4&pkey=@ViewBag.pkey&status=40',
							success: function (data) {
								if (data == 'True') { Toast.Show("Successfully Approved.");  var URLView = '../ListView/ListIndex?mguid=@{@ViewBag.mguid}';   $('#content_@ViewBag.FormID').load(URLView, function () { }); }
								else { Toast.Error("Error"); }
							}
						});
					}
				}
                break;
			case 'Disapprove_@ViewBag.FormID'.toUpperCase():
                Message = 'Are you sure you want to disapprove this ob application?';
                OkLabel = 'Disapprove';
                fAction = function(result){
					if(result){
						URLVIEW = '../TMS/TMSApplicationApproval?tmstype=4&pkey=@ViewBag.pkey&status=8'
						var redURLView = '../ListView/ListIndex?mguid=@{@ViewBag.mguid}'; 
						var detailView = new modieremarks("Leave Application",URLVIEW,"Successfully Disapproved.","Disapproved failed. Please contact administrator.",'@ViewBag.FormID',redURLView);
						detailView.open();
					}
				}
                break;
			case 'BacktoRequestor_@ViewBag.FormID'.toUpperCase():
                Message = 'Are you sure you want to back this ob application to the requestor?';
                OkLabel = 'Ok';
                fAction = function(result){
					if(result){
						URLVIEW = '../TMS/TMSApplicationApproval?tmstype=4&pkey=@ViewBag.pkey&status=1'
						var redURLView = '../ListView/ListIndex?mguid=@{@ViewBag.mguid}'; 
						var detailView = new modieremarks("OB Application",URLVIEW,"Successfully Back to the Requestor.","Failed. Please contact administrator.",'@ViewBag.FormID',redURLView);
						detailView.open();
					}
				}
                break;
            case 'Back_@ViewBag.FormID'.toUpperCase():
				Message = 'Are you sure you want to go back to list?';
				OkLabel = 'Back to List';
                fAction = function(result){
					if(result){
						var URLView = '../ListView/ListIndex?mguid=@{@ViewBag.mguid}'; 
						$('#content_@ViewBag.FormID').load(URLView, function () { });
					}
				}
				break;
		}
		if(ids.toUpperCase() != 'dropdownMenuButton'.toUpperCase()){
			BootstrapDialog.confirm({
				title: '@ViewBag.Caption', icon: 'fa-list', message: Message, closable: true,
				btnCancelLabel: 'Cancel', btnOKLabel: OkLabel,
				callback: fAction
			});
		}
	})
})
$('.content-wrapper').waitMe('hide');
</script>

