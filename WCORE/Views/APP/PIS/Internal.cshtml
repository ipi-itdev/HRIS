<script>
    var pztudipi_int = null; var fxhdjipi_int = null ; var rawgeipi_int = null; var result_int = null; var IsNew_int = false; var HasNewDP_int = false;

    function show(input) {
        if (input.files && input.files[0]) { var filerdr = new FileReader(); filerdr.onload = function (e) { $('#empPhoto_Int').attr('src', e.target.result); }
            filerdr.readAsDataURL(input.files[0]);
        }
    }

    $(document).ready(function () {
        $('.content-wrapper').waitMe('hide');
        $("#empPhoto_Int").off("click").on("click" , function () { $("#file_int").trigger('click'); })
        functionOne().done(functionTwo()).done(functionThree());
        $('#tab>li>a').first().click();
        $('#empDP_ActiveEmployeeInternal').on('click', function (evt) { evt.stopPropagation(); });

        $("#InternalEmployee div.bhoechie-tab-menu>div.list-group>a").click(function (e) {
           
            e.preventDefault(); $(this).siblings('a.active').removeClass("active");
            $(this).addClass("active"); var index = $(this).index() - 1;
            console.log(index);
            $("#InternalEmployee div.bhoechie-tab>div.bhoechie-tab-content").removeClass("active");
            $("#InternalEmployee div.bhoechie-tab>div.bhoechie-tab-content").eq(index).addClass("active");
            
        });

        $(function () {
            $('#btnList_ActiveEmployeeInternal').find('button').on('click', function () {
                var ids = $(this).attr('id'); Message = ''; OkLabel = 'OK'; fAction = null; IsFired = false;
                switch (ids.replace('Internal-', '').toUpperCase()) {
                    case 'NEW_ActiveEmployeeInternal'.toUpperCase():
                        Message = 'Create new employee?';
                        OkLabel = 'New';
                        fAction = function (result_int) {
                                var URLView = '@Url.Action("Internal", "PIS")?mName=ActiveEmployeeInternal&pKey=-1';
                                $('#content_ActiveEmployeeInternal').load(URLView, function () { });
                        }
                        break;
                    case 'SAVE_ActiveEmployeeInternal'.toUpperCase():
                        Message = 'Save changes?'; OkLabel = 'Save';
                        fAction = function (result_int) {  if (Inetrnal_Validate() != false) { pztudipi_int.Save(); } }
                        break;
                    case 'DELETE_ActiveEmployeeInternal'.toUpperCase():
                        Message = 'Are you sure you want to delete?'; OkLabel = 'Delete';
                        fAction = function (result_int) {  pztudipi_int.Delete();  }
                        break;
                    case 'PRINT_ActiveEmployeeInternal'.toUpperCase():
                        URLVIEW = '@Url.Action("Index","ReportView")?pKey=@ViewBag.EmployeeID&cAction=ExportEmployeeProfile';
                        var detailView = new JIBModalList(URLVIEW);
                        detailView.open();
                        break;
                    case 'BACK_ActiveEmployeeInternal'.toUpperCase():
                        var URLView = '../ListView?ModelNo=10500';
                        $('#content_ActiveEmployeeInternal').load(URLView, function () { });
                }

                if (ids.replace('Internal-', '').toUpperCase() != 'BACK_ActiveEmployeeInternal'.toUpperCase() && ids.replace('Internal-', '').toUpperCase() != 'PRINT_ActiveEmployeeInternal'.toUpperCase()) {
                    BootstrapDialog.show({
                        title: 'Internal Employee (Active)',
                        icon: 'fa-circle-o',
                        message: Message,
                        closable: true,
                        draggable: true,
                        buttons: [{ id: 'btn-1', label: 'Cancel', cssClass: 'btn-warning', action: function (dialog) { dialog.close(); } },
                                  { id: 'btn-2', label: 'Ok', cssClass: 'btn-primary', action: function (dialog) { var $button = this; $button.disable(); $button.spin(); fAction(); dialog.close(); } }]
                    });
                }
            });
        });
        $("#Upload_ActiveEmployeeInternal").off("click").on("click", function () { $("#file_JD_EmploymentInfo_ActiveEmployeeInternal").trigger('click'); })
        $("#Download_ActiveEmployeeInternal").off("click").on("click", function () {
            if ($("#JobDescriptionPath_EmploymentInfoInternal").val()) { window.open('@Url.Action("Download", "ReportView")?fname=' + $("#JobDescriptionPath_EmploymentInfoInternal").val()) }
        })
    })

    function Inetrnal_Validate() {
        var objVal_int = JSON.parse(JSON.stringify(pztudipi_int));
        var objValEI_int = JSON.parse(JSON.stringify(fxhdjipi_int));
        var obj_int = $.extend({}, objVal_int, objValEI_int);
        var valid_int = true;
        $("#InternalEmployee .required").each(function () {
            var fname_int = $(this).attr('name').split("_");
            if (obj_int[fname_int[0]] == null || obj_int[fname_int[0]] == 0)
            { Toast.Error($(this).attr('title') + " is required."); valid_int = false; return false; }
        });
        return valid_int;
    }
    function functionOne() {
        var r = $.Deferred();
        pztudipi_int = {
            ID: null, EmployeeNumber: null, EmployeeRefNo: null, BiometricID: null, LastName: null, FirstName: null, MiddleName: null, Suffix: null, NickName: null, GenderRefNo: null, Birthdate: null, Age: null, BirthPlace: null, CivilStatusRefNo: 1, NationalityRefNo: 1, ReligionRefNo: 1, Height: null, Weight: null, BloodtypeRefNo: null, Allergies: null,
            PersonalEmailAddress: null, WorkEmailAddress: null, SocialMedia: null, TelephoneNumber: null, MobileNumber: null, MobileNumber2: null, CurrentAddress: null, ProvinceAddress: null, CityRefNo: null, EmergencyName1: null, EmergencyAddress1: null, EmergencyContactNo1: null, EmergencyRelationship1: null, EmergencyName2: null, EmergencyAddress2: null, EmergencyContactNo2: null, EmergencyRelationship2: null,
            TinNumber: null, PhilHealthNumber: null, SSSNumber: null, PagibigNumber: null, MalayanCoverageRefNo: null, MaxicareRefNo: null, MaxicareCardNo: null,
            CreatedBy: null, CreatedDate: null, ModifiedBy: null, ModifiedDate: null, IsActive: null, EmployeeDependents: [], EmployeeHighestEducation: [], OtherBenefits: [], EmployeeOffense: [], EmployeePerformance: [], EmployeeTraining: [], EmployeeAccountability: [], EmpHistoryInternal: []
            , IsDirty: false
                , Save: function (Grid) {
                        $.ajax({
                            url: '../DetailView/Save',
                            data: { mName: 'ActiveEmployeeInternal', JSONObject: JSON.stringify(pztudipi_int) },
                            type: 'POST',
                            datatype: 'application/json; charset=utf-8',
                            beforeSend: function () { },
                            success: function (data) {
                                result_int = eval("(function(){return " + data + ";})()");
                                pztudipi_int.ID = result_int.ID;
                                pztudipi_int.IsDirty = false;
                                if ('@ViewBag.AllowEmploymentInfo' == "True") { fxhdjipi_int.Save(); };
                            },
                            error: function (xhr, textStatus, error) {
                                console.log(error);
                            }
                        });
                }
        , Delete: function () {
            var item = [];
            item.push(pztudipi_int);
            $.ajax({
                url: '../DetailView/Delete',
                data: { mName: 'ActiveEmployeeInternal', JSONObject: JSON.stringify(item) },
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                beforeSend: function () { },
                success: function (data) {
                    if (data.error != undefined) {
                        alert(data.error);
                        return;
                    }
                    Toast.Show("Deleted");
                    URL = '../ListView?ModelNo=10500';
                    $('#content_ActiveEmployeeInternal').load(URL, function () { });
                },
                error: function (xhr, textStatus, error) {
                    console.log(error);
                }
            });
        }
        };
        function Employee_DetailView() {
            var self = $(this);
            this.IsEditOnly = false;
            var ObjectID = '@ViewBag.EmployeeID';
            console.log('ito ung employee id: ' + ObjectID);
            var dvFormat = [{Name: 'Details', Controls:[{ Name: 'ID', Type: 'Int', IsEnabled: false, ColumnNo: 0, TbName: 'Details', ControlID: 'ID' },
         { Name: 'EmployeeNumber', Caption: 'Employee Number', Type: 'String', IsEnabled: false, ColumnNo: 2, TbName: 'Details', ControlID: 'EmployeeNumber' },
         { Name: 'BiometricID', Caption: 'Biometric ID', Type: 'String', ColumnNo: 2, TbName: 'Details', ControlID: 'BiometricID' },
         { Name: 'LastName', Caption: 'Last Name', Type: 'String', IsRequired: true, ColumnNo: 0, TbName: 'Details', ControlID: 'LastName' },
