@using WCORE.Utility;
<section class="content-header">
    <h1>Employee :<b>@ViewBag.SubDescription</b></h1>
</section>
<section class="content" id="@ViewBag.mCode">
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
			<div class="box-header" id="btnList_@ViewBag.mCode">
				<div class="btn-group">
					@if (@ViewBag.AllowUpdate == true)
					{<button type="button" class="btn btn-primary" id="Save_@ViewBag.mCode" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-save" title="Save"></i>  Save</button>}
					<button type="button" class="btn btn-primary" id="Back_@ViewBag.mCode" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Back to List"></i>  Back to List</button>
				</div>
				<div style="float:right">
					@if (@ViewBag.AllowPrint == true && @ViewBag.pid > 0)
                    { <button type="button" class="btn btn-primary" id="Print_@ViewBag.mCode"><i class="fa fa-print" title="Print"></i>  Print Profile</button> }
                </div>
			</div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-12 bhoechie-tab-container">
						<div class="row">
							<div class="col-md-2 bhoechie-tab-menu">
								<div class="list-group">
									<div class="box-body box-profile">
										<img id="empPhoto_@{@ViewBag.mCode}" onclick="" class="profile-user-img img-responsive img-circle" src="@ViewBag.EmpImage" alt ="User profile picture">
										<input type="file" title="search image" id="fup_@{@ViewBag.mCode}" name="fup_@{@ViewBag.mCode}" accept="image/png, image/jpeg" onchange="show_@{@ViewBag.mCode}(this)" style="display:none;" />
									</div>
									<a href="#Details_Form_@ViewBag.mCode" data-toggle="tab" aria-expanded="true" class="list-group-item active text-center">Personal Information</a>
									@if (@ViewBag.AllowEmploymentInfo == true)
									{<a href="#Employment_Form_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Employment & Payroll Information</a>}
									@if (@ViewBag.AllowHighestEducation == true)
									{<a href="#HighestEducation_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Educational Attainment</a>}
									@if (@ViewBag.AllowDependents == true)
									{<a href="#Dependents_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Dependents</a>}
									@if (@ViewBag.AllowDisciplinaryAction == true)
									{<a href="#Offense_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Disciplinary Action</a>}
									@if (@ViewBag.AllowPerformanceEvaluation == true)
									{<a href="#Performance_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Performance Evaluation</a>}
									@if (@ViewBag.AllowTraining == true)
									{<a href="#Training_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Training</a>}
									@if (@ViewBag.AllowMovement == true)
									{<a href="#EmpHistory_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Movement</a>}
									@if (@ViewBag.AllowAccountability == true)
									{<a href="#Accountability_Lst_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Accountability</a>}
									@if (@ViewBag.AllowPreDocuments == true)
									{<a href="#Requirements_Form_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Pre-Employment Documents</a>}
									<a href="#Other_Form_@ViewBag.mCode" data-toggle="tab" class="list-group-item text-center">Other</a>
								</div>
							</div>
