<script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
<script>
    var count = 1;
    var recordID = [];
    var listRec = [];
    var listID = [];
    var kpilistid, ktldg, kpiyear;
    var valid = true;
    var updateType = 0;
    var saveType = 0;
    var table;
    var isForSAVE = true;

    function loadKPIList() {
        if ($.fn.DataTable.isDataTable('#KPIListMain')) {
            // DataTable is already initialized, destroy it
            $('#KPIListMain').DataTable().destroy();
        }

        var r = $.Deferred();

        table = $("#KPIListMain").DataTable({
            "columnDefs": [{ "targets": 3, "data": null, "defaultContent": "<button type='button' style='width: 100%' id='btnView' class='btn btn-primary'>View Details</button>" },
            {
                "targets": [2],
                "visible": false
            }],
            ajax: {
                url: '@Url.Action("GetPerformanceIndicatorList", "KPI")?IsForManager=' + @Session["UserRefNo"],
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) {
                    var jsonArray = JSON.parse(data);
                    listRec.length = 0;
                    listID.length = 0;
                    if (JSON.parse(data) == "") {
                        kpilistid = -1;
                        updateType = 1;
                        $('#ID_PerformanceIndicatorMain').val(kpilistid);
                        $('#Description_PerformanceIndicatorMain').val("N/A");
                        return JSON.parse(data);
                    } else {

                        for (var i = 0; i < jsonArray.length; i++) {
                            listID[i] = jsonArray[i][0];
                            listRec[i] = jsonArray[i][1];
                        }
                        kpilistid = jsonArray[0][0];

                        $('#ID_PerformanceIndicatorMain').val(kpilistid);
                        $('#Description_PerformanceIndicatorMain').val(jsonArray[0][1]);
                        return JSON.parse(data);
                    }
                },

                error: function (e) { }
            },
            order: [[1, 'asc']],
            pageResize: true,
            ordering: false,
            lengthChange: false,
            initComplete: function () { }
        });

        return r;
    };

    $(document).ready(function () {

        loadKPIList();

        var table = $('#KPIListMain').DataTable();
        $('#KPIListMain tbody').off().on('click', 'tr', function () {
            var data = table.row(this).data();
            kpilistid = data[0].toString();
            $('#ID_PerformanceIndicatorMain').val(data[0].toString());
            $('#Description_PerformanceIndicatorMain').val(data[1].toString());
            updateType = 0;
        });

        //---

        $('#KPIListMain tbody').on('click', '#btnView', function () {

            var data = table.row($(this).parents('tr')).data();
            kpilistid = data[0];
            categoryID = 5;
            //alert(data);
            URL = "../KPI/KPIList";
            var detailView = new KPIList(URL, data[1]);
            detailView.open()
        })
        $('.content-wrapper').waitMe('hide');
    });

    $('#KPIListNew').on('click', function () {

        updateType = 1;
        $('#ID_PerformanceIndicatorMain').val("-1");
        $('#Description_PerformanceIndicatorMain').val("N/A");
    });

    $('#KPIListSave').on('click', function () {

        if ($('#Description_PerformanceIndicatorMain').val() == "N/A" || $('#Description_PerformanceIndicatorMain').val() == "" || (!$('#Description_PerformanceIndicatorMain').val().replace(/\s/g, '').length) ||
            (!$('#Description_PerformanceIndicatorMain').val().replace(/\s/g, '').length)) {
            swal("Failed!", "Please fill-in all the required fields.", "info");
        } else {

            if (updateType == 1) {
                for (var i = 0; i < listRec.length; i++) {

                    var str = $('#Description_PerformanceIndicatorMain').val();
                    str = str.trim();

                    var listString = listRec[i];
                    listString = listString.trim();

                    if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
                        isForSAVE = false;
                        break;
                    }
                }
            } else if (updateType == 0) {
                for (var i = 0; i < listRec.length; i++) {

                    var str = $('#Description_PerformanceIndicatorMain').val();
                    str = str.trim();

                    var listString = listRec[i];
                    listString = listString.trim();

                    if (str.toString().toUpperCase() == listString.toString().toUpperCase()) {
                        if ($('#ID_PerformanceIndicatorMain').val() == listID[i]) {
                            isForSAVE = true;
                            break;
                        } else {
                            isForSAVE = false;
                            break;
                        }
                    }
                }
            }


            if (isForSAVE == false) {
                Toast.Error("Duplicate Entry.");
                isForSAVE = true;
            } else if (isForSAVE == true) {

                $.ajax({
                    type: "POST",
                    cache: false,
                    url: '../KPIView/UpdatingPerformanceIndicatorList?updateType=' + updateType + '&performanceIndicatorID=' + $('#ID_PerformanceIndicatorMain').val() + '&perfDesc=' + $('#Description_PerformanceIndicatorMain').val() + '&IsForManager=' + 0 + '&scoreCardID=' + 5,
                    success: function (data) {

                        if (data == 'True') {
                            $('#KPIListMain').DataTable().ajax.reload();
                            Toast.Show("KPI List successfully updated.");
                            updateType = 0;
                        }
                        else { Toast.Show("Something went wrong.") }
                    }
                })
            }

        }
    });

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which != 46 || $(this).val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
            return false;
        } else { return true; }
    }

    function handleButtonClick(element) {
        var e = element;
        e.disabled = true;
        setTimeout(function () {
            e.disabled = false;
        }, 10000);
        return true;
    }
</script>

<div>
    <div style="clear:both;"></div>
</div>
