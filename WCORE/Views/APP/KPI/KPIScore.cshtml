<section class="content" style="position:center">
<div class="row">
   <div class="col-xs-12">
	   <div class="box box-primary">    
			<div class="table-wrapper">
			
				@*    <div class="table-title">
					   </div>
					  *@
						<table class="table table-bordered" id="tablePARTONE">
							<thead>
								<tr>
									<th rowspan="1" colspan="1" style="width:20%; font-size: 13px;" data-field="id">ID</th>
								    <th rowspan="1" colspan="1" style="width:50%; font-size: 13px" data-field="kpi">KPI</th>
									<th rowspan="1" colspan="1" style="width:30%; font-size: 13px" data-field="target">TARGET</th>
									<th rowspan="1" colspan="1" style="width:30%; font-size: 13px" data-field="actual">ACTUAL</th>
									<th rowspan="1" colspan="1" style="width:35%; font-size: 13px" data-field="accomplished">ACCOMPLISHED</th>
									<th rowspan="1" colspan="1" style="width:20%; font-size: 13px" data-field="rating">RATING</th>
									<th rowspan="1" colspan="1" style="width:20%; font-size: 13px" data-field="weight">WEIGHT</th>
									<th rowspan="1" colspan="1" style="width:20%; font-size: 13px" data-field="score">SCORE</th>             
								    <th rowspan="1" colspan="1" style="width:50%; font-size: 13px" data-field="remarks">REMARKS</th>
									<th style="font-size: 13px"> ACTION</th>
								</tr>
							</thead>
							<tbody>				   
							</tbody>
						</table>
			</div>
