<div class="modal fade" id="myModal12" tabindex="-1" role="dialog" aria-labelledby="myModal2Label" aria-hidden="true" data-backdrop="false">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
          <h4 class="modal-title" id="myModal2Label"> <b>Select from the list</b></h4>
        </div>
        <div class="modal-body">
              <table id="tableList" class="table table-bordered table-striped table-hover tblList", >
                           <thead>
                              <tr>
                                @* <th><input name="select_all" value="1" id="example-select-all" type="checkbox" /></th>*@
                                 <th></th>
                                 <th style="width:100px">ID</th>
                                 <th style="width:200px">EMPLOYEE #</th>
                                 <th style="width:500px">EMPLOYEE NAME</th>
                                 <th style="width:200px">JOB TITLE</th>
                                 <th style="width:100px">JOB GRADE</th>
                              </tr>
                           </thead>
                           <tfoot>
                            
                           </tfoot>
                        </table>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" id="addSelected">Add Selected</button>
        </div>
      </div>
      <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
  </div>

<script>
    var recordID = [];
    var table1, table2;
  
    $(document).ready(function () {
    table1 = $('#example').DataTable({
            'columnDefs': [{
                'targets': [0],
                'className': 'dt-body-center',
                'render': function (data, type, full, meta) {
                    if (data == "1") {
                        return '<input type="checkbox" name="id[]" value="1" checked>';
                    } else {
                        return '<input type="checkbox" name="id[]" value="0">';
                    }
                }
            }],
            'order': [1, 'asc'], ordering: false, info: false, paging: false, searching: false,
            ajax: {
                url: '@Url.Action("GetAssignedEmployeeSelected", "KPI")?kpiAssignmentRefNo=' + "",
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) { return JSON.parse(data); },
                error: function (e) { }
            }
        });
    });

    $('#btnUpdate').on('click', function () {
        recordID.length = 0;
        var values = "";
        var selector = '#example tr input:checked';
        $.each($(selector), function (idx, val) {
            var id = $(this).parent().siblings(":first").text();
            recordID.push(id);
        });

        if (recordID && recordID.length) {
            values = JSON.stringify(recordID.toString());
        } else {values="000";}
        //---
            $.ajax({
                type: "POST",
                cache: false,
                url: '../KPI/UpdateKPIAssignedTo?id=' + values + '&updateType=' + 1,
                success: function (data) {
                    if (data == 'True') {
                        swal("Success!", "List of employee(s) updated.", "success");
                        $('#example').DataTable().ajax.reload();
                    }
                    else { Toast.Show("Something went wrong.") }
                }
            })
    });


    //--
    $('#btnAdd').on('click', function () {
     table2 = $('#tableList').DataTable({
            'columnDefs': [{
                'targets': 0,
                'className': 'dt-body-center',
                'render': function (data, type, full, meta) {
                    if (data == "1") {
                        return '<input type="checkbox" name="id[]" value="1" checked>';
                    } else {
                        return '<input type="checkbox" name="id[]" value="0">';
                    }
                }
            }],
            'order': [1, 'asc'], ordering: false, info: false, paging: false, searching: false,
            ajax: {
                url: '@Url.Action("GetAssignedEmployeeUnSelected", "KPI")',
                type: 'POST',
                datatype: 'application/json; charset=utf-8',
                dataSrc: function (data) { return JSON.parse(data); },
                error: function (e) { }
            }, "bDestroy": true
        });

       
    });

    //---
    $('#addSelected').on('click', function () {

        recordID.length = 0;
        var selector = '#tableList tr input:checked';
        $.each($(selector), function (idx, val) {
            var id = $(this).parent().siblings(":first").text();
            recordID.push(id);
        });

        //---

        if (recordID && recordID.length) {
            $.ajax({
                type: "POST",
                cache: false,
                url: '../KPI/UpdateKPIAssignedTo?id=' + JSON.stringify(recordID.toString()) + '&updateType=' + 0,
                success: function (data) {
                    if (data == 'True') {
                        swal("Success!", "List of employee(s) updated.", "success");
                        $('#tableList').DataTable().ajax.reload();

                        //-----
                    }
                    else { Toast.Show("Something went wrong.") }
                }
            }) 
        } else {

            swal("Failed","There is no selected employee.", "info");
        }

        $('#tableList').DataTable().ajax.reload();
        $('#example').DataTable().ajax.reload();
    });


    function setModalMaxHeight(element) {
        this.$element = $(element);
        this.$content = this.$element.find('.modal-content');
        var borderWidth = this.$content.outerHeight() - this.$content.innerHeight();
        var dialogMargin = $(window).width() < 768 ? 20 : 60;
        var contentHeight = $(window).height() - (dialogMargin + borderWidth);
        var headerHeight = this.$element.find('.modal-header').outerHeight() || 0;
        var footerHeight = this.$element.find('.modal-footer').outerHeight() || 0;
        var maxHeight = contentHeight - (headerHeight + footerHeight);

        this.$content.css({
            'overflow': 'hidden'
        });

        this.$element
          .find('.modal-body').css({
              'max-height': maxHeight,
              'overflow-y': 'auto'
          });
    }

    $('.modal').on('show.bs.modal', function () {
        $(this).show();
        setModalMaxHeight(this);
    });

    $(window).resize(function () {
        if ($('.modal.in').length == 1) {
            setModalMaxHeight($('.modal.in'));
        }
    });

    /* CodeMirror */
    $('.code').each(function () {
        var $this = $(this),
            $code = $this.text(),
            $mode = $this.data('language');

        $this.empty();
        $this.addClass('cm-s-bootstrap');
        CodeMirror.runMode($code, $mode, this);
    });

</script>
