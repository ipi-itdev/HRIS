        input:disabled + label {
            background: #efefef;
            color: rgba(0, 0, 0, 0.5);
            cursor: not-allowed;
        }

            input:disabled + label:hover {
                border-color: rgba(0, 0, 0, 0.1);
            }

            input:disabled + label:before {
