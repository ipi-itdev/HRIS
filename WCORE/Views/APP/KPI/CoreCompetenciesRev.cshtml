<script src="~/Contents/js/KPI/KPISpecialAssignment.js"></script>
<script src="~/Contents/js/KPI/KPISummaryReport.js"></script>
<script>

    isReady = 0;
    isConfirmed = 0;
    var currentSelected = 0;
    var coreCompetencyID = [];
    var coreCompetencies = [];
    var coreCompetencySetCount = [];
    var coreCompetencySeqCount = [];

    var noOfItems = 0;
    var storedChoice = [];
    var storedCoreRefNo = [];
    var storedDetailsRefNo = [];
    var storedSetNo = [];
    var storedForGM = [];

    var coreCompetencyDetailsID = [];
    var coreCompetencyDetails = [];
    var coreIndex = 0;
    var coreCount;
    var setNo = 1;
    var setCount = 0;
    var interval = 0;
    var index = 0;
    var resetFormat = 1;

    var kpiScore = 0;
    var hasScore = 0;

    $(document).ready(function ()
    {
        storedChoice.length = 0;
        storedCoreRefNo.length = 0;
        storedDetailsRefNo.length = 0;
        storedSetNo.length = 0;
        storedForGM.length = 0;
        //loadCoreCompentency().done(loadCoreDetails()).done(KPIScoreResult()).done(CoreResult()).done(loadChoices());
        loadCoreCompentency();
    });

    function loadCoreCompentency() {
        var sr = $.Deferred();
        jQuery.ajax({
            url: '@Url.Action("GetCoreCompetency", "KPI")',
            method: 'GET',
            datatype: 'application/json; charset=utf-8',
            success: function (data) {
                var jsonCore = JSON.parse(data);
                if (jsonCore.length == 0) return false;
                for (var i = 0; i < jsonCore.length; i++) {
                    coreCompetencyID[i] = jsonCore[i][0];
                    coreCompetencies[i] = jsonCore[i][1];
                    coreCompetencySetCount = [i][3];
                    coreCompetencySeqCount = [i][4];

                    console.log('core competencies: ' + coreCompetencies[i]);

                    setCount = jsonCore[0][3];
                    interval = jsonCore[0][4];
                    coreCount++;

                }
                loadCoreDetails();
            },
            error: function (e) {
            }
        });

        return sr;

        
    }

    function loadCoreDetails() {
        //var rs = $.Deferred();
        coreCompetencyDetails.length = 0;

        jQuery.ajax({
            url: '@Url.Action("GetCoreCompetencyDetails", "KPI")',
            type: 'POST',
            datatype: 'application/json; charset=utf-8',
            success: function (data) {
                var jsonArray = JSON.parse(data);
                if (jsonArray.length == 0) return false;
                for (var i = 0; i < jsonArray.length; i++) {
                    coreCompetencyDetailsID[i] = jsonArray[i][0];
                    coreCompetencyDetails [i] = jsonArray[i][2];
                }
                KPIScoreResult();
            },
            error: function (e) {
            }
        });

        //return rs;
      
    }

     function KPIScoreResult() {
     //var rss = $.Deferred();
     jQuery.ajax({
         url: '@Url.Action("GetKPIScoreResult", "KPI")?KPIAssignmentDetailsRefNo=' + kpiAssignmentID,
         type: 'POST',
         datatype: 'application/json; charset=utf-8',
         success: function (data) {
             var jsonArray = JSON.parse(data);
             kpiScore = jsonArray[0][0];
             if (jsonArray[1][0] != undefined) {

                 hasScore = jsonArray[1][0];
             } else {
                 hasScore = 0;
             }
             CoreResult();
         },
         error: function (e) {
         }
     });

         //return rss;
         
    }

     function CoreResult() {
         //var d = $.Deferred();
         jQuery.ajax({
             url: '@Url.Action("GETCoreResult", "KPI")?kpiAssignmentDetailsID=' + kpiAssignmentID,
             type: 'POST',
             datatype: 'application/json; charset=utf-8',
             success: function (data) {
                 var jsonArray = JSON.parse(data);
                 storedChoice.length = 0;
                 storedCoreRefNo.length = 0;
                 storedDetailsRefNo.length = 0;
                 storedSetNo.length = 0;
                 for (var i = 0; i < jsonArray.length; i++) {

                     storedChoice[i] = jsonArray[i][0];
                     storedCoreRefNo[i] = jsonArray[i][1];
                     storedDetailsRefNo[i] = jsonArray[i][2];
                     storedSetNo[i] = jsonArray[i][3];
                     storedForGM[i] = jsonArray[i][4];
                 }
                 loadChoices();
             },
             error: function (e) {
             }
         });

         //return d;
         
     }

    function loadChoices() {
        //var y = $.Deferred();
        console.log('value ng setNo: ' + setNo);
        console.log('value ng setCount: ' + setCount);
        

        if (setNo <= setCount) {
            $("#collapseHeader").text(coreCompetencies[coreIndex] + " [ " + (noOfItems + 1) + " OF 15 ]");
            setNo++;
            resetFormat = 0;
        } else {
            setNo = 2;
            coreIndex++;
            $("#collapseHeader").text(coreCompetencies[coreIndex] + " [ " + (noOfItems + 1) + " OF 15 ]");
            resetFormat = 1;
        }

        console.log('value ng hasScore: ' + hasScore);

        if (hasScore > 0) {
            for (var rec = 1; rec <= interval; rec++) {
                if (storedChoice[noOfItems] == rec) {
                    $('#choice' + rec).prop('checked', true);
                    currentSelected = storedChoice[noOfItems - 1];
                    break;
                }
            }
        }

        // ----
       
        console.log('value ng currentSelected: ' + currentSelected);
        console.log('value ng resetFormat: ' + resetFormat);

        index = index + interval;

        console.log('value ng index: ' + index);
        console.log('value ng interval: ' + interval);
        console.log('value ng coreCompetencyDetails[0]: ' + coreCompetencyDetails[index - 4]);

        if (currentSelected > 0 && resetFormat == 0) {

            if (currentSelected == 1) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice3").css('background', '#d2d2d2')
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
                $("#labelChoice4").css('background', '#d2d2d2')
            } else if (currentSelected == 2) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
                $("#labelChoice4").css('background', '#d2d2d2')
            } else if (currentSelected == 3) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice1").css('background', '#d2d2d2')
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
            } else if (currentSelected == 4) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice1").css('background', '#d2d2d2')
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice2").css('background', '#d2d2d2')
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
            }
        } else {
            console.log('dito dumadaan kapag wala pang napili');
            $("#labelChoice1").html(coreCompetencyDetails[index - 4]);
            $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
            $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
            $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
        }

        // -----
        if (kpiScore > 3.5) {
            $('#choice' + 1).prop('disabled', true);
        } else {
            $('#choice' + 1).prop('disabled', false);
        }

        //return y;
    }


    function ReloadChoice() {
        
        //var y = $.Deferred();

      $("#collapseHeader").text(coreCompetencies[coreIndex] + " [ " + (noOfItems + 1) + " OF 15 ]");

        if (hasScore > 0) {

            for (var rec = 1; rec <= interval; rec++) {
                if (storedChoice[noOfItems] == rec) {
                    $('#choice' + rec).prop('checked', true);
                    currentSelected = rec;
                    break;
                }
            }
        }

        // ----
        index = index + interval;

        if (currentSelected > 0) {

            if (currentSelected == 1) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice3").css('background', '#d2d2d2')
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
                $("#labelChoice4").css('background', '#d2d2d2')
            } else if (currentSelected == 2) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
                $("#labelChoice4").css('background', '#d2d2d2')
            } else if (currentSelected == 3) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice1").css('background', '#d2d2d2')
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
            } else if (currentSelected == 4) {
                $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
                $("#labelChoice1").css('background', '#d2d2d2')
                $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
                $("#labelChoice2").css('background', '#d2d2d2')
                $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
                $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
            }
        } else {
            $("#labelChoice1").text(coreCompetencyDetails[index - 4]);
            $("#labelChoice2").text(coreCompetencyDetails[index - 3]);
            $("#labelChoice3").text(coreCompetencyDetails[index - 2]);
            $("#labelChoice4").text(coreCompetencyDetails[index - 1]);
        }

        // -----
        if (kpiScore > 3.5) {
            $('#choice' + 1).prop('disabled', true);
        } else {
            $('#choice' + 1).prop('disabled', false);
        }

        /*return y;*/
    }



    function saveChoice(choice) {

        //alert("current : " + currentSelected + " reset format : " + resetFormat);
        if (currentSelected == 0 && resetFormat == 0) {
            storedForGM[noOfItems] = 0;
            resetFormat = 0;
        } else if (currentSelected > 0 && resetFormat == 1) {
            storedForGM[noOfItems] = 0;
            resetFormat = 0;
        } else if (currentSelected > 0 && resetFormat == 0) {
            if (choice == currentSelected || choice == (currentSelected - 1) || choice == (currentSelected + 1)) {
                storedForGM[noOfItems] = 0;
            } else {
                storedForGM[noOfItems] = 1;
            }
        }

        storedCoreRefNo[noOfItems] = coreIndex + 1;
        storedSetNo[noOfItems] = setNo - 1;
        storedChoice[noOfItems] = choice;
        currentSelected = choice;
        if (choice == 1) {
            storedDetailsRefNo[noOfItems] = coreCompetencyDetailsID[index - 4];
        } else if (choice == 2) {
            storedDetailsRefNo[noOfItems] = coreCompetencyDetailsID[index - 3];
        } else if (choice == 3) {
            storedDetailsRefNo[noOfItems] = coreCompetencyDetailsID[index - 2];
        } else if (choice == 4) {
            storedDetailsRefNo[noOfItems] = coreCompetencyDetailsID[index - 1];
        }
    }

    window.BackChoices = function () {
        //var srr = $.Deferred();

        $("#labelChoice1").css('background', '#ffffff')
        $("#labelChoice2").css('background', '#ffffff')
        $("#labelChoice3").css('background', '#ffffff')
        $("#labelChoice4").css('background', '#ffffff')
        if (noOfItems > 0) {

            if (coreIndex > 0) {
                if (setNo > 2) {
                    setNo = setNo - 1;
                } else {
                    setNo = 4;
                    coreIndex--;
                }
            } else {
                setNo = 2;
                coreIndex = 0;
                resetFormat = 0;

            }

            if (index > 4) {
                noOfItems--;
                index = index - (interval * 2);
                ReloadChoice();
            }
        }
        //return srr;
    }

    window.NextChoices = function () {
        //var sss = $.Deferred();
        if (noOfItems < 14) {

            if ((($("#choice1").prop('checked') && ($("#choice1").prop('disabled') == false)) || ($("#choice2").prop('checked') && ($("#choice2").prop('disabled') == false)) || ($("#choice3").prop('checked') && ($("#choice3").prop('disabled') == false))
                || ($("#choice4").prop('checked') && ($("#choice4").prop('disabled') == false))))
            {
                noOfItems++;

                if (kpiScore > 3.5) {
                    $('#choice' + 1).prop('disabled', true);
                } else {
                    $('#choice' + 1).prop('disabled', false);
                }

                $('#choice1').prop('checked', false);
                $('#choice2').prop('checked', false);
                $('#choice3').prop('checked', false);
                $('#choice4').prop('checked', false);

                $("#labelChoice1").css('background', '#ffffff')
                $("#labelChoice2").css('background', '#ffffff')
                $("#labelChoice3").css('background', '#ffffff')
                $("#labelChoice4").css('background', '#ffffff')


                loadChoices();

            } else {

                swal("Unable to proceed..", "You haven't selected one yet.", "info");
            }

        } else {

            if ((($("#choice1").prop('checked') && ($("#choice1").prop('disabled') == false)) || ($("#choice2").prop('checked') && ($("#choice2").prop('disabled') == false)) || ($("#choice3").prop('checked') && ($("#choice3").prop('disabled') == false))
                || ($("#choice4").prop('checked') && ($("#choice4").prop('disabled') == false))))
            {
                isReady = 1;

            } else {

                swal("Unable to proceed..", "You haven't selected one yet.", "info");
           }
        }

        //return sss;
    };

    window.getScores = function (action) {
        //var swq = $.Deferred();

                //waitingDialog.show("Consolidating scores (15 OF 15)...");

                $.ajax({
                    type: "POST",
                    cache: false,
                    url: '../KPI/RecordScores?actionType=' + action + '&KPIAssignmentDetailsRefNo=' + kpiAssignmentID +
                        '&coreRefNo=' + JSON.stringify(storedCoreRefNo) + '&coreDetailsRefNo=' + JSON.stringify(storedDetailsRefNo) + '&setNo=' + JSON.stringify(storedSetNo) + '&choiceID=' + JSON.stringify(storedChoice),
                    success: function (data) {
                        if (data == 'True') {
                            $('#tblList_EVALUATE').DataTable().ajax.reload();
                        }
                        else { status = 0; }
                    }
                });

                if (action == 2) { // HR MANAGER
                    URL = "../KPI/SpecialAssignment";
                    var detailView = new KPISpecialAssignment(URL, employeeInfo, "DONE");
                    detailView.open();
                }
                else if (action == 1) {
                    URL = "../KPI/SpecialAssignment";
                    var detailView = new KPISpecialAssignment(URL, employeeInfo, "FINISH");
                    detailView.open();
                }

            //setTimeout(function () { waitingDialog.hide(); }, 2000);
                //return swq;
    };

</script>
