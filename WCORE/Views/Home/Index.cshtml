@{ Layout = "~/Views/_Layout.cshtml"; }
<script src='https://www.google.com/recaptcha/api.js' async defer></script>
<div class="bg"></div>
<div class="bg bg2"></div>
<div class="bg bg3"></div>
<div class="login" ng-controller="LoginController">
<div class="login-box">
    <div class="login-box-body">
        <div class="login-logo"></div>
        <br />
        <div class="form-group has-icon">
            <input type="text" name="UserName" ng-model="User.Username" class="form-control" placeholder="Username" required>
            <span class="fa fa-user form-icon-feedback"></span>
        </div>
        <div class="form-group has-icon">
            <input type="password" ng-model="User.Password" name="Password" class="form-control" placeholder="Password" required>
            <span class="fa fa-lock form-icon-feedback"></span>
        </div>
        <div class="text-center">
            <div style="display: inline-block;">
                <div class="g-recaptcha" data-sitekey="6Lf1r6UZAAAAAH2MV58lJAswvRYo0fDiMeVIdjaj"></div>
				<br />
            </div>
        </div>
        <div class="box-header">
            <div class="box-title">
                <a href="#" ng-click="fpassword()">Forgot/Change Password?</a>
            </div>
            <div class="box-tools pull-right">
				<input class="btn btn-secondary" type="button" value="Login" ng-click="login()" id="btnlogin" />
            </div>
        </div> 
    </div>
</div>
</div>
