    $("#mFrm53").off("change", "#EmployeeRefNo_PARExternalRequest").on("change", "#EmployeeRefNo_PARExternalRequest", function () {

        //alert('noel');
        $("#10690_ListView_53_Table tbody")
            .empty()
            .append('<tr><td colspan="100%" class="text-center">No data available</td></tr>');

        var employeerefno_par = $('#EmployeeRefNo_PARExternalRequest').val();

        $.ajax({
         type: "POST",
         cache: false,
            url: '@Url.Action("GetEmployeeMovement2", "PAR")?pkey=' + employeerefno_par,
            success: function (data) {

                var table = $("#10690_ListView_53_Table").DataTable();

                table.clear();

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }

                if (!data || data.length === 0) {
                    table.draw();
                    return;
                }

                $.each(data, function (i, item) {
                    table.row.add(item);
                });

                table.draw();

            }
        })

    });

    $("#mFrm53").off("change", "#EndDate_PARExternalRequest").on("change", "#EndDate_PARExternalRequest", function () {
