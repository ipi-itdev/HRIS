@using WCORE.Utility;
<div id="content_@ViewBag.FormID" class="module-wrapper ng-scope">
    <section class="content-header">
        <h1>@ViewBag.Description <i style="font-size:13px">  (@ViewBag.Description)</i></h1>
        <ol class="breadcrumb">
            <li><a href="javascript:void(0);" onclick="displayAttachment('../Uploads/UserManual/@{@ViewBag.mCode}.pdf');"><i class="fa fa-question-circle" title="Help?"></i>Help</a></li>
        </ol>
    </section>
    <section class="content" id="@ViewBag.FormID">
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header" id="btnList_@{@ViewBag.FormID}">
                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" id="Back_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-sign-in" title="Open"></i>  Back to List</button>
                            @if ((@ViewBag.AllowInsert == true && @ViewBag.pid <= 0) || (@ViewBag.AllowUpdate == true && @ViewBag.pid > 0))
                            {<button type="button" class="btn btn-primary" id="Save_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-save" title="Save"></i>  Save @ViewBag.Description</button>}
                            @if (@ViewBag.AllowDelete == true && @ViewBag.pid > 0)
                            {<button type="button" class="btn btn-primary" id="Delete_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-trash-o" title="Delete"></i>  Delete @ViewBag.Description</button>}
                        @*For Request Button*@
                            @if (@ViewBag.AllowApprove == true && @ViewBag.pid > 0 && ((ViewBag.CurrentUser == ViewBag.userrefno && ViewBag.ApprovalLevel == "0") || (ViewBag.ApprovalLevel == "1" && (ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52" || ViewBag.userrolesrefno == "53")) || (ViewBag.ApprovalLevel == "2" && (ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52")) || (ViewBag.ApprovalLevel == "3" && (ViewBag.userrolesrefno == "52" || ViewBag.userrolesrefno == "51"))) || (ViewBag.ApprovalLevel == "4" && (ViewBag.userrolesrefno == "51")))
                            {<button type="button" class="btn btn-primary" id="Approve_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-up" title="Approve"></i>  @ViewBag.UserAction</button>}
                        @*For Approve Button (MLO)*@
                            @if (((ViewBag.userrolesrefno == "55" && ViewBag.ApprovalLevel == "2")))
                            {<button type="button" class="btn btn-primary" id="Approve_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-up" title="Approve"></i>  @ViewBag.UserAction</button>
                            <button type="button" class="btn btn-primary" id="Disapprove_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-down" title="Disapprove"></i>  Disapprove</button>}
                        @*For Disapprove Button*@
                            @if (((ViewBag.userrolesrefno == "51" && ViewBag.ApprovalLevel == "0") || ((ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52" || ViewBag.userrolesrefno == "53") && ViewBag.ApprovalLevel == "1") || ((ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52") && ViewBag.ApprovalLevel == "2") || ((ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52") && ViewBag.ApprovalLevel == "3")))
                            {<button type="button" class="btn btn-primary" id="Disapprove_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-o-down" title="Disapprove"></i>  Disapprove</button>}
                            @*For Proceed Button - Target Setting*@
                            @if (ViewBag.mNo2 == "1097")
                            {
                                <button type="button" class="btn btn-primary" id="Proceed_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-up" title="Proceed"></i>  Proceed</button>
                            }

                            @if (ViewBag.mNo2 == "53" && (ViewBag.userrolesrefno == "51" || ViewBag.userrolesrefno == "52"))
                            {
                                <button type="button" class="btn btn-primary" id="Printed_@{@ViewBag.FormID}" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-thumbs-up" title="Printed"></i>  Printed</button>
                            }
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="row">
                            @*<div class="col-md-4">
                                    <div class="form-group" id ="Details_@{@ViewBag.FormID}_dtlv"></div>
                                    <div style="clear:both;"></div>
                                </div>*@
                            <div class="col-md-12">
                                <div class="nav-tabs-custom">
                                    <ul class="nav nav-tabs" id="tab_@{@ViewBag.FormID}" role="tablist">
                                        @foreach (var tab in ViewBag.Tabs)
                                        {
                                            if (@tab.IsListView == true)
                                            {
                                                <li class="nav-item"><a href="#@{@tab.Name}_List_@{@ViewBag.FormID}" class="nav-link" data-toggle="tab" role="tab">@tab.Desc</a></li>
 }
                                            else
                                            {
                                                <li class="nav-item"><a href="#@{@tab.Name}_Form_@{@ViewBag.FormID}" class="nav-link" data-toggle="tab" role="tab">@tab.Desc</a></li>
}
                                        }
                                    </ul>
                                    <div class="tab-content">
                                        @foreach (var tabpane in ViewBag.Tabs)
                                        {
                                            if (@tabpane.IsListView == true)
                                            {<div class="tab-pane" id="@{@tabpane.Name}_List_@{@ViewBag.FormID}" role="tabpanel"></div> }
                                            else
                                            {
                                                <div class="tab-pane" id="@{@tabpane.Name}_Form_@{@ViewBag.FormID}" role="tabpanel">
                                                    <div class="col-md-8">
                                                        <div class="form-group" id="@{@tabpane.Name}_@{@ViewBag.FormID}_dtlv"></div>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <div class="form-group" id="@{@tabpane.Name}_@{@ViewBag.FormID}_dtlv2"></div>
                                                    </div>
                                                    <div style="clear:both;"></div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
