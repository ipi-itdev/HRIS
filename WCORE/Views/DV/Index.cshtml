    $("#mFrm56").off("select2:select", "#EmployeeRefNo_PARInternalRequest").on("select2:select", "#EmployeeRefNo_PARInternalRequest", function () {
        var employeerefno = $('#EmployeeRefNo_PARInternalRequest').val();
        //console.log(employeerefno);
        $.ajax({
            type: "POST",
            cache: false,
            url: '@Url.Action("CheckDuplicatePAR","PAR")?empno=' + employeerefno,
            success: function (data) {
                var jsonArray = JSON.parse(data);
                if (jsonArray.length == 0 && employeerefno > 0) {
                    $.getJSON(uri + '?empid=' + employeerefno + '&pkey=@ViewBag.pid')
                    .done(function (data) {
                        $('#FOWRefNo_PARInternalRequest').val(data.FowRefNo).trigger("select2:select");
                        $('#EmployeeTypeRefNo_PARInternalRequest').val(data.EmployeeTypeRefNo).trigger("select2:select");
                        $('#EmploymentStatusRefNo_PARInternalRequest').val(data.EmploymentStatusRefNo).trigger("select2:select");
