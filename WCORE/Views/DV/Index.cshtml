                document.getElementById('Disapprove_mFrm56').style.display = "none";

            } else {
                document.getElementById('Delete_mFrm53').style.display = "none";
                document.getElementById('Save_mFrm53').style.display = "none";
            }

            // For Review
        } else if (approvallevel == 1 && (userroles == 52 && useraction == "Review")) {
            if (@ViewBag.mNo == 56) {
                // document.getElementById('Delete_mFrm56').style.display = "none";
                 document.getElementById('Save_mFrm56').style.display = "none";
                // document.getElementById('Disapprove_mFrm56').style.display = "none";

             } else {
                 //document.getElementById('Delete_mFrm53').style.display = "none";
