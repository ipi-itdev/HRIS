@using WCORE.Utility;
<section class="content-header">
      <h1>@ViewBag.Description <i style="font-size:13px">  @ViewBag.SubDescription</i></h1>
      <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
        <li class="active">@ViewBag.Description</li>
      </ol>
</section>
<section class="content" style="position:absolute">
<div class="row">
   <div class="col-xs-12">
       <div class="box box-primary">
            <div class="box-body" id="@ViewBag.ViewId">
              <table id="tblList_@ViewBag.ViewId" class="table table-bordered table-striped table-hover tblList table-responsive" style="font-size:13px; width:100%;">
                <thead id="tblHead">
                <tr class="notfilter">
                    @{ foreach (Header hdr in ViewBag.Header)
                       { <th width="@hdr.ColumnWidth" style="text-align:@hdr.Alignment;  " class="wfilter">@hdr.Caption</th> }
                        if (ViewBag.wPopUp == true || ViewBag.wPopUp2 == true)
                       {<th class="lbtn"></th>} 
                     }
                </tr>
                <tr class="filters">
                    @{ foreach (Header hdr in ViewBag.Header)
                       { <th width="@hdr.ColumnWidth" style="text-align:@hdr.Alignment;" class="wfilter">@hdr.Caption</th> }
                        if (ViewBag.wPopUp == true || ViewBag.wPopUp2 == true)
                       {<th class="lbtn"></th> }
                    }  
                </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot></tfoot>
              </table>
            </div>
          </div>
       </div>
    </div>
</section>
<script>
$(document).ready(function () {
    var selected_@ViewBag.ViewId = [];
    var table_@{@ViewBag.mName};
    var refNo_@ViewBag.ViewId = 0;
    var URLVIEW = "";
    var today = new Date();
    var date = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
    var time = today.getHours() + "-" + today.getMinutes() + "-" + today.getSeconds();
    var dateTime = date + ' ' + time;
    $('#tblList_@ViewBag.ViewId thead .filters th.wfilter').each(function () { $(this).html('<input type="text"/>'); });
    table_@{@ViewBag.mName} = $("#tblList_@ViewBag.ViewId").DataTable({
        dom: "<'row'<'col-sm-3'><'col-sm-3'l><'col-sm-2'B><'col-sm-4'p>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
        "columnDefs": [{ "targets": [0], "width": "1%" }, {
            "targets": -1, "render": function (data, type, row) {
                var htmlstr = '@ViewBag.wPopUp' == 'True' ? "<button type='button' id='btn_@ViewBag.ViewId' class='btn fa fa-@ViewBag.wPopUpIcon' title = ''></button>&nbsp;" : '';
                var htmlstr2 = '@ViewBag.wPopUp2' == 'True' ? "<button type='button' id='btn2_@ViewBag.ViewId' class='btn fa fa-@ViewBag.wPopUpIcon2' title = ''></button>" : '';
                if ('@ViewBag.wPopUp' == 'True' || '@ViewBag.wPopUp2' == 'True') { return htmlstr + htmlstr2; } else { return data;}
            }
        }],
        "autoWidth": false,
        ajax: {
        url: '@Url.Action("GetList", "ListView")',
        data: { Model: '@ViewBag.mName', Header: '@ViewBag.Header' },
        type: 'POST',
        datatype: 'application/json; charset=utf-8',
        dataSrc: function (data) { return JSON.parse(data); },
        error: function (e) { }
        }, order: [[1, 'asc']], pageResize: true, bSortCellsTop: true, buttons: [{
            extend: 'excel', title: '@ViewBag.mName' + ' ' + dateTime, exportOptions: {
                columns: 'th:not(:first-child)'
            }
        }],
        "deferRender": true,
        initComplete: function () {
            var HTMLString = '';
            $('#tblList_@ViewBag.ViewId' + '_wrapper').find('.col-sm-3:first-child').html('');
            HTMLString = '<div id="btnList_@ViewBag.ViewId">';
            if ('@ViewBag.AllowInsert' == 'True') { HTMLString = HTMLString + '<button type="button" class="btn btn-default ladda-button" data-style="zoom-in" data-size="s" id="New_@ViewBag.ViewId" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"><i class="fa fa-file" title="New" ></i> New</button>'; }
            HTMLString = HTMLString + '<button type="button" class="btn btn-default" id="Open_@ViewBag.ViewId"><i class="fa fa-folder-open" title="Open" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"></i> Open</button>';
            HTMLString = HTMLString + '<button type="button" class="btn btn-default" id="Refresh_@ViewBag.ViewId"><i class="fa fa-refresh" title="Refresh" onclick="var e=this; e.disabled=true; setTimeout(function(){e.disabled=false;},10000);return true;"></i> Refresh</button></div>';
            $('#tblList_@ViewBag.ViewId' + '_wrapper').find('.col-sm-3:first-child').prepend(HTMLString);
            $('#tblList_@ViewBag.ViewId tbody').off('click').on('click', 'tr', function () {
                refNo_@ViewBag.ViewId = 0;
                if (table_@{@ViewBag.mName}.row(this).data() != undefined) { refNo_@ViewBag.ViewId = table_@{@ViewBag.mName}.row(this).data()[0]; }
                $(this).siblings().removeClass('selected');
                $(this).addClass('selected');
                return false;
            }).off('dblclick').on('dblclick', 'tr', function () {
                if (refNo_@ViewBag.ViewId > 0) {
                    URLVIEW = '@Url.Action(@ViewBag.DetailActionName, @ViewBag.DetailControllerName)?mName=' + '@ViewBag.mName' + '&pKey=' + refNo_@ViewBag.ViewId;
                    $('#content_@ViewBag.mName').load(URLVIEW, function () { });
                }
            }).on('click', '#btn_@ViewBag.ViewId', function () {
                URLVIEW = '@Url.Action(@ViewBag.wPopUpAction, @ViewBag.wPopUpCtrl)?pKey=' + table_@{@ViewBag.mName}.row($(this).closest("tr")).data()[0] + '&cAction=@ViewBag.wPopUpSubAction';
                var detailView = new JIBModalList(URLVIEW);
                detailView.open();
            }).on('click', '#btn2_@ViewBag.ViewId', function () {
                URLVIEW = '@Url.Action(@ViewBag.wPopUpAction2, @ViewBag.wPopUpCtrl2)?pKey=' + table_@{@ViewBag.mName}.row($(this).closest("tr")).data()[0] + '&cAction=@ViewBag.wPopUpSubAction2';
                var detailView = new JIBModalList(URLVIEW);
                detailView.open();
            });
              
            @*table_@{@ViewBag.mName}.columns.adjust().draw();*@
            $('#btnList_@ViewBag.ViewId').find('button').off('click').on('click', function () {
                var ids = $(this).attr('id');

                switch (ids.toUpperCase()) {
                    case 'NEW_@ViewBag.ViewId'.toUpperCase():
                        URLVIEW = '@Url.Action(@ViewBag.DetailActionName, @ViewBag.DetailControllerName)?mName=' + '@ViewBag.mName' + '&pKey=-1';
                        $('#content_@ViewBag.mName').html('');
                        $('#content_@ViewBag.mName').load(URLVIEW, function () { });
                        break;
                    case 'OPEN_@ViewBag.ViewId'.toUpperCase():
                        if (refNo_@ViewBag.ViewId > 0) {
                            URLVIEW = '@Url.Action(@ViewBag.DetailActionName, @ViewBag.DetailControllerName)?mName=' + '@ViewBag.mName' + '&pKey=' + refNo_@ViewBag.ViewId;
                            $('#content_@ViewBag.mName').html('');
                            $('#content_@ViewBag.mName').load(URLVIEW, function () { });
                        }
                        break;
                    case 'REFRESH_@ViewBag.ViewId'.toUpperCase():
                        table_@{@ViewBag.mName}.state.clear();
                        URLVIEW = '@Url.Action("Index", "ListView")?ModelNo=@ViewBag.ViewId';
                        $('#content_@ViewBag.mName').load(URLVIEW, function () { });
                        break;
                    }
            })
            $('#tblList_@ViewBag.ViewId tbody tr:first-child').click();

        }
    });

    table_@{@ViewBag.mName}.columns('.wfilter').eq(0).each(function (colIdx) {
        $('input', $('#tblList_@ViewBag.ViewId thead .filters th')[colIdx]).on('keyup change', function () {
            table_@{@ViewBag.mName}
            .column(colIdx)
            .search(this.value)
            .draw();
        });
    });
})

</script>
<style>
   .tblList {
  width: 100% !important;
}
.filters input {
   width: 100%;
   display: block;
   padding:2px;
    height: 25px;
    font-size: 12px;
    line-height: 1.42857143;
    color: #555;
    background-color: #fff;
    background-image: none;
    border: 1px solid #ccc;
    border-radius: 4px;
    -webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
    box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
    -webkit-transition: border-color ease-in-out .15s,-webkit-box-shadow ease-in-out .15s;
    -o-transition: border-color ease-in-out .15s,box-shadow ease-in-out .15s;
    transition: border-color ease-in-out .15s,box-shadow ease-in-out .15s;
}

.tblList td,
.tblList th{
  white-space: normal;
  text-overflow: ellipsis;
  overflow: hidden;
}
</style>
